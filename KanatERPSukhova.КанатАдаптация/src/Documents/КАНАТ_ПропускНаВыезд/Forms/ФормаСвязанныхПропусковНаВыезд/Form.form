    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
    КАНАТ_ПропускНаВыезд.Дата КАК Дата,
    КАНАТ_ПропускНаВыезд.Номер КАК Номер,
    КАНАТ_ПропускНаВыезд.Грузополучатель КАК Грузополучатель,
	КАНАТ_ПропускНаВыезд.Ссылка КАК ПропускНаВыезд
ИЗ
	Документ.КАНАТ_ПропускНаВыезд КАК КАНАТ_ПропускНаВыезд
ГДЕ
	КАНАТ_ПропускНаВыезд.Проведен
	И КАНАТ_ПропускНаВыезд.ДокументОснование = &amp;ДокументОснование</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
