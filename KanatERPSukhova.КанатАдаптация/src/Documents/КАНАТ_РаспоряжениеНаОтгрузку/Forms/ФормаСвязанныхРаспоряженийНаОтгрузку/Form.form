    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
    КАНАТ_РаспоряжениеНаОтгрузку.Дата КАК Дата,
    КАНАТ_РаспоряжениеНаОтгрузку.Номер КАК Номер,
    КАНАТ_РаспоряжениеНаОтгрузку.Грузополучатель КАК Грузополучатель,
	КАНАТ_РаспоряжениеНаОтгрузку.Ссылка КАК РаспоряжениеНаОтгрузку
ИЗ
	Документ.КАНАТ_РаспоряжениеНаОтгрузку КАК КАНАТ_РаспоряжениеНаОтгрузку
ГДЕ
	КАНАТ_РаспоряжениеНаОтгрузку.Проведен
	И КАНАТ_РаспоряжениеНаОтгрузку.ДокументОснование = &amp;ДокументОснование</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
