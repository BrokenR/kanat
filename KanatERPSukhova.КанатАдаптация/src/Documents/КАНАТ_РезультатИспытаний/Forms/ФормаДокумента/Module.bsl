	//++ Гурьев 10.10.23 ЧТЗ_К3
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	//-- Гурьев 10.10.23 ЧТЗ_К3
	ПериодСырье.ДатаНачала = Объект.ДатаНачалаСырье;
	ПериодСырье.ДатаОкончания = Объект.ДатаОкончанияСырье;
	
	//++Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
	Если не ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Объект.автор = Пользователи.ТекущийПользователь();	
    конецЕсли;
    Элементы.ГруппаСертификатКачества.Видимость = ложь;
    //ЭтаФорма.Элементы.ГруппаСертификатКачества.Видимость = ложь;
    //--Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка. 
КонецПроцедуры

