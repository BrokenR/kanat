КонецПроцедуры

&НаКлиенте
Процедура ЦехПриИзменении(Элемент)   
	//БИТ_++ Шимсиев Подставляем склад который принадлежит данному подразделению клиент говорит, что такой будет только 1 (Не верю)
	ИзменитьСклад(Объект.Цех); 
	//БИТ_-- Шимсиев Подставляем склад который принадлежит данному подразделению
КонецПроцедуры

&НаСервере
Процедура ИзменитьСклад(Цех);  
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.Подразделение = &Подразделение
		|	И НЕ Склады.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Подразделение", Цех);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Объект.Склад = ВыборкаДетальныеЗаписи.Ссылка; 
	КонецЦикла;
КонецПроцедуры
#КонецОбласти


