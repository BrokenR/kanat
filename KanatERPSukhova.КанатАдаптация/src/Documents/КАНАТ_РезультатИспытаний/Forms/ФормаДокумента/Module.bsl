	ПараметрыОткрытия.Вставить("Период",             ПериодСырье);
	ПараметрыОткрытия.Вставить("Склад",              Объект.Склад);
	ПараметрыОткрытия.Вставить("РезультатИспытаний", Объект.Ссылка);
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПодбораСырьяКлиент", ЭтотОбъект);
	
	ОткрытьФорму("Документ.КАНАТ_РезультатИспытаний.Форма.ФормаПодбораСырья",
				 ПараметрыОткрытия,
				 ЭтаФорма,
				 ,
				 ,
				 ,
				 ОписаниеОповещения,
				 РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры


