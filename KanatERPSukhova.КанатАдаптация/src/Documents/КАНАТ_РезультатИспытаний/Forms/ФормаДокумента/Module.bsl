&НаСервере
Процедура ЗаполнитьСертификат()
	
	Если Объект.Продукция.Пустая() ИЛИ Объект.ЗаказКлиента.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.КАНАТ_Сертификат КАК Сертификат
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента
		|	И ЗаказКлиентаТовары.Номенклатура = &Продукция
		|	И ЗаказКлиентаТовары.КАНАТ_Сертификат <> ЗНАЧЕНИЕ(Справочник.КАНАТ_Сертификаты.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", Объект.ЗаказКлиента);
	Запрос.УстановитьПараметр("Продукция", Объект.Продукция);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Сертификат = ВыборкаДетальныеЗаписи.Сертификат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧРезультатИспытаний()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураКАНАТ_ПоказателиНТД.Показатель КАК Показатель,
		|	НоменклатураКАНАТ_ПоказателиНТД.Размерность КАК ЕдИзм,
		|	НоменклатураКАНАТ_ПоказателиНТД.Значение КАК Норма,
		|	НоменклатураКАНАТ_ПоказателиНТД.Отклонение КАК ДопустимоеОтклонение,
		|	Истина КАК ВыводитьВПФ
		|ИЗ
		|	Справочник.Номенклатура.КАНАТ_ПоказателиНТД КАК НоменклатураКАНАТ_ПоказателиНТД
		|ГДЕ
		|	НоменклатураКАНАТ_ПоказателиНТД.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Продукция);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Объект.РезультатИспытаний.Загрузить(РезультатЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультатСервер()
	Если Не Объект.НТДПродукции.Пустая() Тогда
		Объект.Результат = СтрШаблон("Соответствует %1", Объект.НТДПродукции.Наименование);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВыбораНоменклатурыСырья()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РаспределениеЗапасов.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|ГДЕ
	|	РаспределениеЗапасов.Склад = &Склад
	|	//И РаспределениеЗапасов.ВНаличии > 0
	|	//И РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
	|	И РаспределениеЗапасов.ЗаказНаОтгрузку.Дата Между &ДатаНачала И &ДатаОкончания";
	
	Запрос.УстановитьПараметр("Склад",         Объект.Склад);
	Запрос.УстановитьПараметр("ДатаНачала",    ПериодСырье.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодСырье.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДоступнаяНоменклатура = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		ДоступнаяНоменклатура.Добавить(Выборка.Номенклатура);
		
	КонецЦикла; 
	
	Параметр = Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ДоступнаяНоменклатура));
	мПараметрыВыбора = Новый Массив;
	мПараметрыВыбора.Добавить(Параметр);
	
	//На данный момент отбор выключен
	//ЭтаФорма.Элементы.Продукция.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
	//ЭтаФорма.Элементы.СырьеСсылка.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВыбораЗаказов()
	
	//Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЗаказКлиентаТовары.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
	               |		ПО ЗаказКлиентаТовары.Ссылка = ЗаказНаПроизводство2_2.ДокументОснование
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Номенклатура = &Номенклатура
	               |	И (&ЗаказНаПроизводствоПараметр = ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка)
	               |			ИЛИ ЗаказНаПроизводство2_2.Ссылка = &ЗаказНаПроизводствоПараметр)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЗаказНаПроизводство2_2Продукция.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	               |		ПО ЗаказНаПроизводство2_2Продукция.Ссылка.ДокументОснование =  ЗаказКлиента.Ссылка
	               |ГДЕ
	               |	ЗаказНаПроизводство2_2Продукция.Номенклатура = &Номенклатура
	               |	И (&ЗаказКлиентаПараметр = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	               |			ИЛИ ЗаказКлиента.Ссылка = &ЗаказКлиентаПараметр)";
	
	Запрос.УстановитьПараметр("Номенклатура",                Объект.Продукция);
	Запрос.УстановитьПараметр("ЗаказКлиентаПараметр",        Объект.ЗаказКлиента);
	Запрос.УстановитьПараметр("ЗаказНаПроизводствоПараметр", Объект.ЗаказНаПроизводство);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаЗаказКлиента = РезультатЗапроса[0].Выбрать();
	ВыборкаЗаказНаПроизводство = РезультатЗапроса[1].Выбрать();
	
	//Заказ клиента
	ДоступныеЗаказыКлиента = Новый Массив;
	
	Пока ВыборкаЗаказКлиента.Следующий() Цикл
		
		ДоступныеЗаказыКлиента.Добавить(ВыборкаЗаказКлиента.Ссылка);
		
	КонецЦикла; 
	
	Параметр = Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ДоступныеЗаказыКлиента));
	мПараметрыВыбора = Новый Массив;
	мПараметрыВыбора.Добавить(Параметр);
	
	ЭтаФорма.Элементы.ЗаказКлиента.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
	
	//Заказ на производство
	ДоступныеЗаказыНаПроизводство = Новый Массив;
	
	Пока ВыборкаЗаказНаПроизводство.Следующий() Цикл
		
		ДоступныеЗаказыНаПроизводство.Добавить(ВыборкаЗаказНаПроизводство.Ссылка);
		
	КонецЦикла; 
	
	Параметр = Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ДоступныеЗаказыНаПроизводство));
	мПараметрыВыбора = Новый Массив;
	мПараметрыВыбора.Добавить(Параметр);
	
	ЭтаФорма.Элементы.ЗаказНаПроизводство.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодбораСырьяКлиент(МассивСырье, ДопПараметры) Экспорт
	
	Если ТипЗнч(МассивСырье) = Тип("Массив") Тогда
	
		Для Каждого ЭлементСырье Из МассивСырье Цикл
			
			СтрокаСырье = Объект.Сырье.Добавить();
			СтрокаСырье.Сырье = ЭлементСырье.Сырье;
			СтрокаСырье.ХарактеристикаСырья = ЭлементСырье.Характеристика;
			//++Бит Трейгер П.М. 20.12.2024 Блок Качества. Переделка. 
			СтрокаСырье.ПартияСырья = Строка(ЭлементСырье.Серия);
			//--Бит Трейгер П.М. 20.12.2024 Блок Качества. Переделка. 
		КонецЦикла;
		
		ИзменитьТекстСырьяДляПечати();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьТекстСырьяДляПечати()
	
	Объект.СырьеДляПечатнойФормы = "";
	
	Для Каждого Строка Из Объект.Сырье Цикл
		
		Объект.СырьеДляПечатнойФормы = СтрШаблон("%1%2%3%4;",
												 Объект.СырьеДляПечатнойФормы,
												 ?(ЗначениеЗаполнено(Строка.Сырье), " ", "") + Строка.Сырье,
												 ?(ЗначениеЗаполнено(Строка.ХарактеристикаСырья), " ", "") + Строка.ХарактеристикаСырья,
												 ?(ЗначениеЗаполнено(Строка.ПримечаниеПоСырью), " ", "") + Строка.ПримечаниеПоСырью);
		
	КонецЦикла;
	
КонецПроцедуры

