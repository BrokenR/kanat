	//·++·Гурьев·18.08.23·#2.9·Добавление флажка не используется в ГОЗ
	ПолеВвода = Элементы.Добавить(
		"КАНАТ_НеИспользуетсяВГОЗ",
		Тип("ПолеФормы"), 
		Элементы.ГруппаПараметрыПоставки);	
