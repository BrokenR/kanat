	ПолеВвода.ПутьКДанным = "Объект.КАНАТ_НеИспользуетсяВГОЗ";
	ПолеВвода.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	//·--·Гурьев·18.08.23
КонецПроцедуры

