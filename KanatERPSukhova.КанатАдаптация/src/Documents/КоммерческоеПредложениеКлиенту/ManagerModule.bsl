	ОбластьИнформацияДляПокупателя  = Макет.ПолучитьОбласть("КАНАТ_ИнформацияДляПокупателя");
	ОбластьПодпись                  = Макет.ПолучитьОбласть("КАНАТ_ОбластьПодпись");
