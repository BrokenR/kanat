
&НаСервере
Процедура КАНАТ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	//++ Гурьев 05.10.23 ЧТЗ_К2_v_6.3
	//ПолеВвода = Элементы.Добавить("ТоварыКАНАТ_Сертификат",Тип("ПолеФормы"), Элементы.Товары);
	//ПолеВвода.Заголовок = "Сертификат";
	//ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	//ПолеВвода.ПутьКДанным = "Объект.Товары.КАНАТ_Сертификат";
	//-- Гурьев 05.10.23
	
	//·++·Гурьев·08.08.23·#2_11_4 Добавление реквизита КАНАТ_ПлатитЗаДоставку на форму
	ГруппаПлатитЗаДоставку = Элементы.Добавить(
		"КАНАТ_ГруппаПлатитЗаДоставку",
		Тип("ГруппаФормы"),
		Элементы.СтраницаДоставка);
		
	ГруппаПлатитЗаДоставку.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПлатитЗаДоставку.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаПлатитЗаДоставку["ОтображатьЗаголовок"] = Ложь;
	Элементы.Переместить(ГруппаПлатитЗаДоставку, Элементы.СтраницаДоставка, Элементы.СтраницыДоставки); 
	
	ПолеВвода = Элементы.Добавить(
		"КАНАТ_ПлатитЗаДоставку",
		Тип("ПолеФормы"), 
		ГруппаПлатитЗаДоставку);	
	ПолеВвода.Заголовок = "Платит за доставку";
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.КАНАТ_ПлатитЗаДоставку";
	ПолеВвода.АвтоМаксимальнаяШирина = Ложь;
	ПолеВвода.МаксимальнаяШирина = 29;
	//·--·Гурьев·08.08.23
	//·++·Гурьев 16.08.23·#2_2 Добавление реквизита с документом, удостоверяющим личность
	ДобавляемыеРеквизиты = Новый Массив;
			
	Реквизит_ДокументУдостоверяющийЛичность = Новый РеквизитФормы("КАНАТ_ДокументУдостоверяющийЛичность",
																	Новый ОписаниеТипов("Строка"),
																	,
																	"Документ, удостоверяющий личность");
	
	ДобавляемыеРеквизиты.Добавить(Реквизит_ДокументУдостоверяющийЛичность);
	
	//БИТ_Гурьев__28.03.24++
	Реквизит_СуммаБезНДС = Новый РеквизитФормы("КАНАТ_СуммаБезНДС",
																	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15, 2)),
																	,
																	"Сумма без НДС");
	ДобавляемыеРеквизиты.Добавить(Реквизит_СуммаБезНДС);
	//БИТ_Гурьев__28.03.24--
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ГруппаДокументУдостоверяющийЛичность = Элементы.Добавить(
									"КАНАТ_ГруппаДокументУдостоверяющийЛичность",
									Тип("ГруппаФормы"),
									Элементы.СтраницаДоставка);
			
	ГруппаДокументУдостоверяющийЛичность.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаДокументУдостоверяющийЛичность.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаДокументУдостоверяющийЛичность["ОтображатьЗаголовок"] = Ложь;
	ГруппаДокументУдостоверяющийЛичность.РастягиватьПоВертикали = Ложь;
	
	Элементы.Переместить(ГруппаДокументУдостоверяющийЛичность, Элементы.СтраницаДоставка, Элементы.СтраницыДоставки);
	
	ДокументУдостоверяющийЛичность = Элементы.Добавить(
				"КАНАТ_ДокументУдостоверяющийЛичность",
				Тип("ПолеФормы"), 
				ГруппаДокументУдостоверяющийЛичность);
	ДокументУдостоверяющийЛичность.Вид = ВидПоляФормы.ПолеВвода;
	ДокументУдостоверяющийЛичность.ТолькоПросмотр = Истина;
	ДокументУдостоверяющийЛичность.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	ДокументУдостоверяющийЛичность.МногострочныйРежим = Истина;
	ДокументУдостоверяющийЛичность.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Верх;
	ДокументУдостоверяющийЛичность.ПутьКДанным = "КАНАТ_ДокументУдостоверяющийЛичность";
	
	ИзменитьДокументУдостоверяющийЛичность();
	//·--·Гурьев·16.08.23
	
	//++ Гурьев 01.09.23 Гурьев Вывод реквизита "Комментарий к заказу"
	КолонкаКомментарийКЗаказу = Элементы.Добавить("КАНАТ_ТоварыКомментарийКЗаказу", Тип("ПолеФормы"), Элементы.Товары); 
	КолонкаКомментарийКЗаказу.Заголовок = "Комментарий к заказу"; 
	КолонкаКомментарийКЗаказу.ПутьКДанным = "Объект.Товары.КАНАТ_КомментарийКЗаказу";
	КолонкаКомментарийКЗаказу.Вид = ВидПоляФормы.ПолеВвода;
	//-- Гурьев 01.09.23
	
	//++ Гурьев 25.09.23 ЧТЗ_2.10
	
	ПолеНомерИДатаДоверенности = Элементы.Добавить("КАНАТ_НомерИДатаДоверенности", Тип("ПолеФормы"), Элементы.СтраницаДоставка);
	ПолеНомерИДатаДоверенности.Заголовок = "№ доверенности"; 
	ПолеНомерИДатаДоверенности.ПутьКДанным = "Объект.КАНАТ_НомерИДатаДоверенности";
	ПолеНомерИДатаДоверенности.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеФИОСопроводителя = Элементы.Добавить("КАНАТ_ФИОСопроводителя", Тип("ПолеФормы"), Элементы.СтраницаДоставка);
	ПолеФИОСопроводителя.Заголовок = "Через – Ф.И.О."; 
	ПолеФИОСопроводителя.ПутьКДанным = "Объект.КАНАТ_ФИОСопроводителя";
	ПолеФИОСопроводителя.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеВодитель = Элементы.Добавить("КАНАТ_Водитель", Тип("ПолеФормы"), Элементы.СтраницаДоставка);
	ПолеВодитель.Заголовок = "Водитель - Ф.И.О."; 
	ПолеВодитель.ПутьКДанным = "Объект.КАНАТ_Водитель";
	ПолеВодитель.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеВодительСсылка = Элементы.Добавить("КАНАТ_ВодительСсылка", Тип("ПолеФормы"), Элементы.СтраницаДоставка);
	ПолеВодительСсылка.Заголовок = "Водитель - Ф.И.О."; 
	ПолеВодительСсылка.ПутьКДанным = "Объект.КАНАТ_ВодительСсылка";
	ПолеВодительСсылка.Вид = ВидПоляФормы.ПолеВвода;
	
	ГруппаТранспорт = Элементы.Добавить("КАНАТ_ГруппаТранспорт", Тип("ГруппаФормы"), Элементы.СтраницаДоставка);
	ГруппаТранспорт.Заголовок = "Транспорт";
	ГруппаТранспорт.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТранспорт.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	ГруппаТранспорт.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ПолеТранспорт = Элементы.Добавить("КАНАТ_Транспорт", Тип("ПолеФормы"), ГруппаТранспорт);
	ПолеТранспорт.Заголовок = "Транспорт"; 
	ПолеТранспорт.ПутьКДанным = "Объект.КАНАТ_Транспорт";
	ПолеТранспорт.Вид = ВидПоляФормы.ПолеВвода;
	ПолеТранспорт.УстановитьДействие("ПриИзменении", "ТранспортПриИзменении");
	
	ГруппаТранспорт1 = Элементы.Добавить("КАНАТ_ГруппаТранспорт1", Тип("ГруппаФормы"), ГруппаТранспорт);
	ГруппаТранспорт1.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТранспорт1.ОтображатьЗаголовок = Ложь;
	ГруппаТранспорт.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаТранспорт.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	
	ПолеГосНомер = Элементы.Добавить("КАНАТ_ГосНомер", Тип("ПолеФормы"), ГруппаТранспорт1);
	ПолеГосНомер.Заголовок = "Гос. номер автомобиля"; 
	ПолеГосНомер.ПутьКДанным = "Объект.КАНАТ_ГосНомер";
	ПолеГосНомер.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеАвтомобильМарка = Элементы.Добавить("КАНАТ_АвтомобильМарка", Тип("ПолеФормы"), ГруппаТранспорт1);
	ПолеАвтомобильМарка.Заголовок = "Автомобиль марка"; 
	ПолеАвтомобильМарка.ПутьКДанным = "Объект.КАНАТ_АвтомобильМарка";
	ПолеАвтомобильМарка.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеСерияИНомерУдостоверения = Элементы.Добавить("КАНАТ_СерияИНомерУдостоверения", Тип("ПолеФормы"), ГруппаТранспорт1);
	ПолеСерияИНомерУдостоверения.Заголовок = "Серия и номер удостоверения"; 
	ПолеСерияИНомерУдостоверения.ПутьКДанным = "Объект.КАНАТ_СерияИНомерУдостоверения";
	ПолеСерияИНомерУдостоверения.Вид = ВидПоляФормы.ПолеВвода;
	
	Элементы.Переместить(ПолеНомерИДатаДоверенности,   Элементы.СтраницаДоставка, Элементы.СтраницыДоставки);
	Элементы.Переместить(ПолеФИОСопроводителя,         Элементы.СтраницаДоставка, Элементы.СтраницыДоставки);
	Элементы.Переместить(ПолеВодитель,                 Элементы.СтраницаДоставка, Элементы.СтраницыДоставки);
	Элементы.Переместить(ПолеВодительСсылка,                 Элементы.СтраницаДоставка, Элементы.СтраницыДоставки);
	Элементы.Переместить(ГруппаТранспорт,              Элементы.СтраницаДоставка, Элементы.СтраницыДоставки);
	Элементы.Переместить(ПолеСерияИНомерУдостоверения, Элементы.СтраницаДоставка, Элементы.СтраницыДоставки);
	
	ОбновитьВидимостьТранспорт();
	ИзменениеВыбораВодителя();
	
	//-- Гурьев 25.09.23 ЧТЗ_2.10
	//VVLarionov   
	ДопИнформацияУПД = Элементы.Добавить("Бит_ДопИнформация",Тип("ПолеФормы"),Элементы.ГруппаОсновное);
	ДопИнформацияУПД.Заголовок = "Дополнительная информация в УПД";
	ДопИнформацияУПД.Вид = ВидПоляФормы.ПолеВвода;
	ДопИнформацияУПД.ПутьКДанным= "Объект.Канат_ДопИнформация";
	
	//VVLarionov
	//++ Гурьев 13.11.23 ЧТЗ_2.3 Колонка с сертификатом
	ПолеСертификат = Элементы.Добавить("КАНАТ_Сертификат", Тип("ПолеФормы"), Элементы.Товары);
	ПолеСертификат.Заголовок = "Сертификат";
	ПолеСертификат.ПутьКДанным = "Объект.Товары.КАНАТ_Сертификат";
	ПолеСертификат.Вид = ВидПоляФормы.ПолеВвода;
	//-- Гурьев 13.11.23 ЧТЗ_2.3
	
	//++ Гурьев 23.11.23 ЧТЗ_2.10
	Если Объект.Ссылка.Пустая() Тогда
		
		Если Не ЗначениеЗаполнено(Объект.АдресДоставки) Тогда
			
			КАНАТ_ИзменитьАдресДоставки("Грузополучатель");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.АдресДоставки) Тогда
			
			КАНАТ_ИзменитьАдресДоставки("Контрагент");
			
		КонецЕсли;
		
	КонецЕсли;
	//-- Гурьев 23.11.23 ЧТЗ_2.10
	
	//++БИТ_Гурьев_11.01.24
	ПолеГрузополучатель = Элементы.Добавить("КАНАТ_Грузополучатель", Тип("ПолеФормы"), Элементы.СтраницаДоставка);
	ПолеГрузополучатель.Заголовок = "Грузополучатель"; 
	ПолеГрузополучатель.ПутьКДанным = "Объект.Грузополучатель";
	ПолеГрузополучатель.Вид = ВидПоляФормы.ПолеВвода;
	ПолеГрузополучатель.УстановитьДействие("ПриИзменении", "КАНАТ_ГрузополучательПриИзменении");
	
	Элементы.Переместить(ПолеГрузополучатель, Элементы.СтраницаДоставка, Элементы.СпособДоставки);
	//--БИТ_Гурьев_11.01.24
	
	//БИТ_Гурьев__28.03.24++
	ПолеСуммаБезНДС = Элементы.Добавить("КАНАТ_СуммаБезНДС", Тип("ПолеФормы"), Элементы.ГруппаИтого);
	ПолеСуммаБезНДС.Заголовок = "Сумма без НДС"; 
	ПолеСуммаБезНДС.ПутьКДанным = "КАНАТ_СуммаБезНДС";
	ПолеСуммаБезНДС.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСуммаБезНДС.ТолькоПросмотр = Истина;
	
	Элементы.Переместить(ПолеСуммаБезНДС, Элементы.ГруппаИтого, Элементы.ГруппаВсегоСкидка);
	
	КАНАТ_ПересчитатьСуммуБезНДС();
	//БИТ_Гурьев__28.03.24--
КонецПроцедуры

