&НаСервере
Процедура ОбновитьВидимостьТранспорт()
	
	 //Выбора транспорта из спарвочника, в зависимости от способа доставки
	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента
		ИЛИ Объект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу Тогда
		
		Элементы.КАНАТ_Транспорт.Видимость = Истина;
		Элементы.КАНАТ_ГруппаТранспорт1.ТолькоПросмотр = Истина;
		
		Объект.КАНАТ_ГосНомер = Объект.КАНАТ_Транспорт.Код;
		Объект.КАНАТ_АвтомобильМарка = Объект.КАНАТ_Транспорт.Марка;
		
	Иначе
		
		Элементы.КАНАТ_Транспорт.Видимость = Ложь;
		Элементы.КАНАТ_ГруппаТранспорт1.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика 
		ИЛИ Объект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу Тогда
		
		Элементы.СтраницыПеревозчик.ТекущаяСтраница = Элементы.СтраницаПеревозчик;
		
	Иначе
		
		Элементы.СтраницыПеревозчик.ТекущаяСтраница = Элементы.СтраницаПеревозчикПусто;
		
	КонецЕсли;
	
	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз Тогда
		
		Элементы.СтраницыДоставки.ТекущаяСтраница = Элементы.СтраницаСамовывоз;
		
	ИначеЕсли Объект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика Тогда
		
		Элементы.СтраницыДоставки.ТекущаяСтраница = Элементы.СтраницаДоставкаПеревозчиком;
		
	ИначеЕсли Объект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу Тогда
		
		Элементы.СтраницыДоставки.ТекущаяСтраница = Элементы.СтраницаДоставкаПеревозчикомПоАдресу;
		
	ИначеЕсли Объект.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента Тогда
		
		Элементы.СтраницыДоставки.ТекущаяСтраница = Элементы.СтраницаДоставкаДоПолучателя;
		
	ИначеЕсли Объект.СпособДоставки = Перечисления.СпособыДоставки.КПолучателюОпределяетСлужбаДоставки Тогда
		
		Элементы.СтраницыДоставки.ТекущаяСтраница = Элементы.СтраницаДоставкаДоПолучателяКурьером;
		
	КонецЕсли;
	
КонецПроцедуры

