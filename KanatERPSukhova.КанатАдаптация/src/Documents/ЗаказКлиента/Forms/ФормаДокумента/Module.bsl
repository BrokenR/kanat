//·++·Гурьев 20.10.23·#2_2 Добавление реквизита с документом, удостоверяющим личность
&НаСервере
Процедура ИзменитьДокументУдостоверяющийЛичность()
	
	Если Не Объект.Контрагент.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ДокументыФизическихЛицСрезПоследних.Физлицо КАК Физлицо,
		|	МАКСИМУМ(ДокументыФизическихЛицСрезПоследних.Период) КАК Период,
		|	Контрагенты.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ Вт
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
		|				,
		|				Физлицо = &Ссылка
		|					И ЯвляетсяДокументомУдостоверяющимЛичность) КАК ДокументыФизическихЛицСрезПоследних
		|		ПО Контрагенты.Ссылка = ДокументыФизическихЛицСрезПоследних.Физлицо
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка
        |
		|СГРУППИРОВАТЬ ПО
		|	ДокументыФизическихЛицСрезПоследних.Физлицо,
		|	Контрагенты.ЮрФизЛицо
		|;
        |
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыФизическихЛицСрезПоследних.Представление КАК Представление,
		|	Вт.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	Вт КАК Вт
		|		ПРАВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
		|				,
		|				Физлицо = &Ссылка
		|					И ЯвляетсяДокументомУдостоверяющимЛичность) КАК ДокументыФизическихЛицСрезПоследних
		|		ПО (Вт.Физлицо = ДокументыФизическихЛицСрезПоследних.Физлицо
		|				И Вт.Период = ДокументыФизическихЛицСрезПоследних.Период)";
		Если Не ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
		Запрос.Параметры.Вставить("Ссылка", Объект.Контрагент);
	Иначе
		Запрос.Параметры.ВСтавить("Ссылка",Объект.Грузополучатель);
		КонецЕсли;
		//Сообщить(Объект.Грузополучатель);
