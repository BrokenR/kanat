&НаСервере
Процедура КАНАТ_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	//++Бит_Зачетнова_21.05.2025_Обращение 1660201581 от 15.05.2025 14:38:44
	ДопДанныеЗаказ = ТекущийОбъект.Канат_ДопИнформация; 
	
	ТаблицаСвязанныхРеализаций = ЗаказСвязаннаяРеализация(ТекущийОбъект.Ссылка);
	
	Если ТаблицаСвязанныхРеализаций <> Неопределено тогда 
		Для каждого СтрокаТЧ из ТаблицаСвязанныхРеализаций цикл
			Попытка
			РеализацияСсылка = СтрокаТЧ.Ссылка; 
			РеализацияОбъект = РеализацияСсылка.ПолучитьОбъект(); 
			РеализацияОбъект.Заблокировать();
			РеализацияОбъект.Канат_ДопИнформация = ДопДанныеЗаказ; 
			РеализацияОбъект.Записать(РежимЗаписиДокумента.Проведение); 
			Исключение   
				Сообщение = Новый СообщениеПользователю; 
				Сообщение.Текст = "Не удалось изменить документ" + РеализацияСсылка; 
				Сообщение.Сообщить(); 
			КонецПопытки;
		КонецЦикла;  
	КонецЕсли;
	//--Бит_Зачетнова_21.05.2025_Обращение 1660201581 от 15.05.2025 14:38:44
КонецПроцедуры

Функция ЗаказСвязаннаяРеализация(ДокументЗаказ)
    //++Бит_Зачетнова_21.05.2025_Обращение 1660201581 от 15.05.2025 14:38:44
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ДокументЗаказ);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() <> 0 тогда 
		Возврат РезультатЗапроса;
	Иначе Возврат Неопределено; 
		КонецЕсли;
	//--Бит_Зачетнова_21.05.2025_Обращение 1660201581 от 15.05.2025 14:38:44	
	КонецФункции
