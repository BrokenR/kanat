&НаСервере
Процедура ИзменениеВыбораВодителя()
	
	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента
		ИЛИ Объект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу Тогда 
		
		Элементы.КАНАТ_Водитель.Видимость = Ложь;
		Элементы.КАНАТ_ВодительСсылка.Видимость = Истина;
	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ФизическиеЛица.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ФизическиеЛица КАК ФизическиеЛица
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица1
		               |		ПО ФизическиеЛица.Родитель = ФизическиеЛица1.Ссылка
		               |ГДЕ
		               |	ФизическиеЛица1.Наименование = ""Водители""";
					   
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДоступныеФизЛица = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			
			ДоступныеФизЛица.Добавить(Выборка.Ссылка);
			
		КонецЦикла; 
		
		Параметр = Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ДоступныеФизЛица));
		мПараметрыВыбора = Новый Массив;
		мПараметрыВыбора.Добавить(Параметр);
		
		//ЭтаФорма.Элементы.Продукция.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
		ЭтаФорма.Элементы.КАНАТ_ВодительСсылка.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
			
	Иначе 
		
		Элементы.КАНАТ_Водитель.Видимость = Истина;
		Элементы.КАНАТ_ВодительСсылка.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

