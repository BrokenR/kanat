
&После("ДобавитьКомандыПечати")
Процедура КАНАТ_ДобавитьКомандыПечати(КомандыПечати)
	
	//Удаление печати счета на оплату из заказа клиента
	Индекс = 0;
	
	Пока Индекс < КомандыПечати.Количество() Цикл
		
		Если КомандыПечати[Индекс].МенеджерПечати = "Обработка.ПечатьСчетовНаОплату" Тогда
			КомандыПечати.Удалить(Индекс);
		Иначе		
			Индекс = Индекс + 1;
		КонецЕсли;
		
	КонецЦикла;		
	
