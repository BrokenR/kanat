//++ Гурьев 19.09.23 ЧТЗ_2.3
Функция КАНАТ_ПолучитьНовыйНомерСпецификации(ЗаказКлиента, Договор) Экспорт
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказКлиента.КАНАТ_СпецификацияНомер КАК КАНАТ_СпецификацияНомер
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка <> &ЗаказКлиента
		|	И ЗаказКлиента.Договор = &Договор
		|	И ЗаказКлиента.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	КАНАТ_СпецификацияНомер УБЫВ";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.КАНАТ_СпецификацияНомер + 1;
		
	Иначе
		
		Возврат 1;
		
	КонецЕсли;

	
КонецФункции
