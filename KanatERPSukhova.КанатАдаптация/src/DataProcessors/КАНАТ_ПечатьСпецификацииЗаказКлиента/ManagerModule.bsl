Функция ПолучитьДанныеПечати_устар(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиента.КАНАТ_СпецификацияНомер КАК КАНАТ_СпецификацияНомер,
	|	ДоговорыКонтрагентов.Номер КАК НомерДоговора,
	|	ДоговорыКонтрагентов.Дата КАК ДатаДоговора,
	|	ЗаказКлиента.Организация.Наименование КАК ОрганизацияНаименование,
	|	ЗаказКлиента.Контрагент.Наименование КАК КонтрагентНаименование,
	|	ЗаказКлиента.КАНАТ_ДатаСпецификации КАК КАНАТ_ДатаСпецификации,
	|	ЗаказКлиентаТовары.КАНАТ_КомментарийКЗаказу КАК КАНАТ_КомментарийКЗаказу,
	|	ЗаказКлиентаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ЗаказКлиентаТовары.Количество КАК Количество,
	|	ЗаказКлиентаТовары.СтавкаНДС КАК СтавкаНДС,
	|	ЗаказКлиентаТовары.СуммаСНДС КАК СуммаСНДС,
	|	ЗаказКлиентаТовары.Цена КАК Цена,
	|	ЗаказКлиентаТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаказКлиента.СпособДоставки КАК СпособДоставки,
	|	ЗаказКлиента.Грузополучатель КАК Грузополучатель,
	|	ЗаказКлиента.Руководитель.ФизическоеЛицо.ФИО КАК Руководитель,
	|	ДоговорыКонтрагентов.КонтактноеЛицо.Наименование КАК КонтактноеЛицо,
	|	ЕСТЬNULL(СоглашенияСКлиентами.КАНАТ_ВыводитьСкидки, ЛОЖЬ) КАК ВыводитьСкидки
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ЗаказКлиента.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ПО ЗаказКлиента.Ссылка = ЗаказКлиентаТовары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|		ПО ЗаказКлиента.Соглашение = СоглашенияСКлиентами.Ссылка
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьДанныеОплаты(Документ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаЭтапыГрафикаОплаты.ПроцентПлатежа КАК ПроцентПлатежа,
		|	ЗаказКлиентаЭтапыГрафикаОплаты.ВариантОтсчета КАК ВариантОтсчета
		|ИЗ
		|	Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК ЗаказКлиентаЭтапыГрафикаОплаты
		|ГДЕ
		|	ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат "По договору"
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроцентПредоплаты = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ВариантОтсчета <> Перечисления.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки Тогда
			
			ПроцентПредоплаты = ПроцентПредоплаты + Выборка.ПроцентПлатежа;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПроцентПредоплаты > 0 Тогда 
		
		Возврат "Предоплата " + Строка(ПроцентПредоплаты) + "%";
		
	Иначе
		
		Возврат "Постоплата";
		
	КонецЕсли;
	
КонецФункции

Функция ДействиеСкидокНаценокПоИсточнику(Источник, Дата)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДействиеСкидокНаценокСрезПоследних.СкидкаНаценка                                                              КАК СкидкаНаценка,
	|	ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыДействияСкидок.НеДействует)) КАК Статус,
	|	
	|	ВЫБОР
	|		КОГДА ДействиеСкидокНаценокСрезПоследних.Статус ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Использование,
	|	
	|	ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачала,
	|	
	|	ВЫБОР КОГДА ДействиеСкидокНаценокСрезПоследних.Период ЕСТЬ NULL ТОГДА
	|		ЕСТЬNULL(ДобавитьКДате(ДействиеСкидокНаценокСрезПервых.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1)) 
	|	ИНАЧЕ
	|		ЕСТЬNULL(ДобавитьКДате(Таблица.Период, ДЕНЬ, -1), ДАТАВРЕМЯ(1, 1, 1))
	|	КОНЕЦ КАК ДатаОкончания,
	|	ТаблицаСкидкиНаценки.Наименование КАК Наименование
	|	
	|ИЗ
	|	Справочник.СкидкиНаценки КАК ТаблицаСкидкиНаценки
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ
	|			РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(&ДатаСреза, Источник = &Источник) КАК ДействиеСкидокНаценокСрезПоследних
	|			ПО ДействиеСкидокНаценокСрезПоследних.СкидкаНаценка = ТаблицаСкидкиНаценки.Ссылка
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МИНИМУМ(Т.Период) КАК Период,
	|			Т.СкидкаНаценка КАК СкидкаНаценка
	|		ИЗ
	|			РегистрСведений.ДействиеСкидокНаценок.СрезПоследних(&ДатаСреза, Источник = &Источник) КАК Срез
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействиеСкидокНаценок КАК Т
	|				ПО (Т.СкидкаНаценка = Срез.СкидкаНаценка)
	|					И Т.Источник = Срез.Источник
	|					И Т.Период > Срез.Период
	|					И Т.Статус <> Срез.Статус
	|		СГРУППИРОВАТЬ ПО
	|			Т.СкидкаНаценка) КАК Таблица
	|		ПО (Таблица.СкидкаНаценка = ТаблицаСкидкиНаценки.Ссылка)
	|		
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействиеСкидокНаценок.СрезПервых(
	|				&ДатаСреза,
	|				Источник = &Источник) КАК ДействиеСкидокНаценокСрезПервых
	|		ПО ДействиеСкидокНаценокСрезПервых.СкидкаНаценка = ТаблицаСкидкиНаценки.Ссылка
	|ГДЕ
	|	    (НЕ ДействиеСкидокНаценокСрезПоследних.Период ЕСТЬ NULL
	|	ИЛИ НЕ ДействиеСкидокНаценокСрезПервых.Период ЕСТЬ NULL)
	|	И ЕСТЬNULL(ДействиеСкидокНаценокСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыДействияСкидок.НеДействует)) = ЗНАЧЕНИЕ(Перечисление.СтатусыДействияСкидок.Действует)
	|");
	
	Запрос.УстановитьПараметр("ДатаСреза", Дата);
	Запрос.УстановитьПараметр("Источник", Источник);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьДанныеПечати(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Номер КАК НомерДоговора,
	|	ДоговорыКонтрагентов.Дата КАК ДатаДоговора,
	|	ЗаказКлиента.Организация.Наименование КАК ОрганизацияНаименование,
	|	ЗаказКлиента.Руководитель.ФизическоеЛицо.ФИО КАК Руководитель,
	|	ДоговорыКонтрагентов.КонтактноеЛицо.Наименование КАК КонтактноеЛицо,
	|	ЕСТЬNULL(СоглашенияСКлиентами.КАНАТ_ВыводитьСкидки, ЛОЖЬ) КАК ВыводитьСкидки,
	|	МАКСИМУМ(КАНАТ_СпецификацияКДоговору.ПорядковыйНомер) КАК КАНАТ_СпецификацияНомер,
	|	КАНАТ_СпецификацияКДоговору.Контрагент.Наименование КАК КонтрагентНаименование,
	|	КАНАТ_СпецификацияКДоговору.Контрагент.НаименованиеПолное КАК КонтрагентСокрНаименование,
	|	КАНАТ_СпецификацияКДоговору.Дата КАК КАНАТ_ДатаСпецификации,
	|	КАНАТ_СпецификацияКДоговоруТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	СУММА(КАНАТ_СпецификацияКДоговоруТовары.Количество) КАК Количество,
	|	КАНАТ_СпецификацияКДоговоруТовары.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(КАНАТ_СпецификацияКДоговоруТовары.СуммаСНДС) КАК СуммаСНДС,
	|	КАНАТ_СпецификацияКДоговоруТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	КАНАТ_СпецификацияКДоговоруТовары.КАНАТ_КомментарийКЗаказу КАК КАНАТ_КомментарийКЗаказу,
	|	КАНАТ_СпецификацияКДоговоруТовары.СуммаБезНДС / КАНАТ_СпецификацияКДоговоруТовары.Количество КАК Цена,
	|	КАНАТ_СпецификацияКДоговору.КАНАТ_ПримечаниеКСпецификацииДоговора КАК КАНАТ_ПримечаниеКСпецификацииДоговора,
	|	КАНАТ_СпецификацияКДоговору.КАНАТ_ДоставкаСпецификацияКДоговору КАК КАНАТ_ДоставкаСпецификацияКДоговору,
	|	КАНАТ_СпецификацияКДоговору.Контрагент КАК Контрагент
	|ИЗ
	|	Документ.КАНАТ_СпецификацияКДоговору КАК КАНАТ_СпецификацияКДоговору
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ПО КАНАТ_СпецификацияКДоговору.ДокументОснование = ЗаказКлиента.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КАНАТ_СпецификацияКДоговору.Товары КАК КАНАТ_СпецификацияКДоговоруТовары
	|		ПО (КАНАТ_СпецификацияКДоговоруТовары.Ссылка = КАНАТ_СпецификацияКДоговору.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО КАНАТ_СпецификацияКДоговору.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|		ПО КАНАТ_СпецификацияКДоговору.Соглашение = СоглашенияСКлиентами.Ссылка
	|ГДЕ
	|	КАНАТ_СпецификацияКДоговору.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ДоговорыКонтрагентов.Номер,
	|	ДоговорыКонтрагентов.Дата,
	|	ЗаказКлиента.Организация.Наименование,
	|	ЗаказКлиента.Руководитель.ФизическоеЛицо.ФИО,
	|	ДоговорыКонтрагентов.КонтактноеЛицо.Наименование,
	|	ЕСТЬNULL(СоглашенияСКлиентами.КАНАТ_ВыводитьСкидки, ЛОЖЬ),
	|	КАНАТ_СпецификацияКДоговору.Контрагент.Наименование,
	|	КАНАТ_СпецификацияКДоговору.Контрагент.НаименованиеПолное,
	|	КАНАТ_СпецификацияКДоговору.Дата,
	|	КАНАТ_СпецификацияКДоговоруТовары.Номенклатура.Наименование,
	|	КАНАТ_СпецификацияКДоговоруТовары.СтавкаНДС,
	|	КАНАТ_СпецификацияКДоговоруТовары.Номенклатура.ЕдиницаИзмерения,
	|	КАНАТ_СпецификацияКДоговоруТовары.КАНАТ_КомментарийКЗаказу,
	|	КАНАТ_СпецификацияКДоговору.Контрагент,
	|	КАНАТ_СпецификацияКДоговору.КАНАТ_ПримечаниеКСпецификацииДоговора,
	|	КАНАТ_СпецификацияКДоговору.КАНАТ_ДоставкаСпецификацияКДоговору,
	|	КАНАТ_СпецификацияКДоговоруТовары.СуммаБезНДС / КАНАТ_СпецификацияКДоговоруТовары.Количество";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьПокупателя(Контрагент)
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Должность", "");
	
	Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Контрагент.Партнер) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтактныеЛицаПартнеров.Наименование КАК Наименование,
			|	КонтактныеЛицаПартнеров.ДолжностьПоВизитке КАК ДолжностьПоВизитке
			|ИЗ
			|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
			|ГДЕ
			|	КонтактныеЛицаПартнеров.Владелец = &Владелец
			|	И КонтактныеЛицаПартнеров.КАНАТ_Подписант = ИСТИНА";
		
		Запрос.УстановитьПараметр("Владелец", Контрагент.Партнер);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Результат.Наименование = ВыборкаДетальныеЗаписи.Наименование;
			Результат.Должность = ВыборкаДетальныеЗаписи.ДолжностьПоВизитке;
		КонецЦикла;
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции