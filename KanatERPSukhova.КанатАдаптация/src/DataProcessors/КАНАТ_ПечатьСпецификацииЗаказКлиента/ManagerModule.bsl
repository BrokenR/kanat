// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Для Каждого Документ Из МассивОбъектов Цикл
		
		//Если ТипЗнч(Документ) = Тип("ДокументСсылка.КАНАТ_СпецификацияКДоговору") Тогда
		//	Док = Документ.ДокументОснование;
		//Иначе
		//	Док = Документ;
		//КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьСпецификации") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"ПечатьСпецификации",
				"Печать спецификации",
				СформироватьПечатьСпецификации(Документ));
		КонецЕсли;
	
	КонецЦикла;
	ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	
КонецПроцедуры

//++ Гурьев 04.09.23 формирование печатной формы для печати спецификации
Функция СформироватьПечатьСпецификации(Документ)
	
	ДанныеПечати = ПолучитьДанныеПечати(Документ);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТ_ПечатьСпецификацииЗаказКлиента.ПФ_MXL_ПечатьСпецификакии");
	ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ОбластьПустаяСтрока");
	//Шапка
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	ДанныеШапки = Новый Структура;
	ДанныеШапки.Вставить("НомерСпецификации",       ДанныеПечати[0].КАНАТ_СпецификацияНомер);
	ДанныеШапки.Вставить("НомерДоговора",           ДанныеПечати[0].НомерДоговора);
	ДанныеШапки.Вставить("ДатаДоговора",            Формат(ДанныеПечати[0].ДатаДоговора,"ДФ=dd.MM.yyyy"));
	ДанныеШапки.Вставить("ОрганизацияНаименование", ДанныеПечати[0].ОрганизацияНаименование);
	ДанныеШапки.Вставить("КонтрагентНаименование",  ДанныеПечати[0].КонтрагентСокрНаименование);
	ОбластьШапка.Параметры.Заполнить(ДанныеШапки);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
	ОбластьШапкаДатаАдрес = Макет.ПолучитьОбласть("ОбластьШапкаДатаАдрес");
	ДанныеШапкаДатаАдрес = Новый Структура;
	ДанныеШапкаДатаАдрес.Вставить("Дата",  Формат(ДанныеПечати[0].КАНАТ_ДатаСпецификации,"ДФ=dd.MM.yyyy; ДП='-'"));
	ДанныеШапкаДатаАдрес.Вставить("Адрес", "г. Коломна Московская обл.");
	ОбластьШапкаДатаАдрес.Параметры.Заполнить(ДанныеШапкаДатаАдрес);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаДатаАдрес);
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
	ОбластьШапкаУсловия = Макет.ПолучитьОбласть("ОбластьШапкаУсловия");
	
	ТабличныйДокумент.Вывести(ОбластьШапкаУсловия);
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
	//Таблица
	ОбластьТаблицаШапка = Макет.ПолучитьОбласть("ОбластьТаблицаШапка");
	ТабличныйДокумент.Вывести(ОбластьТаблицаШапка);
	
	СуммаИтого = 0;
	
	Для Каждого Строка Из ДанныеПечати Цикл 
		
		ОбластьТаблицаСтрока = Макет.ПолучитьОбласть("ОбластьТаблицаСтрока");
		ОбластьТаблицаСтрока.Параметры.Заполнить(Строка);
		ТабличныйДокумент.Вывести(ОбластьТаблицаСтрока);
		
		СуммаИтого = СуммаИтого + Строка.СуммаСНДС;
		
	КонецЦикла;
	
	ОбластьТаблицаИтого = Макет.ПолучитьОбласть("ОбластьТаблицаИтого");
	ДанныеТаблицаИтого = Новый Структура;
	ДанныеТаблицаИтого.Вставить("ИтогоСумма", СуммаИтого);
	ОбластьТаблицаИтого.Параметры.Заполнить(ДанныеТаблицаИтого);
	ТабличныйДокумент.Вывести(ОбластьТаблицаИтого);
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
	//Комментарии
	ОбластьКомментарии = Макет.ПолучитьОбласть("ОбластьКомментарии");
	ДанныеОбластьКомментарии = Новый Структура;
	ДанныеОбластьКомментарии.Вставить("Примечание",      ДанныеПечати[0].КАНАТ_ПримечаниеКСпецификацииДоговора);
	ДанныеОбластьКомментарии.Вставить("ДанныеДоставка",  ДанныеПечати[0].КАНАТ_ДоставкаСпецификацияКДоговору);
	ДанныеОбластьКомментарии.Вставить("Дата",            Формат(ДанныеПечати[0].КАНАТ_ДатаСпецификации,"ДФ=dd.MM.yyyy; ДП='-'"));
	ДанныеОбластьКомментарии.Вставить("УсловияОплаты",   ПолучитьДанныеОплаты(Документ.ДокументОснование));
	//ДанныеОбластьКомментарии.Вставить("СпособОтгрузки",  ДанныеПечати[0].СпособДоставки);
	//ДанныеОбластьКомментарии.Вставить("Грузополучатель", ДанныеПечати[0].Грузополучатель);
	ДанныеОбластьКомментарии.Вставить("НомерДоговора",   ДанныеПечати[0].НомерДоговора);
	ДанныеОбластьКомментарии.Вставить("ДатаДоговора",    Формат(ДанныеПечати[0].ДатаДоговора,"ДФ=dd.MM.yyyy; ДП='-'"));
	ОбластьКомментарии.Параметры.Заполнить(ДанныеОбластьКомментарии);
	ТабличныйДокумент.Вывести(ОбластьКомментарии);
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
	//Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	ДанныеПодвал = Новый Структура;
	//ДанныеПодвал.Вставить("Поставщик",  ?(ЗначениеЗаполнено(ДанныеПечати[0].Руководитель),
	//									  ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ДанныеПечати[0].Руководитель),
	//									  ""));
	Поставщик = РегистрыСведений.КАНАТ_ЛицаПодписывающиеЗаПодразделения.ПолучитьСотрудникаПоДолжности(Перечисления.КАНАТ_РолиПодписантов.ГенДиректор, ДанныеПечати[0].КАНАТ_ДатаСпецификации);
	ДанныеПодвал.Вставить("Поставщик",  ?(ЗначениеЗаполнено(Поставщик),
										  ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Поставщик.Наименование),
										  ""));
	ДанныеПодвал.Вставить("ПоставщикДолжность", "Ген. директор");
	
	ПокупательСтруктура = ПолучитьПокупателя(ДанныеПечати[0].Контрагент);
	//ДанныеПодвал.Вставить("Покупатель", ?(ЗначениеЗаполнено(ДанныеПечати[0].КонтактноеЛицо),
	//									  ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ДанныеПечати[0].КонтактноеЛицо),
	//									  ""));
	ДанныеПодвал.Вставить("ПокупательДолжность", ПокупательСтруктура.Должность);
	ДанныеПодвал.Вставить("Покупатель", ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПокупательСтруктура.Наименование));
	
	ОбластьПодвал.Параметры.Заполнить(ДанныеПодвал);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
	//Скидки
	Если ДанныеПечати[0].ВыводитьСкидки Тогда
		Скидки = ДействиеСкидокНаценокПоИсточнику(Константы.КАНАТ_СоглашениеДляТиповогоТекстаСкидок.Получить(), ТекущаяДата());
		Если Скидки.Количество() > 0 Тогда
			
			ОбластьСкидка = Макет.ПолучитьОбласть("ОбластьСкидка");
			ТекстСкидки = "";
			Для Каждого Скидка Из Скидки Цикл
				
				ТекстСкидки = ТекстСкидки + Скидка.Наименование + Символы.ПС;
				
			КонецЦикла;
			
			ОбластьСкидка.Параметры.ТекстСкидки = ТекстСкидки;
			ТабличныйДокумент.Вывести(ОбластьСкидка);
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции
