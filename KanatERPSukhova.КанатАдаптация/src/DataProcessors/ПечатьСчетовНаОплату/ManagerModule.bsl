&НаСервере
Функция ПолучитьСрокОплаты(ДатаСчета)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь,
	|	ДанныеПроизводственногоКалендаря.Дата КАК Дата,
	|	ДанныеПроизводственногоКалендаря.Год КАК Год,
	|	ДанныеПроизводственногоКалендаря.ВидДня КАК ВидДня,
	|	ДанныеПроизводственногоКалендаря.ДатаПереноса КАК ДатаПереноса
	|ИЗ
	|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
	|ГДЕ
	|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &ПериодС И &ПериодПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Запрос.УстановитьПараметр("ПериодПо"	,НачалоДня(ДатаСчета) + 86400*60);
	Запрос.УстановитьПараметр("ПериодС"		,НачалоДня(ДатаСчета) + 86400);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	ДобавленоДней = 0;
	текДата = ДатаСчета;
	Пока Выборка.Следующий() И ДобавленоДней <> 5 Цикл
		Если Выборка.ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий Тогда
			Продолжить;
		КонецЕсли;
		текДата = Выборка.Дата;
		ДобавленоДней = ДобавленоДней + 1;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат текДата;
	
КонецФункции // <-БИТ> Руденков_Е.И. 30.03.2024

&ИзменениеИКонтроль("СформироватьПечатнуюФормуСчетНаОплату")
Функция КАНАТ_СформироватьПечатнуюФормуСчетНаОплату1(СтруктураТипов, ОбъектыПечати, ПараметрыПечати)

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СЧЕТНАОПЛАТУ";

	НомерТипаДокумента = 0;

	УстановитьПривилегированныйРежим(Истина);

	Для Каждого СтруктураОбъектов Из СтруктураТипов Цикл

		НомерТипаДокумента = НомерТипаДокумента + 1;
		Если НомерТипаДокумента > 1 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(СтруктураОбъектов.Ключ);
		ДанныеДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(ПараметрыПечати, СтруктураОбъектов.Значение);
        #Удаление
		ЗаполнитьТабличныйДокументСчетаНаОплату(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати);
        #КонецУдаления
		#Вставка
		//·++·Гурьев·07.08.23·#2_11_4·Выбор иной процедуры, если ПФ заполняется из документа СчетНаОплатуКлиенту
		
		Если СтруктураОбъектов.Ключ = "Документ.СчетНаОплатуКлиенту" Тогда
			ПроверкаОснованиеЗаказКлиенту = ПроверитьОснованиеЗаказКлиенту(СтруктураОбъектов.Значение);
			Если ПроверкаОснованиеЗаказКлиенту Тогда
				ЗаполнитьТабличныйДокументСчетаНаОплату_СчетНаОплатуКлиенту(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати);
			Иначе 
				ЗаполнитьТабличныйДокументСчетаНаОплату(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати);
			КонецЕсли;
		Иначе
			ЗаполнитьТабличныйДокументСчетаНаОплату(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати);
		КонецЕсли;
		//·--·Гурьев·07.08.23

		#КонецВставки
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат ТабличныйДокумент;

КонецФункции
