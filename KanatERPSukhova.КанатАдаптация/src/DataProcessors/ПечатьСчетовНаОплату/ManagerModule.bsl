	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСчетовНаОплату.КАНАТ_ПФ_СчетНаОплату");
	//·--·Гурьев·04.08.23
	
	// <+БИТ> Руденков_Е.И. 30.03.2024 
