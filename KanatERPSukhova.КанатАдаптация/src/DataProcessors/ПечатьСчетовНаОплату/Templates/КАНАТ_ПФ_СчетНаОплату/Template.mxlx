	<rowsItem>
		<index>184</index>
		<row>
			<formatIndex>232</formatIndex>
			<c>
				<i>1</i>
				<c>
					<f>233</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>-- Продукция, приобретенная Покупателем, не используется в рамках государственного оборонного заказа (№275 - ФЗ от 29.12.2012)</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
