					<f>234</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>-- Цены, указанные в счете, действительны в течение 5 банковских дней.</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<rowsItem>
