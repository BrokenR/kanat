&НаСервере
Функция ПолучитьДанныеОрганизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
|	Организации.Ссылка КАК Ссылка,
|	Организации.НаименованиеПолное КАК Наименование
|	ИЗ
|		Справочник.Организации КАК Организации
|	ГДЕ
|		Организации.Предопределенный = ЛОЖЬ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Структура = Новый Структура;
		Структура.Вставить("Наименование", Выборка.Наименование);
		Структура.Вставить("Контакты", УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Ссылка,,ТекущаяДата(),Ложь));
		
		Возврат Структура;
		
	Иначе 
		
		Возврат Неопределено;
		
	КонецЕсли;
КонецФункции
