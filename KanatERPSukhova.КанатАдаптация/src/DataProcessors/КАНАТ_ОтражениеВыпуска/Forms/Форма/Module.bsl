			ТекстыУсловияСоединенияТаблиц = Новый Массив;
			ТекстыУсловияСоединенияТаблиц.Добавить("ИСТИНА");
			
			ТекстВыбораТоваров= СтрЗаменить(ТекстВыбораТоваров, "ТаблицаТоваров.Упаковка,", "");
			ТекстВыбораУпаковок = СтрЗаменить(ТекстВыбораТоваров, "ТаблицаТоваров", "Упаковки");
			
			Для Каждого ПолеСвязи Из ПараметрыУказанияСерий.ПоляСвязи Цикл
				
				Если СтрНайти(ТекстВыбораТоваров, ПолеСвязи) = 0
					Или ПолеСвязи = "Упаковка" Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				ТекстыУсловияСоединенияТаблиц.Добавить(" Упаковки." + ПолеСвязи + " = ТаблицаТоваров." + ПолеСвязи);
				
			КонецЦикла;
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаТоваров.ТекстВыбораТоваров,", ТекстВыбораТоваров);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Упаковки.ТекстВыбораТоваров,", ТекстВыбораУпаковок);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСоединения", 
				СтрСоединить(ТекстыУсловияСоединенияТаблиц, Символы.ПС +"И " ));
				
			МенеджерВТ = Новый МенеджерВременныхТаблиц;
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
			Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаСерий);
			ТаблицаСерий = Запрос.Выполнить().Выгрузить();
			
		Иначе
			
			СтрокиСерийКУдалению = ТаблицаСерий.НайтиСтроки(Новый Структура("Серия",Справочники.СерииНоменклатуры.ПустаяСсылка()));
			
			Для Каждого СтрМас Из СтрокиСерийКУдалению Цикл
				ТаблицаСерий.Удалить(СтрМас);
			КонецЦикла;
			
		КонецЕсли;
		
		СтруктураДляВременногоХранилища.Вставить("ТаблицаСерий",ТаблицаСерий);
		
		АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(СтруктураДляВременногоХранилища,УникальныйИдентификаторФормы);
	КонецЕсли;
	
	ПараметрыФормыУказанияСерий = Новый Структура("Номенклатура,Характеристика,СтатусУказанияСерий,ХарактеристикиИспользуются"+ТекстПоляСвязи);
	ПараметрыФормыУказанияСерий.Вставить("НомераСтрокДокумента", НомераСтрокДокумента); 
	
	Если ПараметрыУказанияСерий.ТоварВШапке Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормыУказанияСерий,Объект);
	Иначе
		ЗаполнитьЗначенияСвойств(ПараметрыФормыУказанияСерий,ТекущиеДанные);
	КонецЕсли;
	
	Если ПараметрыУказанияСерий.ИмяПоляСклад = Неопределено Тогда
		ПараметрыФормыУказанияСерий.Вставить("Склад", Неопределено);
	ИначеЕсли ПараметрыУказанияСерий.ПоляСвязи.Найти(ПараметрыУказанияСерий.ИмяПоляСклад) <> Неопределено Тогда
		ПараметрыФормыУказанияСерий.Вставить("Склад", ТекущиеДанные[ПараметрыУказанияСерий.ИмяПоляСклад]);
	Иначе
		ПараметрыФормыУказанияСерий.Вставить("Склад", Объект[ПараметрыУказанияСерий.ИмяПоляСклад]);
	КонецЕсли;
	
	Если ПараметрыУказанияСерий.ПоляСвязи.Найти("Помещение") <> Неопределено Тогда
		ПараметрыФормыУказанияСерий.Вставить("Помещение", ТекущиеДанные.Помещение);
	ИначеЕсли ПараметрыУказанияСерий.ИмяПоляПомещение = Неопределено Тогда
		ПараметрыФормыУказанияСерий.Вставить("Помещение", Справочники.СкладскиеПомещения.ПустаяСсылка());
	Иначе
		ПараметрыФормыУказанияСерий.Вставить("Помещение", Объект[ПараметрыУказанияСерий.ИмяПоляПомещение]);
	КонецЕсли;
	
	ПараметрыФормыУказанияСерий.Вставить("УпаковкаДляПодстановки",УпаковкаДляПодстановки);
	ПараметрыФормыУказанияСерий.Вставить("ИдетОбработкаТоварныхМест", ИдетОбработкаТоварныхМест);
	
	ПараметрыФормыУказанияСерий.Вставить("АдресВоВременномХранилище",АдресВоВременномХранилище);
	ПараметрыФормыУказанияСерий.Вставить("РегистрироватьСерии", РегистрироватьСерии);
	ПараметрыФормыУказанияСерий.Вставить("ТолькоПросмотр", ПараметрыУказанияСерий.ТолькоПросмотр);
	ПараметрыФормыУказанияСерий.Вставить("ТолькоРедактированиеКоличества", Ложь);
	ПараметрыФормыУказанияСерий.Вставить("Количество",КоличествоВДокументе);
	ПараметрыФормыУказанияСерий.Вставить("АдресВоВременномХранилище",АдресВоВременномХранилище);
	ПараметрыФормыУказанияСерий.Вставить("СерииВТЧТовары", ПараметрыУказанияСерий.ИмяТЧСерии = ПараметрыУказанияСерий.ИмяТЧТовары);
	Если Объект.Свойство("Ссылка") Тогда
		ПараметрыФормыУказанияСерий.Вставить("Регистратор",Объект.Ссылка);
	КонецЕсли;
	ПараметрыФормыУказанияСерий.Вставить("ПараметрыУказанияСерий",ПараметрыУказанияСерий);
	
	ЗначенияПолейДляОпределенияРаспоряжения = НоменклатураКлиентСервер.ЗначенияПолейДляОпределенияРаспоряжения(Объект,
																							  ТекущиеДанные,
																							  ПараметрыУказанияСерий);

	ПараметрыФормыУказанияСерий.Вставить("ЗначенияПолейДляОпределенияРаспоряжения", ЗначенияПолейДляОпределенияРаспоряжения);
	
	Если РегистрироватьСерии Тогда
		текИмяФормы = "Обработка.ПодборСерийВДокументы.Форма.РегистрацияИПодборСерийПоОднойСтрокеТоваров";
	Иначе
		текИмяФормы = "Обработка.ПодборСерийВДокументы.Форма.ПодборСерийПоОстаткамДляВсехСтрокТоваров";
	КонецЕсли;
	
	ПараметрыФормыУказанияСерий.Вставить("ИмяФормы", текИмяФормы);
	
	Если ЗначениеЗаполнено(ЗаголовокКолонкиКоличество) Тогда
		ПараметрыФормыУказанияСерий.Вставить("ЗаголовокКолонкиКоличество", ЗаголовокКолонкиКоличество);
	КонецЕсли;
	
	Возврат ПараметрыФормыУказанияСерий;
	
КонецФункции

Процедура ОкруглитьКоличествоШтучныхТоваров(Объект, РежимЗаписи = Неопределено, ПараметрыОкругления = Неопределено) Экспорт
	
	Если РежимЗаписи <> Неопределено
		И РежимЗаписи <> РежимЗаписиДокумента.Проведение
		И ТипЗнч(РежимЗаписи) = Тип("РежимЗаписиДокумента")
		И Объект.Метаданные().Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ПараметрыОкругления = Неопределено Тогда
		ПараметрыОкругления = НоменклатураСервер.ПараметрыОкругленияКоличестваШтучныхТоваров();
	КонецЕсли;
	
	ИмяТЧ = ПараметрыОкругления.ИмяТЧ;
	ИмяПоляКоличествоСуффикс = ПараметрыОкругления.ИмяПоляКоличествоСуффикс;
	УсловиеОтбораСтрокПоДополнительнымПолям = ПараметрыОкругления.УсловиеОтбораСтрокПоДополнительнымПолям;
	УсловиеОтбораСтрокДляОкругления = ПараметрыОкругления.УсловиеОтбораСтрокДляОкругления;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Упаковка,
	|	ВЫРАЗИТЬ(ТЧ.Количество КАК ЧИСЛО(15, 0)) КАК КоличествоОкругленное,
	|	ВЫРАЗИТЬ(&ИмяПоляКоличествоСуффикс КАК ЧИСЛО(15, 0)) КАК КоличествоСуффиксОкругленное,
	|	&ДополнительныеПоля
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|ГДЕ
	|	ТЧ.Упаковка <> ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|	И (ТЧ.Количество <> (ВЫРАЗИТЬ(ТЧ.Количество КАК ЧИСЛО(15, 0)))
	|			ИЛИ &ИмяПоляКоличествоСуффикс <> (ВЫРАЗИТЬ(&ИмяПоляКоличествоСуффикс КАК ЧИСЛО(15, 0))))
	|	И (&УсловиеОтбораСтрокДляОкругления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.КоличествоОкругленное КАК КоличествоОкругленное,
	|	ТЧ.КоличествоСуффиксОкругленное КАК КоличествоСуффиксОкругленное
	|ИЗ
	|	ВТ КАК ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТНоменклатура
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК ТУпаковкиЕдиницыХранения
	|			ПО (ТУпаковкиЕдиницыХранения.Ссылка = ТНоменклатура.ЕдиницаИзмерения)
	|				И (ТУпаковкиЕдиницыХранения.ТипИзмеряемойВеличины = &ШтучныйТип)
	|		ПО (ТНоменклатура.Ссылка = ТЧ.Номенклатура)
	|		
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК ТУпаковкиТЧ
	|		ПО (ТУпаковкиТЧ.Ссылка = ТЧ.Упаковка)
	|			И (ТУпаковкиТЧ.ТипИзмеряемойВеличины В (&МерныеТипы))
	|ГДЕ
	|	&УсловиеОтбораСтрокПоДополнительнымПолям";
	
	Если ЗначениеЗаполнено(ИмяПоляКоличествоСуффикс) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоляКоличествоСуффикс", "ТЧ." + ИмяПоляКоличествоСуффикс);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоляКоличествоСуффикс", "0");
	КонецЕсли;
	
	Если УсловиеОтбораСтрокДляОкругления <> "" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
									"&УсловиеОтбораСтрокДляОкругления",
									СтрЗаменить(УсловиеОтбораСтрокДляОкругления, ИмяТЧ + ".", "ТЧ."));
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораСтрокДляОкругления", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОкругления.ДополнительныеПоля) Тогда
		Шаблон = "%1 КАК %2,
					|%3";
		ТекстПолей = Шаблон;
		
		Для каждого Поле Из ПараметрыОкругления.ДополнительныеПоля Цикл
			ТекстПолей = СтрШаблон(ТекстПолей, СтрЗаменить(Поле.Значение, ИмяТЧ + ".", "ТЧ."), Поле.Ключ, Шаблон);
		КонецЦикла;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
									"&ДополнительныеПоля", 
									Сред(ТекстПолей, 1, СтрНайти(ТекстПолей, ",", НаправлениеПоиска.СКонца,, 2) - 1));
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДополнительныеПоля", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УсловиеОтбораСтрокПоДополнительнымПолям) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
									"&УсловиеОтбораСтрокПоДополнительнымПолям",
									СтрЗаменить(УсловиеОтбораСтрокПоДополнительнымПолям, ИмяТЧ + ".", "ТЧ."));
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораСтрокПоДополнительнымПолям", "ИСТИНА");	
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
		
	Если ИмяТЧ = "Объект" Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5,0,ДопустимыйЗнак.Неотрицательный)));
		Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		Таблица.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
		Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Неотрицательный)));
		
		СтрокаТаблицы = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Объект);
		
		Запрос.УстановитьПараметр("ТЧ", Таблица);
	Иначе
		Запрос.УстановитьПараметр("ТЧ", ОбщегоНазначенияУТ.МассивВТаблицуЗначений(Объект[ИмяТЧ]));
	КонецЕсли;
	
	Для Каждого ПараметрЗапроса Из ПараметрыОкругления.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
	КонецЦикла;
	
	МерныеТипы = Новый Массив;
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Вес);
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Объем);
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Площадь);
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Длина);
	
	Запрос.УстановитьПараметр("МерныеТипы", МерныеТипы);
	Запрос.УстановитьПараметр("ШтучныйТип", Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ИмяТЧ = "Объект" Тогда
			Объект.Количество = Выборка.КоличествоОкругленное;
			Если ЗначениеЗаполнено(ИмяПоляКоличествоСуффикс) Тогда
				Объект[ИмяПоляКоличествоСуффикс] = Выборка.КоличествоСуффиксОкругленное;
			КонецЕсли;
		Иначе
			Объект[ИмяТЧ][Выборка.НомерСтроки - 1].Количество = Выборка.КоличествоОкругленное;
			Если ЗначениеЗаполнено(ИмяПоляКоличествоСуффикс) Тогда
				Объект[ИмяТЧ][Выборка.НомерСтроки - 1][ИмяПоляКоличествоСуффикс] = Выборка.КоличествоСуффиксОкругленное;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Сохранение_результата_подбора_серии

&НаКлиенте
Процедура ОткрытьПодборСерийЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	ТекущийЭтапОбъект = Неопределено;
	Если РезультатЗакрытия <> Неопределено Тогда
	
		ОбработатьУказаниеСерийСервер(
				ДополнительныеПараметры.ПараметрыУказанияСерий, 
				ДополнительныеПараметры.ПараметрыФормыУказанияСерий,
				ТекущийЭтапОбъект);
		
		//ТоварыСерияПересчитатьЦены(, ДополнительныеПараметры.ПараметрыУказанияСерий.ИмяТЧТовары);
		ПроставитьТекущийЭтапОбъект(ДополнительныеПараметры.СтрокаТЧ.ЭтапПроизводства,ТекущийЭтапОбъект);
		ОбработатьВыбранныеСтроки(ТекущееИмяКоманды);
	Иначе//Пользователь закрыл окно указания серий, не указав серии
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Закрыто окно указания серий, выполнение обработки прервано";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьУказаниеСерийСервер(Знач ПараметрыУказанияСерий, Знач ПараметрыФормыУказанияСерий, ТекущийЭтапОбъект)
	
	ТекущийЭтапОбъект = ПараметрыФормыУказанияСерий.Регистратор.Ссылка.ПолучитьОбъект();
	ПараметрыРаспределенияЗатрат = Новый ФиксированнаяСтруктура(Документы.ЭтапПроизводства2_2.ПараметрыРаспределенияЗатрат(ТекущийЭтапОбъект));
	
	СтруктураДействий = Новый Структура;
	Если ПараметрыУказанияСерий.ИмяТЧТовары = "ВыходныеИзделия"
		ИЛИ ПараметрыУказанияСерий.ИмяТЧТовары = "ПобочныеИзделия"
		ИЛИ ПараметрыУказанияСерий.ИмяТЧТовары = "ЭкономияМатериалов" Тогда
		СтруктураДействий.Вставить("ОбновлятьКоличествоТоваровПриРегистрацииСерий", Истина);
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ПараметрыУказанияСерий.ИмяТЧТовары, ЭтаФорма, СтруктураДействий, ПараметрыРаспределенияЗатрат);
	КонецЕсли;
	
	НоменклатураСервер.ОбработатьУказаниеСерий(
		ТекущийЭтапОбъект, 
		ПараметрыУказанияСерий, 
		ПараметрыФормыУказанияСерий, 
		СтруктураДействий);
		
	//ПослеИзмененияСтрокТЧПрограммноНаСервере(ПараметрыУказанияСерий.ИмяТЧТовары,, СтруктураДействий);
	ТекущийЭтапОбъект = ПолучитьДанныеОбъекта(ПараметрыФормыУказанияСерий.Регистратор.Ссылка,ТекущийЭтапОбъект);//Объект ТекущийЭтапОбъект преобразуем в структуру
	//Если ТекущееИмяКоманды = "УказатьСерии" Тогда
	//	ТекущийЭтапОбъект.Записать(РежимЗаписиДокумента.Проведение);//удалить комментарий
	//Иначе
	//	ТекущийЭтапОбъект.Записать(РежимЗаписиДокумента.Запись);//Потом ещё будет выпуск отражён, после чего документ будет проведен//удалить комментарий
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, Форма, СтруктураДействий, ПараметрыРаспределенияЗатрат)
	
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПроизводствоКлиентСервер.ПараметрыПересчетаКоличестваЕдиниц());
	
	//Если ИмяТЧ = "ПобочныеИзделия"
	//	ИЛИ (ИмяТЧ = "ВыходныеИзделия" И Форма.ИспользоватьПлановуюСтоимость) Тогда
	//	СтруктураДействий.Вставить("ПересчитатьСумму");
	//КонецЕсли;
	
	Если ИмяТЧ = "ВыходныеИзделия" Тогда
		СтруктураДействий.Вставить("ПересчитатьДолюСтоимости", ПараметрыРаспределенияЗатрат);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Обработчики_отражения_выпуска

&НаСервере
Процедура ЗавершитьПроизводство(СтруктураСтроки,ТекущийЭтапОбъект)
	
	Для каждого СтрокаТЧ Из ТекущийЭтапОбъект.ВыходныеИзделия Цикл
		Если СтрокаТЧ.НомерСтроки = СтруктураСтроки.НомерСтрокиВыпуска Тогда
			СтрокаТЧ.Количество			= СтруктураСтроки.КоличествоФакт;
			СтрокаТЧ.КоличествоУпаковок	= СтруктураСтроки.КоличествоФакт;
			СтрокаТЧ.Произведено		= Истина;
			СтрокаТЧ.Отменено			= Ложь;
			СтрокаТЧ.ДатаПроизводства	= ТекущаяДата();
		Иначе//Для остальных строк тоже завершим производство, не меняя количества
			СтрокаТЧ.Произведено		= Истина;
			СтрокаТЧ.Отменено			= Ложь;
			СтрокаТЧ.ДатаПроизводства	= ТекущаяДата();
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из ТекущийЭтапОбъект.ПобочныеИзделия Цикл
		СтрокаТЧ.Произведено		= Истина;
		СтрокаТЧ.Отменено			= Ложь;
		СтрокаТЧ.ДатаПроизводства	= ТекущаяДата();
	КонецЦикла;
	
	ПроставитьТекущийЭтапОбъект(СтруктураСтроки.ЭтапПроизводства,ТекущийЭтапОбъект);
	//ОбработатьВыбранныеСтроки(ТекущееИмяКоманды);
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьПроизводство(СтруктураСтроки,ТекущийЭтапОбъект)
	//Сценарий "Отменено"
	Для каждого СтрокаТЧ Из ТекущийЭтапОбъект.ВыходныеИзделия Цикл
		Если СтрокаТЧ.НомерСтроки <> СтруктураСтроки.НомерСтрокиВыпуска Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТЧ.Количество			= 0;
		СтрокаТЧ.КоличествоУпаковок	= 0;
		СтрокаТЧ.Произведено		= Ложь;
		СтрокаТЧ.Отменено			= Истина;
		СтрокаТЧ.ДатаПроизводства	= Дата(1,1,1);
	КонецЦикла;
	
	ПроставитьТекущийЭтапОбъект(СтруктураСтроки.ЭтапПроизводства,ТекущийЭтапОбъект);
	//ОбработатьВыбранныеСтроки(ТекущееИмяКоманды);
	
КонецПроцедуры

&НаСервере
Процедура СтартоватьНовыйЭтап(СтруктураСтроки,ТекущийЭтапОбъект=Неопределено)
	
	ПроставитьТекущийЭтапОбъект(СтруктураСтроки.ЭтапПроизводства,ТекущийЭтапОбъект,Истина);
	
КонецПроцедуры

&НаКлиенте 
Процедура ОбработатьВыборЗакрытияЭтапа(Результат, Параметры)Экспорт
	
	СтруктураСтроки = СоздатьСтруктуруСтроки();
	ЗаполнитьЗначенияСвойств(СтруктураСтроки,Параметры.СтрокаТЧ);
	
	Если Результат = КодВозвратаДиалога.Да Тогда//Завершить
		ЗавершитьПроизводство(СтруктураСтроки,?(ТипЗнч(Параметры.СтрокаТЧ.ТекущийЭтапОбъект)=Тип("Структура"),Параметры.СтрокаТЧ.ТекущийЭтапОбъект,
								ПолучитьДанныеОбъекта(Параметры.СтрокаТЧ.ЭтапПроизводства)));
	Иначе//Данный этап завершить и начать следующий
		ЗавершитьПроизводство(СтруктураСтроки,?(ТипЗнч(Параметры.СтрокаТЧ.ТекущийЭтапОбъект)=Тип("Структура"),Параметры.СтрокаТЧ.ТекущийЭтапОбъект,
								ПолучитьДанныеОбъекта(Параметры.СтрокаТЧ.ЭтапПроизводства)));
		СтартоватьНовыйЭтап(СтруктураСтроки,?(ТипЗнч(Параметры.СтрокаТЧ.ТекущийЭтапОбъект)=Тип("Структура"),Параметры.СтрокаТЧ.ТекущийЭтапОбъект,
								ПолучитьДанныеОбъекта(Параметры.СтрокаТЧ.ЭтапПроизводства)));//На количество недопроизведенной продукции
	КонецЕсли;
	
	//Параметры.СтрокаТЧ.СтрокаОбработана	= Истина;
	Параметры.СтрокаТЧ.Выбор			= Ложь;
	ОбработатьВыбранныеСтроки(ТекущееИмяКоманды);
	
КонецПроцедуры

Функция СоздатьСтруктуруСтроки()
	Возврат Новый Структура("ЭтапПроизводства,НомерСтрокиВыпуска,ТекущийЭтапОбъект,КоличествоФакт");
КонецФункции

#КонецОбласти

//Проставление реквизита ТекущийЭтапОбъект в ТЗ ТаблицаПроизводства для выбранных строк с указанной ссылкой
// Параметры:
//  СсылкаНаОбъект - ссылка на документ ЭтапПроизводства2_2
Процедура ПроставитьТекущийЭтапОбъект(СсылкаНаОбъект,ТекущийЭтапОбъект,СтартоватьНовыйЭтап=Ложь)
	
	Для каждого СтрокаТЧ Из ТаблицаПроизводства Цикл
		Если Не СтрокаТЧ.Выбор Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЧ.ЭтапПроизводства = СсылкаНаОбъект Тогда
			СтрокаТЧ.ТекущийЭтапОбъект		= ТекущийЭтапОбъект;
			СтрокаТЧ.СтартоватьНовыйЭтап	= СтартоватьНовыйЭтап;
			ОбновитьКоличествоФакт(СтрокаТЧ,ТекущийЭтапОбъект);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПроизводстваЗавершитьЭтапПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаПроизводства.ТекущиеДанные;
	
	Если Не ТекущаяСтрока.Выбор Тогда//Без флага Выбор не даём менять флаг ЗавершитьЭтап
		ТекущаяСтрока.ЗавершитьЭтап = Не ТекущаяСтрока.ЗавершитьЭтап;
		Возврат;
	КонецЕсли;
	
	Если Не ТекущаяСтрока.ЗавершитьЭтап Тогда
		Возврат;//Этап завершается, когда ставим галку, иначе никаких действий не производим
	КонецЕсли;
	
	ИдентификаторСтроки = Новый Структура("ПроверятьИдентификатор,ИдентификаторСтроки",
										Истина,ТекущаяСтрока.ПолучитьИдентификатор());
	
	ТекущееИмяКоманды = "ОтразитьВыпуск";
	ОбработатьВыбранныеСтроки("ОтразитьВыпуск");
	
КонецПроцедуры

//Если отражение производства необходимо для одной конкретной строки (обработка флага завершения производства)
//то программа запоминает идентификатор данной строки. При обоходе ТЧ будут игнорироваться все строки
//кроме строки с необходимым идентификатором
&НаКлиенте 
Функция ИдентификаторСтрокиПодходит(текИдентификатор)
	
	ИдентификаторПодходит = Истина;
	Если ТипЗнч(ИдентификаторСтроки) = Тип("Структура") 
		И ИдентификаторСтроки.Свойство("ПроверятьИдентификатор")
		И ИдентификаторСтроки.Свойство("ИдентификаторСтроки")
		И ИдентификаторСтроки.ПроверятьИдентификатор = Истина
		И ИдентификаторСтроки.ИдентификаторСтроки <> текИдентификатор Тогда
		ИдентификаторПодходит = Ложь;
	КонецЕсли;
	
	Возврат ИдентификаторПодходит;
	
КонецФункции

&НаСервере
Процедура ЗаписатьИзмененныеЭтапыПроизводства()
	
	УстановитьПривилегированныйРежим(Истина);
	//Временно снимем ограничение, чтобы не мешало создавать новые этапы при необходимости
	Константы.ДопустимоеОтклонениеОтгрузкиПриемкиМерныхТоваров.Установить(0);
	
	ВремТЗ = ТаблицаПроизводства.Выгрузить();
	ВремТЗ.Свернуть("Выбор,Заказ,ЭтапПроизводства,СтрокаОбработана,ТекущийЭтапОбъект,СтартоватьНовыйЭтап");//Группировка по этапу производства, чтобы записать его 1 раз
	
	Для каждого СтрокаТЗ Из ВремТЗ Цикл
		Если ТипЗнч(СтрокаТЗ.ТекущийЭтапОбъект) = Тип("Структура") Тогда
			//Проведение обработанных документов
			//В структуре содержится описание измененного документа, его надо записать как объект
			ТекущийЭтапОбъект = СтрокаТЗ.ЭтапПроизводства.ПолучитьОбъект();
			ПерезаполнитьТЧОбъекта(СтрокаТЗ.ТекущийЭтапОбъект,ТекущийЭтапОбъект);
			ТекущийЭтапОбъект.ФактическоеНачалоЭтапа	= ?(ЗначениеЗаполнено(ТекущийЭтапОбъект.ФактическоеНачалоЭтапа),ТекущийЭтапОбъект.ФактическоеНачалоЭтапа,ТекущаяДата());
			ТекущийЭтапОбъект.ФактическоеОкончаниеЭтапа	= ТекущаяДата();
			ТекущийЭтапОбъект.Статус					= Перечисления.СтатусыЭтаповПроизводства2_2.Завершен;
			
			Попытка
				ТекущийЭтапОбъект.Записать(РежимЗаписиДокумента.Проведение);
				ЭтапПроведен = Истина;
			Исключение
				ЭтапПроведен = Ложь;
				ТекстОшибкиПроведения = "Ошибка проведения этапа производства: " 
										+ ТекущийЭтапОбъект.Ссылка;
				
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
					УровеньЖурналаРегистрации.Ошибка,,ТекущийЭтапОбъект.Ссылка,
					ТекстОшибкиПроведения + ". " + ИнформацияОбОшибке());
			КонецПопытки;
			
			Если СтрокаТЗ.СтартоватьНовыйЭтап И ЭтапПроведен Тогда//Прошлых этап недопроизвели, стартуем новый на остаток недопроизвенного
				Распоряжения = Новый Массив;
				Распоряжения.Добавить(СтрокаТЗ.Заказ);
				ПараметрыПроцедуры = Новый Структура("ЗаменятьМатериалыНаАналоги,
													| ЗаменятьПФНаАналоги,
													| ПередатьЭтапыКВыполнению,
													| ПриРасчетеГрафикаЗадействоватьРезерв,
													| Распоряжения,
													| РассчитатьГрафик,
													| РезервироватьМатериалы,
													| РезервироватьПФ,
													| ДоступныеРезервыВГрафике",			//Не всегда спрашивает этот параметр, не ясно, для чего он
													Ложь,Ложь,Истина,Ложь,Распоряжения,Истина,Ложь,Ложь,Неопределено);
				Адрес = ПоместитьВоВременноеХранилище(0, УникальныйИдентификатор);
				Документы.ЭтапПроизводства2_2.СформироватьЭтапы(ПараметрыПроцедуры,Адрес);
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Создан новый этап производства для: " + СтрокаТЗ.Заказ;
				Сообщение.Сообщить();
			КонецЕсли;
			
			//Обработка ТЧ ТаблицаПроизводства
			ПараметрыОтбора = Новый Структура("Выбор,Заказ,ЭтапПроизводства,СтрокаОбработана,ТекущийЭтапОбъект,СтартоватьНовыйЭтап");
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора,СтрокаТЗ);
			МассивСтрок = ТаблицаПроизводства.НайтиСтроки(ПараметрыОтбора);
			Для каждого СтрокаТЧ Из МассивСтрок Цикл
				Если ТипЗнч(СтрокаТЗ.ТекущийЭтапОбъект) = Тип("Структура") Тогда
					Если ЭтапПроведен Тогда
						СтрокаТЧ.СтрокаОбработана	= Истина;
					Иначе
						СтрокаТЧ.СтрокаОбработана	= Ложь;
						СтрокаТЧ.Выбор				= Истина;
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = ТекстОшибкиПроведения;
						Сообщение.Поле = "ТаблицаПроизводства[" + СтрокаТЧ.ПолучитьИдентификатор() + "].Выбор";
						Сообщение.Сообщить();
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	//Вернем значение константы как было
	Константы.ДопустимоеОтклонениеОтгрузкиПриемкиМерныхТоваров.Установить(ДопустимоеОтклонениеОтгрузкиПриемкиМерныхТоваров);
	
	//Сброс идентификатора
	ИдентификаторСтроки = Новый Структура("ПроверятьИдентификатор,ИдентификаторСтроки",Ложь,0);
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьТЧОбъекта(Структура,ТекущийЭтапОбъект)
	
	ТекущийЭтапОбъект.ВыходныеИзделия.Очистить();
	ТекущийЭтапОбъект.ВыходныеИзделияСерии.Очистить();
	ТекущийЭтапОбъект.ПобочныеИзделия.Очистить();
	
	ТекДата = ТекущаяДата();
	
	//ТЧ ВыходныеИзделия
	Для каждого СтрокаТЧ Из Структура.ВыходныеИзделия Цикл
		НоваяСтрока = ТекущийЭтапОбъект.ВыходныеИзделия.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТЧ);
	КонецЦикла;
	
	//ТЧ ВыходныеИзделияСерии
	//СтруктураПоиска = Новый Структура("НомерСтроки");
	Для каждого СтрокаТЧ Из Структура.ВыходныеИзделияСерии Цикл
		НоваяСтрока = ТекущийЭтапОбъект.ВыходныеИзделияСерии.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТЧ);
		//СтруктураПоиска.НомерСтроки = СтрокаТЧ.НомерСтроки;
		//НайденныеСтроки = ТекущийЭтапОбъект.ВыходныеИзделия.НайтиСтроки(СтруктураПоиска);
		//Если НайденныеСтроки.Количество() <> 0 Тогда
		//	НоваяСтрока.Произведено			= НайденныеСтроки[0].Произведено;
		//	НоваяСтрока.Отменено			= НайденныеСтроки[0].Отменено;
		//	НоваяСтрока.ДатаПроизводства	= НайденныеСтроки[0].ДатаПроизводства;
		//КонецЕсли;
		НоваяСтрока.Произведено			= Истина;
		НоваяСтрока.Отменено			= Ложь;
		НоваяСтрока.ДатаПроизводства	= ТекДата;
	КонецЦикла;
	
	//ТЧ ПобочныеИзделия
	ТЗНормыПобочныхИзделий = НормаПобочныхИзделийПоСпецификации(ТекущийЭтапОбъект.Спецификация);
	СтруктураПоиска = Новый Структура("Номенклатура");
	Для каждого СтрокаТЧ Из Структура.ПобочныеИзделия Цикл
		НоваяСтрока = ТекущийЭтапОбъект.ПобочныеИзделия.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТЧ);
		СтруктураПоиска.Номенклатура = СтрокаТЧ.Номенклатура;
		НайденныеСтроки = ТЗНормыПобочныхИзделий.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 
			И НайденныеСтроки[0].ОсновноеИзделиеКоличествоУпаковок <> 0 Тогда
			НоваяСтрока.Количество = ТекущийЭтапОбъект.ВыходныеИзделия.Итог("Количество")
									* НайденныеСтроки[0].КоличествоУпаковок
									/ НайденныеСтроки[0].ОсновноеИзделиеКоличествоУпаковок;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		КонецЕсли;
	КонецЦикла;
	
	//Вкладка Основное
	ПересчитатьОбеспечение = Ложь;
	Если ТекущийЭтапОбъект.КоличествоУпаковокФакт <> ТекущийЭтапОбъект.ВыходныеИзделия.Итог("Количество") Тогда
		ПересчитатьОбеспечение = Истина;
	КонецЕсли;
	ТекущийЭтапОбъект.КоличествоУпаковокФакт		= ТекущийЭтапОбъект.ВыходныеИзделия.Итог("Количество");
	// <+БИТ> Руденков_Е.И. 25.10.2024  
	// Пересчет норм по ресурсной спецификации
	//ТекущийЭтапОбъект.КоличествоУпаковокОтменено	= ТекущийЭтапОбъект.КоличествоУпаковокПлан - ТекущийЭтапОбъект.КоличествоУпаковокФакт;
	ТекущийЭтапОбъект.КоличествоУпаковокПлан = ТекущийЭтапОбъект.КоличествоУпаковокФакт;//Уравниваем план с фактом, т.к. при открытии этапа Нормативы заполняются на основании плана.
	// <-БИТ> Руденков_Е.И. 25.10.2024
	ДанныеПартииПроизводства = Документы.ЭтапПроизводства2_2.ДанныеПартииПроизводства(ТекущийЭтапОбъект.Распоряжение,ТекущийЭтапОбъект.НазначениеПродукция,ТекущийЭтапОбъект.ПартияПроизводства);
	ЗаполнитьНормативы("ОбеспечениеМатериаламиИРаботами",,ТекущийЭтапОбъект);
	ЗаполнитьНормативы("Трудозатраты",,ТекущийЭтапОбъект);
	
	#Область ТЧ_ОбеспечениеМатериаламиИРаботами
	СтандартнаяПричинаОтмены = ПолучитьСтандартнуюПричинуОтмены();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПолучитьТабФильтр(Запрос,ТекущийЭтапОбъект.Ссылка);//в конкретном этапе производства получаем данные ТЧ ОбеспечениеМатериаламиИРаботами (Склад, Номенклатура, Характеристика, Назначение без колчичества, помещаем в ВТ ТабФильтр)
	Запрос.Текст = ОбеспечениеВДокументахСервер.ВременнаяТаблицаСвободныеОстатки("ТабФильтр",
																		"ТабРезультат",Ложь);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПОМЕСТИТЬ ТабРезультат","");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ИНДЕКСИРОВАТЬ ПО","");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"Номенклатура, Характеристика, Склад, Назначение","");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"()","(Номенклатура, Характеристика, Склад, Назначение)");
	//Запрос.Текст = СтрЗаменить(Запрос.Текст,"Фильтр.Склад КАК Склад,","");
	
	Результат			= Запрос.Выполнить();
	ОбеспечениеОстатки	= Результат.Выгрузить();//Получили остатки номенклатуры из ТЧ ОбеспечениеМатериаламиИРаботами
	ОбеспечениеОстатки.Свернуть("Номенклатура,Характеристика,Склад,Назначение","Количество");
	СтруктураПоиска = Новый Структура("Номенклатура,Характеристика,Склад,Назначение");
	Для каждого СтрокаТЧ Из ТекущийЭтапОбъект.ОбеспечениеМатериаламиИРаботами Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТЧ);
		
		//ТЗ сгруппирована, поэтому будет найдено не более 1-й строки
		СтрокиОстатков = ОбеспечениеОстатки.НайтиСтроки(СтруктураПоиска);
		Если СтрокиОстатков.Количество() > 0 
			И СтрокиОстатков[0].Количество >= СтрокаТЧ.КоличествоУпаковок Тогда
			СтрокаТЧ.ВариантОбеспечения		= Перечисления.ВариантыОбеспечения.Отгрузить;
			СтрокиОстатков[0].Количество	= СтрокиОстатков[0].Количество - СтрокаТЧ.КоличествоУпаковок;
		Иначе
			СтрокаТЧ.ВариантОбеспечения	= Перечисления.ВариантыОбеспечения.Отгрузить;
			СтрокаТЧ.Отменено			= Истина;
			СтрокаТЧ.ПричинаОтмены		= СтандартнаяПричинаОтмены;
		КонецЕсли;
	КонецЦикла;
	#КонецОбласти
	
	// <+БИТ> Руденков_Е.И. 28.10.2024  
	// Пересчет норм по ресурсной спецификации
	//ТЧ Трудозатраты
	РеквизитыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийЭтапОбъект.Подразделение,"КАНАТ_ИсполнительРабот");
	Для каждого СтрокаТЧ Из ТекущийЭтапОбъект.Трудозатраты Цикл
		СтрокаТЧ.Выполнено		= Истина;
		СтрокаТЧ.Отменено		= Ложь;
		СтрокаТЧ.ДатаВыполнения	= ТекДата;
		СтрокаТЧ.Исполнитель	= РеквизитыПодразделения.КАНАТ_ИсполнительРабот;
	КонецЦикла;
	// <-БИТ> Руденков_Е.И. 28.10.2024
	
	//ТЧ РасходМатериаловИРабот
	Документы.ЭтапПроизводства2_2.ЗаполнитьРасходМатериаловИРаботПоДаннымОбеспечения(ТекущийЭтапОбъект);
	
КонецПроцедуры 

//В ТЗ ТаблицаПроизводства обновляет поле КоличествоФакт в соответствии 
//с количесвом заданным на форме выбора серий
Процедура ОбновитьКоличествоФакт(СтрокаТЧ,ТекущийЭтапОбъект)
	
	Для каждого СтрокаИзделий Из ТекущийЭтапОбъект.ВыходныеИзделия Цикл
		Если СтрокаИзделий.НомерСтроки = СтрокаТЧ.НомерСтрокиВыпуска Тогда
			СтрокаТЧ.КоличествоФакт = СтрокаИзделий.Количество;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьТабФильтр(Запрос,ЭтапПроизводстваСсылка)
	//ПривилегированныйРежим()
	Запрос.Текст = "ВЫБРАТЬ
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Склад КАК Склад,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика КАК Характеристика,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Назначение КАК Назначение
	|ПОМЕСТИТЬ ТабФильтр
	|ИЗ
	|	Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами
	|ГДЕ
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабФильтр.Склад КАК Склад,
	|	ТабФильтр.Номенклатура КАК Номенклатура,
	|	ТабФильтр.Характеристика КАК Характеристика,
	|	ТабФильтр.Назначение КАК Назначение
	|ИЗ
	|	ТабФильтр КАК ТабФильтр";
	
	Запрос.УстановитьПараметр("Ссылка",ЭтапПроизводстваСсылка);
	Результат = Запрос.Выполнить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтандартнуюПричинуОтмены()
	//ПривилегированныйРежим()
	СтандартнаяПричинаОтмены = Справочники.ПричиныОтменыПроизводства.НайтиПоНаименованию("АРМ отражение факта выпуска");
	Если СтандартнаяПричинаОтмены = Неопределено
		Или СтандартнаяПричинаОтмены = Справочники.ПричиныОтменыПроизводства.ПустаяСсылка() Тогда
		СтандартнаяПричинаОтмены = Справочники.ПричиныОтменыПроизводства.ПустаяСсылка();
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПричиныОтменыПроизводства.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПричиныОтменыПроизводства КАК ПричиныОтменыПроизводства
		|ГДЕ
		|	НЕ ПричиныОтменыПроизводства.ПометкаУдаления";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтандартнаяПричинаОтмены = Выборка.Ссылка;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтандартнаяПричинаОтмены;
	
КонецФункции 

&НаКлиенте
Процедура ОбновитьТаблицуПроизводства(Команда)
	ОбновитьДанныеТаблицаПроизводства();
КонецПроцедуры // <-БИТ> Руденков_Е.И. 14.03.2024

#Область Пересчет_нормативов

&НаСервере
Процедура ЗаполнитьНормативы(ИмяТЧ, СтрокиЗаполнения = Неопределено, ТекущийЭтапОбъект)
	
	ТребуетсяЗаполнить = Ложь;
	
	Если СтрокиЗаполнения <> Неопределено Тогда
		МассивСтрок = СтрокиЗаполнения;
	Иначе
		МассивСтрок = ТекущийЭтапОбъект[ИмяТЧ];
	КонецЕсли;
	
	Если ИмяТЧ = "ОбеспечениеМатериаламиИРаботами" Тогда
	
		МассивДанных = Новый Массив;
		Для каждого ТекущиеДанные Из МассивСтрок Цикл
			ДанныеСтроки = Новый Структура("Номенклатура,Характеристика,ХарактеристикиИспользуются,Упаковка");
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, ТекущиеДанные);
			Если Не ЗначениеЗаполнено(ТекущиеДанные.Характеристика) Тогда//Адаптация
				ДанныеСтроки.ХарактеристикиИспользуются = Ложь;
			Иначе
				ДанныеСтроки.ХарактеристикиИспользуются = Истина;
			КонецЕсли;
			МассивДанных.Добавить(ДанныеСтроки);
		КонецЦикла;
		ТребуетсяЗаполнить = Истина;
		
	ИначеЕсли ИмяТЧ = "Трудозатраты" Тогда
		
		МассивДанных = Новый Массив;
		Для каждого ТекущиеДанные Из МассивСтрок Цикл
			ДанныеСтроки = Новый Структура("ВидРабот");
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, ТекущиеДанные);
			МассивДанных.Добавить(ДанныеСтроки);
		КонецЦикла;
		ТребуетсяЗаполнить = Истина;
		
	КонецЕсли;
	
	Если ТребуетсяЗаполнить Тогда
		
		НормативыИзХранилища = ПолучитьНормативыИзВременногоХранилища(ТекущийЭтапОбъект);
		
		Нормативы = ПолучитьНормативыПриИзмененииСтрок(ИмяТЧ, МассивДанных, НормативыИзХранилища);
		Для Сч = 0 По МассивСтрок.Количество() - 1 Цикл
			//Адаптация
			//МассивСтрок[Сч].Норматив = Нормативы[Сч];
			МассивСтрок[Сч].Количество			= Нормативы[Сч];
			Если ИмяТЧ = "ОбеспечениеМатериаламиИРаботами" Тогда //БИТ_Байков - фикс. Вставляю проверку на то что это не ТЧ Трудозатраты
				МассивСтрок[Сч].КоличествоУпаковок	= Нормативы[Сч];
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНормативыИзВременногоХранилища(ТекущийЭтапОбъект)

	Если ЭтоАдресВременногоХранилища(АдресХранилищаНормативы) Тогда
		
		Результат = ПолучитьИзВременногоХранилища(АдресХранилищаНормативы);
		Возврат Результат;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	
	ДанныеСпецификации = ПолучитьНормативыПоСпецификации(Истина, "МатериалыИУслуги,ВходящиеИзделия,Трудозатраты",ТекущийЭтапОбъект);
	
	Если ДанныеСпецификации <> Неопределено Тогда
		
		Таблица = ДанныеСпецификации.МатериалыИУслуги.Скопировать(, "Номенклатура,Характеристика,Упаковка,ДанныеУпаковки,КоличествоУпаковок"); // ТаблицаЗначений - 
		Таблица.Свернуть("Номенклатура,Характеристика,Упаковка,ДанныеУпаковки", "КоличествоУпаковок");
		Результат.Вставить("ОбеспечениеМатериаламиИРаботами", Таблица);
		
		Таблица = ДанныеСпецификации.Трудозатраты.Скопировать(, "ВидРабот,Количество"); // ТаблицаЗначений - 
		Таблица.Свернуть("ВидРабот", "Количество");
		Результат.Вставить("Трудозатраты", Таблица);
		
	КонецЕсли;
	
	АдресХранилищаНормативы = ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьНормативыПоСпецификации(ПолучатьМатериалыПоТребованию, Знач ПереченьДанных = Неопределено,ТекущийЭтапОбъект)
	
	ДанныеПартииПроизводстваКопия = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеПартииПроизводства, Ложь);
	ДанныеПартииПроизводстваКопия.Количество = ТекущийЭтапОбъект.КоличествоУпаковокФакт;//Адоптация
	
	Возврат Документы.ЭтапПроизводства2_2.ПолучитьНормативыПоСпецификации(
		ДанныеПартииПроизводстваКопия,
		ПолучатьМатериалыПоТребованию,
		ПереченьДанных,
		Новый Структура("Этап", ТекущийЭтапОбъект.Этап));
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНормативыПриИзмененииСтрок(Знач ИмяТЧ, Знач МассивДанных, Знач АдресИлиНормативы)
	
	Если ЭтоАдресВременногоХранилища(АдресИлиНормативы) Тогда
		НормативыИзХранилища = ПолучитьИзВременногоХранилища(АдресИлиНормативы);
	Иначе
		НормативыИзХранилища = АдресИлиНормативы;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НормативыИзХранилища) И НормативыИзХранилища.Свойство(ИмяТЧ) Тогда
		Нормативы = НормативыИзХранилища[ИмяТЧ];
	Иначе
		Нормативы = Неопределено;
	КонецЕсли;
	
	Если ИмяТЧ = "ОбеспечениеМатериаламиИРаботами" Тогда
		
		СтруктураПоиска = Новый Структура("Номенклатура,Характеристика");
		
		Результат = УправлениеПроизводством.ПолучитьНормативы(
			Нормативы,
			МассивДанных,
			СтруктураПоиска,
			Истина);
		
	ИначеЕсли ИмяТЧ = "Трудозатраты" Тогда
		
		СтруктураПоиска = Новый Структура("ВидРабот");
		
		Результат = УправлениеПроизводством.ПолучитьНормативы(
			Нормативы,
			МассивДанных,
			СтруктураПоиска,
			Ложь);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// <+БИТ> Руденков_Е.И. 18.11.2024  
// Пересчет норм по ресурсной спецификации
&НаСервере
Функция НормаПобочныхИзделийПоСпецификации(ТекСпецификация)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РесурсныеСпецификацииВозвратныеОтходы.Ссылка.ОсновноеИзделиеКоличествоУпаковок КАК ОсновноеИзделиеКоличествоУпаковок,
	|	РесурсныеСпецификацииВозвратныеОтходы.Номенклатура КАК Номенклатура,
	|	РесурсныеСпецификацииВозвратныеОтходы.Характеристика КАК Характеристика,
	|	РесурсныеСпецификацииВозвратныеОтходы.Упаковка КАК Упаковка,
	|	РесурсныеСпецификацииВозвратныеОтходы.КоличествоУпаковок КАК КоличествоУпаковок
	|ИЗ
	|	Справочник.РесурсныеСпецификации.ВозвратныеОтходы КАК РесурсныеСпецификацииВозвратныеОтходы
	|ГДЕ
	|	РесурсныеСпецификацииВозвратныеОтходы.Ссылка = &ТекСпецификация";
	
	Запрос.УстановитьПараметр("ТекСпецификация",ТекСпецификация);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции // <-БИТ> Руденков_Е.И. 18.11.2024

#КонецОбласти

