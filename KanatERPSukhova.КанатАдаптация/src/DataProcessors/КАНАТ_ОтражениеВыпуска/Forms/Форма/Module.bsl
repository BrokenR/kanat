&НаСервере
Процедура ОбновитьДанныеТаблицаПроизводства()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаПроизводства.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	// <+БИТ> Руденков_Е.И. 21.03.2024 
	// #000000042, ЧТЗ_3_6_АРМ отражение выпущенной продукции
		//"ВЫБРАТЬ
		//|	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура.Код КАК Код,
		//|	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Изделие,
		//// <+БИТ> Руденков_Е.И. 20.03.2024 
		//// #000000042, ЧТЗ_3_6_АРМ отражение выпущенной продукции
		////|	ЭтапПроизводства2_2ВыходныеИзделия.КоличествоУпаковок КАК КоличествоПлан,
		////|	ЭтапПроизводства2_2ВыходныеИзделия.Упаковка КАК ЕдИзмерения,
		//|	ЭтапПроизводства2_2.КоличествоУпаковокПлан КАК КоличествоПлан,
		//|	ЭтапПроизводства2_2ВыходныеИзделия.КоличествоУпаковок КАК КоличествоФакт,
		//|	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура.ЕдиницаИзмерения КАК ЕдИзмерения,
		//// <-БИТ> Руденков_Е.И. 20.03.2024
		//|	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
		//|	ЭтапПроизводства2_2.Распоряжение КАК Заказ,
		//|	ЭтапПроизводства2_2.КАНАТ_КомментарийКЗаказу КАК Комментарий,
		//|	ЭтапПроизводства2_2ВыходныеИзделия.Характеристика КАК Упаковка,
		//|	ЭтапПроизводства2_2.Ссылка КАК ЭтапПроизводства
		//|ИЗ
		//|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
		//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
		//|		ПО ЭтапПроизводства2_2.Ссылка = ЭтапПроизводства2_2ВыходныеИзделия.Ссылка
		//|ГДЕ
		//|	ЭтапПроизводства2_2.ПометкаУдаления = ЛОЖЬ
		//|	И ЭтапПроизводства2_2ВыходныеИзделия.Отменено = ЛОЖЬ
		//|	И ЭтапПроизводства2_2ВыходныеИзделия.Произведено = ЛОЖЬ";
		
	"ВЫБРАТЬ
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка КАК ЭтапПроизводства,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура КАК Номенклатура,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика КАК Характеристика,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения КАК ВариантОбеспечения,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ЕСТЬNULL(РаспределениеЗапасов.Обеспечено, 0) КАК Обеспечено,
	|	ВЫБОР
	|		КОГДА ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	|			ТОГДА 2
	|		КОГДА ЕСТЬNULL(РаспределениеЗапасов.Обеспечено, 0) >= ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.КоличествоУпаковок
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК СтатусОбеспечения
	|ПОМЕСТИТЬ ВтОбеспечениеМатериалами
	|ИЗ
	|	Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	|		ПО ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка = РаспределениеЗапасов.ЗаказНаОтгрузку
	|			И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Номенклатура = РаспределениеЗапасов.Номенклатура
	|			И ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Характеристика = РаспределениеЗапасов.Характеристика
	|			И (ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.ВариантОбеспечения <> ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить))
	|			И (РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОбеспеченНаСкладе))
	|ГДЕ
	|	НЕ ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрафикЭтаповПроизводства2_2.Распоряжение КАК Распоряжение,
	|	ГрафикЭтаповПроизводства2_2.СтатусГрафика КАК СтатусГрафика,
	|	ГрафикЭтаповПроизводства2_2.ЭтапПроизводства КАК ЭтапПроизводства,
	|	ГрафикЭтаповПроизводства2_2.НачалоЭтапа КАК Начало,
	|	ГрафикЭтаповПроизводства2_2.ОкончаниеЭтапа КАК Окончание,
	|	ГрафикЭтаповПроизводства2_2.ОкончаниеПредварительногоБуфера КАК ОкончаниеПредварительногоБуфера,
	|	ГрафикЭтаповПроизводства2_2.НачалоЗавершающегоБуфера КАК НачалоЗавершающегоБуфера,
	|	ГрафикЭтаповПроизводства2_2.НачалоСледующегоЭтапа КАК НачалоСледующегоЭтапа,
	|	ГрафикЭтаповПроизводства2_2.НаКритическомПути КАК НаКритическомПути,
	|	ГрафикЭтаповПроизводства2_2.ОграничиваетСрокВыпуска КАК ОграничиваетСрокВыпуска,
	|	ГрафикЭтаповПроизводства2_2.ОграниченПоМатериалам КАК ОграниченПоМатериалам,
	|	ГрафикЭтаповПроизводства2_2.ОграниченПоОборудованию КАК ОграниченПоОборудованию,
	|	ГрафикЭтаповПроизводства2_2.РазмещениеВыпуска КАК РазмещениеВыпуска
	|ПОМЕСТИТЬ ВтГрафикЭтаповПроизводства
	|ИЗ
	|	РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК ГрафикЭтаповПроизводства2_2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура.Код КАК Код,
	|	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура КАК Изделие,
	|	ЭтапПроизводства2_2.КоличествоУпаковокПлан КАК КоличествоПлан,
	|	ЭтапПроизводства2_2ВыходныеИзделия.КоличествоУпаковок КАК КоличествоФакт,
	|	ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура.ЕдиницаИзмерения КАК ЕдИзмерения,
	|	ЭтапПроизводства2_2ВыходныеИзделия.Назначение КАК Назначение,
	|	ЭтапПроизводства2_2ВыходныеИзделия.НомерСтроки КАК НомерСтрокиВыпуска,
	|	ЭтапПроизводства2_2.Распоряжение КАК Заказ,
	|	ЭтапПроизводства2_2.КАНАТ_КомментарийКЗаказу КАК Комментарий,
	|	ЭтапПроизводства2_2ВыходныеИзделия.Характеристика КАК Упаковка,
	|	ЭтапПроизводства2_2.Ссылка КАК ЭтапПроизводства,
	|	ЕСТЬNULL(ВложенныйЗапрос.СтатусОбеспечения, 1) КАК СтатусОбеспечения,
	|	ЕСТЬNULL(ВтГрафикЭтаповПроизводства.Начало, ДАТАВРЕМЯ(1, 1, 1)) КАК Начало,
	|	ЕСТЬNULL(ВтГрафикЭтаповПроизводства.Окончание, ДАТАВРЕМЯ(1, 1, 1)) КАК Окончание
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
	|		ПО ЭтапПроизводства2_2.Ссылка = ЭтапПроизводства2_2ВыходныеИзделия.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВтОбеспечениеМатериалами.ЭтапПроизводства КАК ЭтапПроизводства,
	|			МИНИМУМ(ВтОбеспечениеМатериалами.СтатусОбеспечения) КАК СтатусОбеспечения
	|		ИЗ
	|			ВтОбеспечениеМатериалами КАК ВтОбеспечениеМатериалами
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВтОбеспечениеМатериалами.ЭтапПроизводства) КАК ВложенныйЗапрос
	|		ПО ЭтапПроизводства2_2.Ссылка = ВложенныйЗапрос.ЭтапПроизводства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтГрафикЭтаповПроизводства КАК ВтГрафикЭтаповПроизводства
	|		ПО ЭтапПроизводства2_2.Ссылка = ВтГрафикЭтаповПроизводства.ЭтапПроизводства
	|			И ЭтапПроизводства2_2.Распоряжение = ВтГрафикЭтаповПроизводства.Распоряжение
	|ГДЕ
	|	ЭтапПроизводства2_2.ПометкаУдаления = ЛОЖЬ";
	// <-БИТ> Руденков_Е.И. 21.03.2024
	
	Запрос.УстановитьПараметр("НачалоПериода", ФильтрПериод.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ФильтрПериод.ДатаОкончания);
	
	//Фильтры
	Если ЗначениеЗаполнено(ФильтрИзделие) Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура = &Номенклатура";
		
		Запрос.УстановитьПараметр("Номенклатура", ФильтрИзделие);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФильтрПодразделение) Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ЭтапПроизводства2_2.Подразделение = &Подразделение";
		
		Запрос.УстановитьПараметр("Подразделение", ФильтрПодразделение);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФильтрСостояние) Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ЭтапПроизводства2_2.Статус = &Состояние";
		
		Запрос.УстановитьПараметр("Состояние", ФильтрСостояние);
		
	КонецЕсли;
	
	// <+БИТ> Руденков_Е.И. 20.03.2024 
	// #000000042, ЧТЗ_3_6_АРМ отражение выпущенной продукции
	Если ЗначениеЗаполнено(ФильтрОбеспечение) Тогда
		Если ФильтрОбеспечение = 1 Тогда//Ждет обеспечение
			Запрос.Текст = Запрос.Текст + "
			|	И ЕСТЬNULL(ВложенныйЗапрос.СтатусОбеспечения, 1) = 1";
		ИначеЕсли ФильтрОбеспечение = 2 Тогда//Обеспечен полностью
			Запрос.Текст = Запрос.Текст + "
			|	И ЕСТЬNULL(ВложенныйЗапрос.СтатусОбеспечения, 1) = 2";
		КонецЕсли;
	КонецЕсли;
	// <-БИТ> Руденков_Е.И. 20.03.2024
	
	//Вывод
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		//График = Документы.ЭтапПроизводства2_2.ГрафикПроизводства(ВыборкаДетальныеЗаписи.ЭтапПроизводства);
		
		Если Не (ВыборкаДетальныеЗаписи.Начало > ФильтрПериод.ДатаОкончания ИЛИ ВыборкаДетальныеЗаписи.Окончание < ФильтрПериод.ДатаНачала) Тогда
			
			НоваяСтрока = ТаблицаПроизводства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
			//НоваяСтрока.Начало = График.НачалоЭтапа;
			//НоваяСтрока.Окончание = График.ОкончаниеЭтапа;
		ИначеЕсли Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Начало) 
			И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Окончание) Тогда//График отсутсвует, тоже включим в ТЧ
			НоваяСтрока = ТаблицаПроизводства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// <+БИТ> Руденков_Е.И. 22.03.2024 
	// #000000042, Обработка Отражение выпуска
	ЗаполнитьДопустимоеОтклонениеОтгрузкиПриемкиМерныхТоваров();
	
	ФильтрСостояние = Перечисления.СтатусыЭтаповПроизводства2_2.КВыполнению;
	// <-БИТ> Руденков_Е.И. 22.03.2024
	
	ФильтрПериод.ДатаНачала = НачалоМесяца(ТекущаяДата());
	ФильтрПериод.ДатаОкончания = КонецМесяца(ТекущаяДата());
	
	ОбновитьДанныеТаблицаПроизводства();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрИзделиеПриИзменении(Элемент)
	ОбновитьДанныеТаблицаПроизводства();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПодразделениеПриИзменении(Элемент)
	ОбновитьДанныеТаблицаПроизводства();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСостояниеПриИзменении(Элемент)
	ОбновитьДанныеТаблицаПроизводства();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрОбеспечениеПриИзменении(Элемент)
	ОбновитьДанныеТаблицаПроизводства();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПериодПриИзменении(Элемент)
	ОбновитьДанныеТаблицаПроизводства();
КонецПроцедуры

// <+БИТ> Руденков_Е.И. 14.03.2024 
// #000000042, ЧТЗ_3_6_АРМ отражение выпущенной продукции
&НаКлиенте
Процедура ТаблицаПроизводстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеТаблицы = Элементы.ТаблицаПроизводства.ТекущиеДанные;
	
	Если Поле.Имя = "ТаблицаПроизводстваЗаказ" Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,ТекущиеДанныеТаблицы.Заказ);
	ИначеЕсли Поле.Имя = "ТаблицаПроизводстваКоличествоФакт" И ТекущиеДанныеТаблицы.Выбор = Истина Тогда
		ПараметрыВвода = Новый Структура("КоличествоФакт",ТекущиеДанныеТаблицы.КоличествоФакт);
		ОткрытьФорму("Обработка.КАНАТ_ОтражениеВыпуска.Форма.ФормаВводаКоличестваФакта",ПараметрыВвода,Элементы.ТаблицаПроизводства);
	ИначеЕсли Поле.Имя = "ТаблицаПроизводстваКоличествоФакт" И ТекущиеДанныеТаблицы.Выбор = Ложь Тогда
		//В таком случае редактирование количества (факт) не допускается
	Иначе
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,ТекущиеДанныеТаблицы.ЭтапПроизводства);
	КонецЕсли;
	
КонецПроцедуры

