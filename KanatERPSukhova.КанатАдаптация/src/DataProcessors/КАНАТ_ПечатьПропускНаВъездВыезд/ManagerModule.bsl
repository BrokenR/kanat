//++ Гурьев 25.09.23 ЧТЗ_2.10
Функция ПолучитьДанныеШапкиПропускНаВъезд_устар(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Номер КАК Номер,
		|	ЗаказКлиента.Дата КАК Дата,
		|	ЗаказКлиента.Контрагент КАК Контрагент,
		|	ЗаказКлиента.Склад КАК Склад,
		|	ЗаказКлиента.Грузополучатель КАК Грузополучатель,
		|	ЗаказКлиента.СпособДоставки КАК СпособДоставки,
		|	ЗаказКлиента.КАНАТ_НомерИДатаДоверенности КАК НомерДоверенности,
		|	ЗаказКлиента.КАНАТ_ФИОСопроводителя КАК ФИОСопроводителя,
		|	ЗаказКлиента.КАНАТ_Водитель КАК Водитель,
		|	ЗаказКлиента.КАНАТ_ГосНомер КАК ГосНомер,
		|	ЗаказКлиента.КАНАТ_АвтомобильМарка КАК АвтомобильМарка,
		|	ЗаказКлиента.АдресДоставки КАК АдресДоставки
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &Документ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Возврат РезультатЗапроса.Выгрузить()[0];
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции
