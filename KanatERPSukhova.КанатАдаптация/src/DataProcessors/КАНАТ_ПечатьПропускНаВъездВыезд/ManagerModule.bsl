Функция ПолучитьДанныеТаблицыПропускНаВъезд_устар(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СправочникНоменклатура.Артикул КАК Артикул,
	|	ЗаказКлиентаТовары.Номенклатура КАК Наименование,
	|	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК ЕдИзм,
	|	ЗаказКлиентаТовары.КоличествоУпаковок КАК Количество,
	|	ЗаказКлиентаТовары.Цена КАК Цена,
	|	ЗаказКлиентаТовары.СтавкаНДС КАК НДС,
	|	ЗаказКлиентаТовары.СтавкаНДС.Ставка КАК СтавкаНДССтавка,
	|	ЗаказКлиентаТовары.Цена * (1 + ЗаказКлиентаТовары.СтавкаНДС.Ставка / 100) КАК ЦенаСНДС
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО ЗаказКлиентаТовары.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Документ
	|ИТОГИ
	|	Сумма(Количество)
	|ПО
	|	ЕдИзм";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции
