		|	КАНАТ_РаспоряжениеНаОтгрузку.Водитель КАК Водитель,
		|	КАНАТ_РаспоряжениеНаОтгрузку.КАНАТ_ВодительСсылка КАК КАНАТ_ВодительСсылка,
		|	КАНАТ_РаспоряжениеНаОтгрузку.ГосНомер КАК ГосНомер,
		|	КАНАТ_РаспоряжениеНаОтгрузку.АвтомобильМарка КАК АвтомобильМарка,
		|	КАНАТ_РаспоряжениеНаОтгрузку.Адрес КАК АдресДоставки,
		|	ЗаказКлиента.ПеревозчикПартнер КАК Перевозчик,
		|	ЗаказКлиента.АдресДоставкиПеревозчика КАК АдресПеревозчика
		|ИЗ
		|	Документ.КАНАТ_РаспоряжениеНаОтгрузку КАК КАНАТ_РаспоряжениеНаОтгрузку
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ПО КАНАТ_РаспоряжениеНаОтгрузку.ДокументОснование = ЗаказКлиента.Ссылка
		|ГДЕ
		|	КАНАТ_РаспоряжениеНаОтгрузку.Ссылка = &Документ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Возврат РезультатЗапроса.Выгрузить()[0];
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции
