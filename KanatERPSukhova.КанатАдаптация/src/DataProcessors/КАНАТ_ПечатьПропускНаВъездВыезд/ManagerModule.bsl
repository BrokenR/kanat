//++ Гурьев 26.09.23 ЧТЗ_2.10
Функция ПолучитьДанныеПФПропускНаВыезд_устар(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|	ВЫБРАТЬ
	|	ТранспортнаяНакладная.Номер КАК Номер,
	|	ТранспортнаяНакладная.Дата КАК Дата,
	|	РеализацияТоваровУслуг.Склад КАК НаименованиеПодразделения,
	|	ТранспортнаяНакладная.Грузополучатель КАК НаименованиеОрганизацииГрузополучателя,
	|	ТранспортнаяНакладная.Водитель КАК Водитель,
	|	ТранспортнаяНакладная.КАНАТ_ФИОСопроводителя КАК ФИОСопроводителя,
	|	ТранспортнаяНакладная.АвтомобильГосударственныйНомер КАК Автотранспорт,
	|	СправочникНоменклатура.ГруппаФинансовогоУчета КАК ТМЦ,
	|	РеализацияТоваровУслуг.Номер КАК НомерНакладной,
	|	РеализацияТоваровУслуг.Дата КАК ДатаНакладной,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваровУслугТовары.НомерСтроки) КАК КоличествоМест
	|ИЗ
	|	Документ.ТранспортнаяНакладная КАК ТранспортнаяНакладная
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортнаяНакладная.ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
	|			ПОЛНОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|				ПОЛНОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ДокументЗаказКлиента
	|					ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|						ПО ЗаказКлиентаТовары.Номенклатура = СправочникНоменклатура.Ссылка
	|					ПО ДокументЗаказКлиента.Ссылка = ЗаказКлиентаТовары.Ссылка
	|				ПО РеализацияТоваровУслуг.ЗаказКлиента = ДокументЗаказКлиента.Ссылка
	|				ПРАВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|				ПО РеализацияТоваровУслугТовары.Ссылка = РеализацияТоваровУслуг.Ссылка
	|			ПО ТранспортнаяНакладнаяДокументыОснования.ДокументОснование.Ссылка = РеализацияТоваровУслуг.Ссылка
	|		ПО ТранспортнаяНакладная.Ссылка = ТранспортнаяНакладнаяДокументыОснования.Ссылка
	|ГДЕ
	|	ТранспортнаяНакладная.Ссылка = &Документ
	|	И ЗаказКлиентаТовары.НомерСтроки = 1
	|
	|СГРУППИРОВАТЬ ПО
	|	ТранспортнаяНакладная.Номер,
	|	ТранспортнаяНакладная.Дата,
	|	РеализацияТоваровУслуг.Склад,
	|	ТранспортнаяНакладная.Грузополучатель,
	|	ТранспортнаяНакладная.Водитель,
	|	ТранспортнаяНакладная.КАНАТ_ФИОСопроводителя,
	|	ТранспортнаяНакладная.АвтомобильГосударственныйНомер,
	|	СправочникНоменклатура.ГруппаФинансовогоУчета,
	|	РеализацияТоваровУслуг.Номер,
	|	РеализацияТоваровУслуг.Дата";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
