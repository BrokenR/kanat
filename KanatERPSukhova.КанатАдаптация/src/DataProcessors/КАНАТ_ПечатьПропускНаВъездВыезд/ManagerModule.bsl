//++ Гурьев 25.09.23 ЧТЗ_2.10
Функция СформироватьПропускНаВъезд(Документ)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТ_ПечатьПропускНаВъездВыезд.ПФ_MXL_ПечатьПропускНаВъезд");
	
	///Шапка
	ДанныеШапки = ПолучитьДанныеШапкиПропускНаВъезд(Документ);
	Если ДанныеШапки = Неопределено Тогда
		Возврат ТабличныйДокумент;
	КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьШапка.Параметры.Заполнить(ДанныеШапки);
	ОбластьШапка.Параметры.Дата = Формат(ДанныеШапки.Дата, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.Номер = ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ДанныеШапки.Номер);
	
	Если ДанныеШапки.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента
		ИЛИ ДанныеШапки.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу Тогда
		
		ОбластьШапка.Параметры.Водитель = ДанныеШапки.КАНАТ_ВодительСсылка;
		
	КонецЕсли;
	
		
	Если ДанныеШапки.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу Тогда
		
		ОбластьШапка.Параметры.СпособДоставки = СтрШаблон("%1, %2, %3",
														  ДанныеШапки.СпособДоставки,
														  ДанныеШапки.Перевозчик,
														  ДанныеШапки.АдресПеревозчика);
		
	КонецЕсли;
	
	//Если Не ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
	//	ОбластьШапка.Параметры.Грузополучатель = ДанныеШапки.Контрагент;
	//КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	//Таблица
	ОбластьТаблицаШапка = Макет.ПолучитьОбласть("ОбластьТаблицаШапка");
	ТабличныйДокумент.Вывести(ОбластьТаблицаШапка);
	
	ТаблицаИтого = Новый ТабличныйДокумент;
	
	ДанныеТаблицыВыборкаЕдИзм = ПолучитьДанныеТаблицыПропускНаВъезд(Документ);
	
	Сумма = 0;
	СуммаСНДС = 0;
	СуммаСоСкидкой = 0;
	
	Пока ДанныеТаблицыВыборкаЕдИзм.Следующий() Цикл
		
		ОбластьТаблицаИтогоСтрока = Макет.ПолучитьОбласть("ОбластьТаблицаИтогоСтрока");
		ОбластьТаблицаИтогоСтрока.Параметры.Заполнить(ДанныеТаблицыВыборкаЕдИзм);
		ТаблицаИтого.Вывести(ОбластьТаблицаИтогоСтрока);
		
		ВыборкаДетальныеЗаписи = ДанныеТаблицыВыборкаЕдИзм.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ОбластьТаблицаСтрока = Макет.ПолучитьОбласть("ОбластьТаблицаСтрока");
			ОбластьТаблицаСтрока.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
			
			ТабличныйДокумент.Вывести(ОбластьТаблицаСтрока);
			
			Сумма =     Сумма + ВыборкаДетальныеЗаписи.Количество * ВыборкаДетальныеЗаписи.Цена;
			СуммаСНДС = СуммаСНДС + ВыборкаДетальныеЗаписи.Количество * ВыборкаДетальныеЗаписи.ЦенаСНДС;
			СуммаСоСкидкой = СуммаСоСкидкой + ВыборкаДетальныеЗаписи.СуммаСоСкидкой;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОбластьТаблицаИтогоШапка = Макет.ПолучитьОбласть("ОбластьТаблицаИтогоШапка");
	ТабличныйДокумент.Вывести(ОбластьТаблицаИтогоШапка);
	
	ТабличныйДокумент.Вывести(ТаблицаИтого);
	
	//Подвал
	ОбластьТаблицаПодвал = Макет.ПолучитьОбласть("ОбластьТаблицаПодвал");
	ОбластьТаблицаПодвал.Параметры.Сумма = Формат(Сумма, "ЧДЦ=2");
	ОбластьТаблицаПодвал.Параметры.СуммаНДС = Формат(СуммаСНДС - Сумма, "ЧДЦ=2");
	ОбластьТаблицаПодвал.Параметры.СуммаСНДС = Формат(СуммаСНДС, "ЧДЦ=2");
	ОбластьТаблицаПодвал.Параметры.СуммаСоСкидкой = Формат(СуммаСоСкидкой, "ЧДЦ=2");
	ТабличныйДокумент.Вывести(ОбластьТаблицаПодвал);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
	
КонецФункции
