//++ Гурьев 26.09.23 ЧТЗ_2.10
Функция СформироватьПропускНаВыезд(Документ)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Ложь;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТ_ПечатьПропускНаВъездВыезд.ПФ_MXL_ПечатьПропускНаВыезд");
	ДанныеПФ = ПолучитьДанныеПФПропускНаВыезд(Документ);
	Если ДанныеПФ.Количество() = 0 Тогда
		
		Сообщить("Не найдены документы ""Реализация товаров и услуг"" с заполненными документами ""Заказ клиента"", у которых есть товары.");
		Возврат ТабличныйДокумент;
		
	КонецЕсли;
	
	//Шапка
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьШапка.Параметры.Заполнить(ДанныеПФ[0]);
	ОбластьШапка.Параметры.Номер = ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ДанныеПФ[0].Номер);
	ОбластьШапка.Параметры.Дата = Формат(ДанныеПФ[0].Дата, "ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	//ТМЦ
	Для Каждого Строка Из ДанныеПФ Цикл
		
		ОбластьТМЦ = Макет.ПолучитьОбласть("ОбластьТМЦ");
		ОбластьТМЦ.Параметры.ТМЦ            = Строка.ТМЦ;
		ОбластьТМЦ.Параметры.НомерНакладной = ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(Строка.НомерНакладной);
		ОбластьТМЦ.Параметры.ДатаНакладной  = Формат(Строка.ДатаНакладной, "ДФ=dd.MM.yyyy");
		ОбластьТМЦ.Параметры.КоличествоМест = СтрШаблон("%1 (%2)", Строка.КоличествоМест,
																   ЧислоПрописью(Строка.КоличествоМест,, ",,,,,,,,0"));
		ТабличныйДокумент.Вывести(ОбластьТМЦ);
		
	КонецЦикла;
	
	//Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	ОбластьПодвал.Параметры.Заполнить(ДанныеПФ[0]);
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
	
КонецФункции
