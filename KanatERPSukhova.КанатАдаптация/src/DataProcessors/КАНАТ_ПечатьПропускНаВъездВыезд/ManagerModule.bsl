Функция ПолучитьДанныеТаблицыПропускНаВъезд(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СправочникНоменклатура.Артикул КАК Артикул,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Цена * (1 + КАНАТ_РаспоряжениеНаОтгрузкуТовары.СтавкаНДС.Ставка / 100) КАК ЦенаСНДС,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Номенклатура КАК Наименование,
				   //БИТ_Гурьев_мелкие замечания_22.05.24++
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Характеристика КАК Характеристика,
				   //БИТ_Гурьев_мелкие замечания_22.05.24--
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Упаковка КАК ЕдИзм,
	               |	СУММА(КАНАТ_РаспоряжениеНаОтгрузкуТовары.Количество) КАК Количество,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Цена КАК Цена,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.СтавкаНДС КАК НДС,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.СтавкаНДС.Ставка КАК СтавкаНДССтавка,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.КАНАТ_Сертификат КАК Сертификат,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.КАНАТ_КомментарийКЗаказу КАК Комментарий,
	               |	СУММА(КАНАТ_РаспоряжениеНаОтгрузкуТовары.СуммаСНДС) КАК СуммаСоСкидкой
	               |ИЗ
	               |	Документ.КАНАТ_РаспоряжениеНаОтгрузку.Товары КАК КАНАТ_РаспоряжениеНаОтгрузкуТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	               |		ПО КАНАТ_РаспоряжениеНаОтгрузкуТовары.Номенклатура = СправочникНоменклатура.Ссылка
	               |ГДЕ
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Ссылка = &Документ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СправочникНоменклатура.Артикул,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Номенклатура,
				   //БИТ_Гурьев_мелкие замечания_22.05.24++
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Характеристика,
				   //БИТ_Гурьев_мелкие замечания_22.05.24--
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Упаковка,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Цена,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.СтавкаНДС,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.СтавкаНДС.Ставка,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.КАНАТ_Сертификат,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.КАНАТ_КомментарийКЗаказу,
	               |	КАНАТ_РаспоряжениеНаОтгрузкуТовары.Цена * (1 + КАНАТ_РаспоряжениеНаОтгрузкуТовары.СтавкаНДС.Ставка / 100)
	               |ИТОГИ
	               |	СУММА(Количество)
	               |ПО
	               |	ЕдИзм";
					
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции
