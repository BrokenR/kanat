Функция ПолучитьДанныеПФПропускНаВыезд(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КАНАТ_ПропускНаВыезд.Номер КАК Номер,
	               |	КАНАТ_ПропускНаВыезд.Дата КАК Дата,
	               |	КАНАТ_ПропускНаВыезд.Организация КАК Организация,
	               |	КАНАТ_ПропускНаВыезд.Подразделение КАК НаименованиеПодразделения,
	               |	КАНАТ_ПропускНаВыезд.ФИОСопроводителя КАК ФИОСопроводителя,
	               |	КАНАТ_ПропускНаВыезд.Водитель КАК Водитель,
	               |	КАНАТ_ПропускНаВыезд.Марка + "" "" + КАНАТ_ПропускНаВыезд.ГосНомер КАК Автотранспорт,
	               |	КАНАТ_ПропускНаВыезд.ТМЦ КАК ТМЦ,
	               |	СчетФактураВыданный.Номер КАК НомерНакладной,
	               |	СчетФактураВыданный.Дата КАК ДатаНакладной,
	               |	КАНАТ_ПропускНаВыезд.КоличествоМест КАК КоличествоМест,
	               |	КАНАТ_ПропускНаВыезд.ПодписантДолжность КАК ДолжностьПодпись,
	               |	КАНАТ_ПропускНаВыезд.ПодписантСотрудник КАК ИмяПодпись,
	               |	КАНАТ_ПропускНаВыезд.Грузополучатель КАК НаименованиеОрганизацииГрузополучателя,
	               |	КАНАТ_ПропускНаВыезд.Грузополучатель.НаименованиеПолное КАК СокрГрузополучатель
	               |ИЗ
	               |	Документ.КАНАТ_ПропускНаВыезд КАК КАНАТ_ПропускНаВыезд
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |			ПО РеализацияТоваровУслуг.Ссылка = СчетФактураВыданный.ДокументОснование
	               |		ПО КАНАТ_ПропускНаВыезд.ДокументОснование = РеализацияТоваровУслуг.Ссылка
	               |ГДЕ
	               |	КАНАТ_ПропускНаВыезд.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
