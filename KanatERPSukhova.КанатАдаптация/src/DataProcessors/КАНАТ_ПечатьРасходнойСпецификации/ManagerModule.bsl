//++ Гурьев 07.09.23 Получение данных печати
Функция ПолучитьДанныеПечати(ПараметрыДанныхПечати)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|	ВЫБРАТЬ
	|		РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
	|		РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|		РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия КАК Серия,
	|		РасходныйОрдерНаТоварыОтгружаемыеТовары.Характеристика КАК Характеристика,
	|		РасходныйОрдерНаТоварыОтгружаемыеТовары.Количество КАК Количество
	|	ИЗ
	|		Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
	|	ГДЕ
	|		РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка = &РасходныйОрдерСсылка
	|		И РасходныйОрдерНаТоварыОтгружаемыеТовары.УпаковочныйЛист = ЗНАЧЕНИЕ(Документ.УпаковочныйЛист.ПустаяСсылка)
	|	УПОРЯДОЧИТЬ ПО
	|		РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия
	|	ИТОГИ
	|		СУММА(Количество),
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Серия)
	|		
	|	ПО
	|		НоменклатураНаименование,
	|		Характеристика,
	|		НоменклатураЕдиницаИзмерения";
	
	Запрос.УстановитьПараметр("РасходныйОрдерСсылка", ПараметрыДанныхПечати.РасходныйОрдер);
	
	Возврат Запрос.Выполнить();
	
КонецФункции
//-- Гурьев 07.09.23
