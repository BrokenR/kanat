//Формирует печатную форму по реквизиту НазваниеПФ
//Сначала получаются области из нужной печатной формы, дальше получаются данные ПФ
//Т.к. печатные формы схожи, данные получаются одинаковые для всех печатных форм (нек . данные могут быть лишними)
//Далее полученные области выводятся и заполняются из общих данных
Функция СформироватьПечатнуюФорму(Документ, НазваниеПФ)
	
	Табдок = Новый ТабличныйДокумент;
	Табдок.АвтоМасштаб = Истина;
	
	СтруктураОбластей = ПолучитьСтруктуруОбластей(НазваниеПФ, Табдок, Документ);
	//++Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КАНАТ_СертификатКачества") Тогда
	ДанныеПФ = получитьДанныеСертефикатаКачества(Документ);
	Иначе
	ДанныеПФ = ПолучитьДанныеПФ(Документ);	
	КонецЕсли;
	//--Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
	Если СтруктураОбластей.Свойство("ОбластьШапка") Тогда
		
		СтруктураОбластей.ОбластьШапка.Параметры.Заполнить(ДанныеПФ);
		Табдок.Вывести(СтруктураОбластей.ОбластьШапка);
		
	КонецЕсли;
	
	Если СтруктураОбластей.Свойство("ОбластьТаблицаШапка") Тогда
		
		СтруктураОбластей.ОбластьТаблицаШапка.Параметры.Заполнить(ДанныеПФ);
		Табдок.Вывести(СтруктураОбластей.ОбластьТаблицаШапка);
		
	КонецЕсли;
	
	Если СтруктураОбластей.Свойство("ОбластьТаблицаСтрока") Тогда
		//++Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.КАНАТ_СертификатКачества") Тогда
		ЗаполнитьВывестиТаблицуПоказателейСертефикатКачества(Табдок, СтруктураОбластей.ОбластьТаблицаСтрока, Документ);	
		Иначе
		ЗаполнитьВывестиТаблицуПоказателей(Табдок, СтруктураОбластей.ОбластьТаблицаСтрока, Документ);
		конецЕсли;
		//--Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
	КонецЕсли;
	
	Если СтруктураОбластей.Свойство("ОбластьТаблицаСырье") Тогда
		
		СтруктураОбластей.ОбластьТаблицаСырье.Параметры.Заполнить(ДанныеПФ);
		Табдок.Вывести(СтруктураОбластей.ОбластьТаблицаСырье);
		
	КонецЕсли;
	
	Если СтруктураОбластей.Свойство("ОбластьТаблицаПодвал") Тогда
		
		СтруктураОбластей.ОбластьТаблицаПодвал.Параметры.Заполнить(ДанныеПФ);
		Табдок.Вывести(СтруктураОбластей.ОбластьТаблицаПодвал);
		
	КонецЕсли;
	
	Если СтруктураОбластей.Свойство("ОбластьПодвал") Тогда
		
		СтруктураОбластей.ОбластьПодвал.Параметры.Заполнить(ДанныеПФ);
		Табдок.Вывести(СтруктураОбластей.ОбластьПодвал);
		
	КонецЕсли;
	Возврат Табдок;
	
КонецФункции
