//++Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка. 
функция получитьДанныеСертефикатаКачества(Документ)
	ДанныеПФ = Новый Структура;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КАНАТ_СертификатКачества.Номер КАК Номер,
		|	КАНАТ_СертификатКачества.Дата КАК Дата,
		|	КАНАТ_РезультатИспытаний.Цех КАК Цех,
		|	КАНАТ_ЛицаПодписывающиеЗаПодразделения.РольРуководителя КАК РольРуководителя,
		|	КАНАТ_ЛицаПодписывающиеЗаПодразделения.Сотрудник.Наименование КАК Сотрудник,
		|	Номенклатура.НаименованиеПолное КАК ПродукцияПолноеНаименование,
		|	КАНАТ_РезультатИспытаний.ПартияГотовойПродукции КАК Партия,
		|	КАНАТ_СертификатКачества.НомерБухты КАК НомерБухты,
		|	КАНАТ_РезультатИспытаний.Температура КАК Температура,
		|	КАНАТ_РезультатИспытаний.ВлажностьФакт КАК ВлажностьФакт,
		|	КАНАТ_РезультатИспытаний.ПрограммаИМетодикаИспытаний КАК ПрограммаИспытаний,
		|	Номенклатура.Код КАК ПродукцияКод,
		|	Номенклатура.НаименованиеПолное КАК ПродукцияНаименование,
		|	КАНАТ_РезультатИспытаний.Оборудование КАК Оборудование,
		|	КАНАТ_РезультатИспытаний.ЗаправочныеПараметры КАК ЗаправочныеПараметры,
		|	КАНАТ_РезультатИспытаний.Структура КАК Структура,
		|	КАНАТ_РезультатИспытаний.Результат КАК Результат,
		|	КАНАТ_СертификатКачества.ДатаИзготовленияГотовойПродукции КАК ДатаИзготовления,
		|	КАНАТ_СертификатКачества.МассаБухты КАК МассаПартии,
		|	КАНАТ_РезультатИспытаний.Сорт КАК СортПеч,
		|	КАНАТ_СертификатКачества.НомерСертификатаКачества КАК НомСертификатаКачества,
		|	КАНАТ_РезультатИспытаний.СырьеДляПечатнойФормы КАК Сырье,
		|	Номенклатура.Описание КАК ТекстовоеОписание
		|ИЗ
		|	Документ.КАНАТ_СертификатКачества КАК КАНАТ_СертификатКачества
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО КАНАТ_СертификатКачества.Продукция = Номенклатура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КАНАТ_РезультатИспытаний КАК КАНАТ_РезультатИспытаний
		|		ПО КАНАТ_СертификатКачества.ДокументОснования = КАНАТ_РезультатИспытаний.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КАНАТ_ЛицаПодписывающиеЗаПодразделения КАК КАНАТ_ЛицаПодписывающиеЗаПодразделения
		|		ПО (КАНАТ_ЛицаПодписывающиеЗаПодразделения.ДатаНачала <= КАНАТ_СертификатКачества.Дата)
		|			И (КАНАТ_ЛицаПодписывающиеЗаПодразделения.ДатаОкончания > КАНАТ_СертификатКачества.Дата)
		|ГДЕ
		|	КАНАТ_СертификатКачества.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Регистр КАК Регистр,
		|	ВложенныйЗапрос.ДатаОдобрения КАК ДатаОдобрения,
		|	КАНАТ_НТДНоменклатурыСписокСертификатов.Свидетельство КАК Свидетельство,
		|	ВложенныйЗапрос.Регистр.Наименование КАК РегистрНаименование
		|ИЗ
		|	(ВЫБРАТЬ
		|		КАНАТ_НТДНоменклатурыСписокСертификатов.Регистр КАК Регистр,
		|		МАКСИМУМ(КАНАТ_НТДНоменклатурыСписокСертификатов.ДатаОдобрения) КАК ДатаОдобрения
		|	ИЗ
		|		Документ.КАНАТ_СертификатКачества КАК КАНАТ_СертификатКачества
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.КАНАТ_РезультатИспытаний КАК КАНАТ_РезультатИспытаний
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КАНАТ_НТДНоменклатуры.СписокСертификатов КАК КАНАТ_НТДНоменклатурыСписокСертификатов
		|				ПО КАНАТ_РезультатИспытаний.НТДПродукции = КАНАТ_НТДНоменклатурыСписокСертификатов.Ссылка
		|			ПО КАНАТ_СертификатКачества.ДокументОснования = КАНАТ_РезультатИспытаний.Ссылка
		|	ГДЕ
		|		КАНАТ_НТДНоменклатурыСписокСертификатов.ДатаОдобрения <= КАНАТ_РезультатИспытаний.Дата
		|	
		|	СГРУППИРОВАТЬ ПО
		|		КАНАТ_НТДНоменклатурыСписокСертификатов.Регистр) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КАНАТ_НТДНоменклатуры.СписокСертификатов КАК КАНАТ_НТДНоменклатурыСписокСертификатов
		|		ПО ВложенныйЗапрос.Регистр = КАНАТ_НТДНоменклатурыСписокСертификатов.Регистр
		|			И ВложенныйЗапрос.ДатаОдобрения = КАНАТ_НТДНоменклатурыСписокСертификатов.ДатаОдобрения";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаДанныеПФ = РезультатЗапроса[0].Выбрать();
	ДанныеШапкиЗаполнены = Ложь;	
	Пока ВыборкаДанныеПФ.Следующий() Цикл	
		Если Не ДанныеШапкиЗаполнены Тогда	
			ДанныеПФ.Вставить("Номер",
							  ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ВыборкаДанныеПФ.Номер));
			ДанныеПФ.Вставить("НомСертификатаКачества",
							  ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(Формат(ВыборкаДанныеПФ.НомСертификатаКачества, "ЧГ=0")));
			ДанныеПФ.Вставить("Дата",                        Формат(ВыборкаДанныеПФ.Дата, "ДФ=dd.MM.yyyy"));
			ДанныеПФ.Вставить("ДатаИзготовления",            Формат(ВыборкаДанныеПФ.ДатаИзготовления, "ДФ='MMММ yyyy'"));
			ДанныеПФ.Вставить("Цех",                         ВыборкаДанныеПФ.Цех);
			
			//++Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
			//ДанныеПФ.Вставить("ПродукцияПолноеНаименование", ВыборкаДанныеПФ.ПродукцияПолноеНаименование);
			Если не  ЗначениеЗаполнено(ВыборкаДанныеПФ.ТекстовоеОписание) Тогда
			ДанныеПФ.Вставить("ПродукцияПолноеНаименование", ВыборкаДанныеПФ.ПродукцияПолноеНаименование);	
			ДанныеПФ.Вставить("ПродукцияНаименование",       ВыборкаДанныеПФ.ПродукцияНаименование);	
			Иначе
			ДанныеПФ.Вставить("ПродукцияПолноеНаименование", ВыборкаДанныеПФ.ТекстовоеОписание);	
			ДанныеПФ.Вставить("ПродукцияНаименование",       ВыборкаДанныеПФ.ТекстовоеОписание);		
			 конецЕсли;
			//--Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
			
			ДанныеПФ.Вставить("Партия",                      ВыборкаДанныеПФ.Партия);
			ДанныеПФ.Вставить("НомерБухты",                  ВыборкаДанныеПФ.НомерБухты);
			ДанныеПФ.Вставить("Температура",                 ВыборкаДанныеПФ.Температура);
			ДанныеПФ.Вставить("ВлажностьФакт",               ВыборкаДанныеПФ.ВлажностьФакт);
			ДанныеПФ.Вставить("ПрограммаИспытаний",          ВыборкаДанныеПФ.ПрограммаИспытаний);
			ДанныеПФ.Вставить("ПродукцияКод",                ВыборкаДанныеПФ.ПродукцияКод);
			
			//++Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.	
			//ДанныеПФ.Вставить("ПродукцияНаименование",       ВыборкаДанныеПФ.ПродукцияНаименование);
			
			
			//--Бит Трейгер П.М. 19.12.2024 Блок Качества. Переделка.
			
			ДанныеПФ.Вставить("Оборудование",                ВыборкаДанныеПФ.Оборудование);
			ДанныеПФ.Вставить("ЗаправочныеПараметры",        ВыборкаДанныеПФ.ЗаправочныеПараметры);
			ДанныеПФ.Вставить("Структура",                   ВыборкаДанныеПФ.Структура);
			ДанныеПФ.Вставить("МассаПартии",                 ВыборкаДанныеПФ.МассаПартии);
			ДанныеПФ.Вставить("СортПеч",                     ВыборкаДанныеПФ.СортПеч);
			ДанныеПФ.Вставить("Сырье",                       ВыборкаДанныеПФ.Сырье);
			Если ЗначениеЗаполнено(ВыборкаДанныеПФ.Результат) Тогда
				ДанныеПФ.Вставить("Результат",ВРег(Лев(ВыборкаДанныеПФ.Результат, 1)) + Прав(ВыборкаДанныеПФ.Результат, СтрДлина(ВыборкаДанныеПФ.Результат) - 1));
			КонецЕсли;
			
			ДанныеШапкиЗаполнены = Истина;
			
		КонецЕсли;
		
	   		Если ВыборкаДанныеПФ.РольРуководителя = Перечисления.КАНАТ_РолиПодписантов.РуководительЛаборатории Тогда
			
			Попытка
				ДанныеПФ.Вставить("ЛабораторияРуководитель", ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеПФ.Сотрудник));
			Исключение
				ДанныеПФ.Вставить("ЛабораторияРуководитель", ВыборкаДанныеПФ.Сотрудник);
			КонецПопытки;

		ИначеЕсли ВыборкаДанныеПФ.РольРуководителя = Перечисления.КАНАТ_РолиПодписантов.РуководительОУКП Тогда
			
			Попытка
				ДанныеПФ.Вставить("ОУКПРуководитель",        ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеПФ.Сотрудник));
			Исключение
				ДанныеПФ.Вставить("ОУКПРуководитель", ВыборкаДанныеПФ.Сотрудник);
			КонецПопытки;

		ИначеЕсли ВыборкаДанныеПФ.РольРуководителя = Перечисления.КАНАТ_РолиПодписантов.РуководительТехОтдела Тогда
			
			Попытка
				ДанныеПФ.Вставить("ТехОтделРуководитель",    ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеПФ.Сотрудник));
			Исключение
				ДанныеПФ.Вставить("ТехОтделРуководитель", ВыборкаДанныеПФ.Сотрудник);
			КонецПопытки;
			
		ИначеЕсли ВыборкаДанныеПФ.РольРуководителя = Перечисления.КАНАТ_РолиПодписантов.ТехникЛаборант Тогда
			
			Попытка
				ДанныеПФ.Вставить("ТехникЛаборант",    ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВыборкаДанныеПФ.Сотрудник));
			Исключение
				ДанныеПФ.Вставить("ТехникЛаборант", ВыборкаДанныеПФ.Сотрудник);
			КонецПопытки;


		КонецЕсли;
		
	КонецЦикла;
	//	
	////Данные о сертификатах
	ВыборкаСертификаты = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаСертификаты.Следующий() Цикл
		
		Если ВыборкаСертификаты.РегистрНаименование = "МЧС" Тогда
			
			ДанныеПФ.Вставить("НомерСертификатаМЧС", ВыборкаСертификаты.Свидетельство);
			
		ИначеЕсли ВыборкаСертификаты.РегистрНаименование = "РКО" Тогда
			
			ДанныеПФ.Вставить("НомерСП", ВыборкаСертификаты.Свидетельство);
			ДанныеПФ.Вставить("ДатаСП",  Формат(ВыборкаСертификаты.ДатаОдобрения, "ДФ=dd.MM.yyyy"));
			
		ИначеЕсли ВыборкаСертификаты.РегистрНаименование = "РМРС" Тогда
			
			ДанныеПФ.Вставить("НомерСТО", ВыборкаСертификаты.Свидетельство);
			ДанныеПФ.Вставить("ДатаСТО",  Формат(ВыборкаСертификаты.ДатаОдобрения, "ДФ=dd.MM.yyyy"));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка 
		ДанныеПФ.Вставить("Автор", ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПользователиКлиентСервер.ТекущийПользователь()));
	Исключение
		ДанныеПФ.Вставить("Автор", ПользователиКлиентСервер.ТекущийПользователь());
	КонецПопытки;
	ДанныеПФ.Вставить("КолБухт", ?(ДанныеПФ.МассаПартии = 0, 0, 1));
	
	Возврат ДанныеПФ;

	
конецФункции

Процедура ЗаполнитьВывестиТаблицуПоказателейСертефикатКачества(Табдок, Область, Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КАНАТ_СертификатКачестваРезультатИспытаний.Показатель КАК ПоказательНаименование,
	               |	КАНАТ_СертификатКачестваРезультатИспытаний.ЕдИзм КАК ЕдИзмНаименование,
	               |	КАНАТ_СертификатКачестваРезультатИспытаний.Норма КАК Норма,
	               |	КАНАТ_СертификатКачестваРезультатИспытаний.ДопустимоеОтклонение КАК ДопустимоеОтклонение,
	               |	КАНАТ_СертификатКачестваРезультатИспытаний.Факт КАК Факт
	               |ИЗ
	               |	Документ.КАНАТ_СертификатКачества.РезультатИспытаний КАК КАНАТ_СертификатКачестваРезультатИспытаний
	               |ГДЕ
	               |	КАНАТ_СертификатКачестваРезультатИспытаний.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Область.Параметры.Заполнить(Выборка);
		Табдок.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры


