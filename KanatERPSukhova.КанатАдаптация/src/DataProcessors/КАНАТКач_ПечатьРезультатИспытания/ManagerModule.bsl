Процедура ЗаполнитьВывестиТаблицуПоказателей(Табдок, Область, Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КАНАТ_РезультатИспытанийРезультатИспытаний.Показатель КАК ПоказательНаименование,
	               |	КАНАТ_РезультатИспытанийРезультатИспытаний.ЕдИзм КАК ЕдИзмНаименование,
	               |	КАНАТ_РезультатИспытанийРезультатИспытаний.Норма КАК Норма,
	               |	КАНАТ_РезультатИспытанийРезультатИспытаний.ДопустимоеОтклонение КАК ДопустимоеОтклонение,
	               |	КАНАТ_РезультатИспытанийРезультатИспытаний.Факт КАК Факт
	               |ИЗ
	               |	Документ.КАНАТ_РезультатИспытаний.РезультатИспытаний КАК КАНАТ_РезультатИспытанийРезультатИспытаний
	               |ГДЕ
	               |	КАНАТ_РезультатИспытанийРезультатИспытаний.Ссылка = &Ссылка
	               |	И КАНАТ_РезультатИспытанийРезультатИспытаний.ВыводитьВПФ = ИСТИНА";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Область.Параметры.Заполнить(Выборка);
		Табдок.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры
