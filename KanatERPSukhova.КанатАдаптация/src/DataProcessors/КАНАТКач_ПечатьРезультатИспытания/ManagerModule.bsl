//++ Гурьев 11.10.23 ЧТЗ_К3
Функция ПолучитьСтруктуруОбластей(НазваниеПФ, Табдок, Документ)
	
	СтруктураОбластей = Новый Структура;
	
	Если НазваниеПФ = "ПротоколРезультатовИспытаний" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТКач_ПечатьРезультатИспытания.ПФ_MXL_ПротоколРезультатовИспытаний");
		
		СтруктураОбластей.Вставить("ОбластьШапка",         Макет.ПолучитьОбласть("ОбластьШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаШапка",  Макет.ПолучитьОбласть("ОбластьТаблицаШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаСтрока", Макет.ПолучитьОбласть("ОбластьТаблицаСтрока"));
		СтруктураОбластей.Вставить("ОбластьПодвал",        Макет.ПолучитьОбласть("ОбластьПодвал"));
		
		Табдок.ПолеСлева  = 15;
		Табдок.ПолеСправа = 15;
		
	ИначеЕсли НазваниеПФ = "ПротоколРезультатовИспытанийДляМорскогоРегистра" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТКач_ПечатьРезультатИспытания.ПФ_MXL_ПротоколРезультатовИспытанийДляМорскогоРегистра");
		
		СтруктураОбластей.Вставить("ОбластьШапка",         Макет.ПолучитьОбласть("ОбластьШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаШапка",  Макет.ПолучитьОбласть("ОбластьТаблицаШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаСтрока", Макет.ПолучитьОбласть("ОбластьТаблицаСтрока"));
		СтруктураОбластей.Вставить("ОбластьПодвал",        Макет.ПолучитьОбласть("ОбластьПодвал"));
		
		Табдок.ПолеСлева  = 15;
		Табдок.ПолеСправа = 15;
		
	ИначеЕсли НазваниеПФ = "АктОтбораОбразцов" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТКач_ПечатьРезультатИспытания.ПФ_MXL_АктОтбораОбразцов");
		
		СтруктураОбластей.Вставить("ОбластьШапка",         Макет.ПолучитьОбласть("ОбластьШапка"));
		СтруктураОбластей.Вставить("ОбластьПодвал",        Макет.ПолучитьОбласть("ОбластьПодвал"));
		
		Табдок.ПолеСверху = 15;
		Табдок.ПолеСлева  = 20;
		Табдок.ПолеСправа = 20;
		
	ИначеЕсли НазваниеПФ = "СертификатКачества" Тогда
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.КАНАТ_РезультатИспытаний") 
			И Документ.ВидГотовойПродукцииИспытания.Наименование = "Сетематериалы" Тогда
			
			Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТКач_ПечатьРезультатИспытания.ПФ_MXL_СертификатКачестваСетематериалы"); 
			
		Иначе
			
			Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТКач_ПечатьРезультатИспытания.ПФ_MXL_СертификатКачества");
			
		КонецЕсли;
		
		СтруктураОбластей.Вставить("ОбластьШапка",         Макет.ПолучитьОбласть("ОбластьШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаШапка",  Макет.ПолучитьОбласть("ОбластьТаблицаШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаСтрока", Макет.ПолучитьОбласть("ОбластьТаблицаСтрока"));
		СтруктураОбластей.Вставить("ОбластьТаблицаПодвал", Макет.ПолучитьОбласть("ОбластьТаблицаПодвал"));
		СтруктураОбластей.Вставить("ОбластьПодвал",        Макет.ПолучитьОбласть("ОбластьПодвал"));
		
		Табдок.ПолеСлева  = 15;
		Табдок.ПолеСправа = 15;
		Табдок.ПолеСверху = 0;
		Табдок.ПолеСнизу = 0;
		Табдок.КоличествоЭкземпляров = 2;
		Табдок.ЭкземпляровНаСтранице = 2;
		
	ИначеЕсли НазваниеПФ = "СертификатКачестваМЧС" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТКач_ПечатьРезультатИспытания.ПФ_MXL_СертификатКачестваМЧС");
		
		СтруктураОбластей.Вставить("ОбластьШапка",         Макет.ПолучитьОбласть("ОбластьШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаШапка",  Макет.ПолучитьОбласть("ОбластьТаблицаШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаСтрока", Макет.ПолучитьОбласть("ОбластьТаблицаСтрока"));
		СтруктураОбластей.Вставить("ОбластьТаблицаСырье",  Макет.ПолучитьОбласть("ОбластьТаблицаСырье"));
		СтруктураОбластей.Вставить("ОбластьТаблицаПодвал", Макет.ПолучитьОбласть("ОбластьТаблицаПодвал"));
		СтруктураОбластей.Вставить("ОбластьПодвал",        Макет.ПолучитьОбласть("ОбластьПодвал"));
		
		Табдок.ПолеСлева  = 15;
		Табдок.ПолеСправа = 15;
		
	ИначеЕсли НазваниеПФ = "СертификатКачестваБезМЧС" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.КАНАТКач_ПечатьРезультатИспытания.ПФ_MXL_СертификатКачестваБезМЧС");
		
		СтруктураОбластей.Вставить("ОбластьШапка",         Макет.ПолучитьОбласть("ОбластьШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаШапка",  Макет.ПолучитьОбласть("ОбластьТаблицаШапка"));
		СтруктураОбластей.Вставить("ОбластьТаблицаСтрока", Макет.ПолучитьОбласть("ОбластьТаблицаСтрока"));
