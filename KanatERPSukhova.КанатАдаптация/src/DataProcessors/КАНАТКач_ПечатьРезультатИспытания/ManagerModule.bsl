Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Для Каждого Документ Из МассивОбъектов Цикл
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПротоколРезультатовИспытаний") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"ПротоколРезультатовИспытаний",
				"Протокол результатов испытаний",
				СформироватьПечатнуюФорму(Документ, "ПротоколРезультатовИспытаний"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПротоколРезультатовИспытанийДляМорскогоРегистра") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"ПротоколРезультатовИспытанийДляМорскогоРегистра",
				"Протокол результатов испытаний для морского регистра",
				СформироватьПечатнуюФорму(Документ, "ПротоколРезультатовИспытанийДляМорскогоРегистра"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОтбораОбразцов") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"АктОтбораОбразцов",
				"Акт отбора образцов",
				СформироватьПечатнуюФорму(Документ, "АктОтбораОбразцов"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СертификатКачества") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"СертификатКачества",
				"Сертификат качества",
				СформироватьПечатнуюФорму(Документ, "СертификатКачества"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СертификатКачестваМЧС") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"СертификатКачестваМЧС",
				"Сертификат качества Страховочно-Спасательного со знаком МЧС",
				СформироватьПечатнуюФорму(Документ, "СертификатКачестваМЧС"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СертификатКачестваБезМЧС") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"СертификатКачестваБезМЧС",
				"Сертификат качества Страховочно-Спасательного без знака МЧС",
				СформироватьПечатнуюФорму(Документ, "СертификатКачестваБезМЧС"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СертификатКачестваРМРС") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"СертификатКачестваРМРС",
				"Сертификат качества для Российского Морского Регистра Судоходства",
				СформироватьПечатнуюФорму(Документ, "СертификатКачестваРМРС"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СертификатКачестваРРР") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"СертификатКачестваРРР",
				"Сертификат качества для Речного Регистра (РРР)",
				СформироватьПечатнуюФорму(Документ, "СертификатКачестваРРР"));
		КонецЕсли;
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СертификатКачестваРКО") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"СертификатКачестваРКО",
				"Сертификат качества для Российского Классификационного Общества (РКО)",
				СформироватьПечатнуюФорму(Документ, "СертификатКачестваРКО"));
			КонецЕсли;
			
			//++Бит Трейгер П.М. 24.12.2024 Блок Качества. Переделка. 
			Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "МорскойРегистрСудоходства") Тогда
			СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"МорскойРегистрСудоходства",
				"Морской Регистр Судоходства",
				СформироватьПечатнуюФорму(Документ, "МорскойРегистрСудоходства"));
		    КонецЕсли;
		    //--Бит Трейгер П.М. 24.12.2024 Блок Качества. Переделка.
		
	КонецЦикла;
	ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	
КонецПроцедуры
