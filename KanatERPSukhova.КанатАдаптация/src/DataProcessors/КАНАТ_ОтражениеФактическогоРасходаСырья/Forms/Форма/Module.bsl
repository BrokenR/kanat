&НаСервере
Функция ПолучитьДанныеПоСпецификации(СсылкаСпецификация)
	
	Структура = Новый Структура;  
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура КАК Номенклатура,
		|	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура.Артикул КАК КодСырья
		|ИЗ
		|	Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК РесурсныеСпецификацииМатериалыИУслуги
		| Где РесурсныеСпецификацииМатериалыИУслуги.Ссылка = &СсылкаСпецификация";
	Запрос.УстановитьПараметр("СсылкаСпецификация",СсылкаСпецификация);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	Структура.Вставить("Сырье",ВыборкаДетальныеЗаписи.Номенклатура);
	Структура.Вставить("КодСырья",ВыборкаДетальныеЗаписи.КодСырья);
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

&НаСервере
Функция ПолучитьГруппуФинУчета()             
	
	//УстановитьПривилегированныйРежим(Истина);	
	//Возврат Константы.КАНАТ_ГруппаФинУчетаВспомогательноеСырье.Получить();
	//УстановитьПривилегированныйРежим(Ложь);	

		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГруппыФинансовогоУчетаНоменклатуры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыФинансовогоУчетаНоменклатуры КАК ГруппыФинансовогоУчетаНоменклатуры
		|ГДЕ
		|	ГруппыФинансовогоУчетаНоменклатуры.КАНАТ_ГруппаФинансовогоУчетаВспомогательногоСырья = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	
КонецФункции

&НаКлиенте
Процедура ДобавитьКЭтапу(Команда)   
    описаниеОповещения = Новый ОписаниеОповещения("ДобавитьКЭтапуЗавершение",ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("ГруппаФинУчета", ПолучитьГруппуФинУчета());
	ПараметрыОткрытия.Вставить("Склад", ПолучитьЦех(ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Элементы.ФактическийРасход.ТекущиеДанные.Этап,"Подразделение")));
	ПараметрыОткрытия.Вставить("ЗакрыватьПослеВыбора", Истина);
	
	ОткрытьФорму("Справочник.Номенклатура.Форма.КАНАТ_ФормаВыбораВспомогательногоСырья",
	ПараметрыОткрытия,
	ЭтотОбъект,,,,ОписаниеОповещения,
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
       
КонецПроцедуры    

