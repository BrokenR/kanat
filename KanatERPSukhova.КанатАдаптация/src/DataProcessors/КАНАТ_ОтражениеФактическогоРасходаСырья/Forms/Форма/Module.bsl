&НаКлиенте
Процедура ПерезаполнитьПоСпецификации(Команда)
		ПараметрыОткрытия = Новый Структура;
	
	
	ПараметрыОткрытия.Вставить("ГруппаФинУчета", ПолучитьГруппуФинУчета());	 
	ПараметрыОткрытия.Вставить("ЗакрыватьПослеВыбора", Истина);
	ОткрытьФорму("Справочник.РесурсныеСпецификации.ФормаВыбора",
	ПараметрыОткрытия,
	ЭтотОбъект,,,,,
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	
	ПерезаполнитьПоСпецификацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьУсловноеОформление();
КонецПроцедуры

&НаСервере
Функция ПолучитьЦех(ПодразделениеСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.Подразделение = &Подразделение
	|	И Склады.ЦеховаяКладовая = ИСТИНА";
	
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат ВыборкаДетальныеЗаписи.Ссылка;  
		
	Иначе 
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

