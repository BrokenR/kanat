&НаКлиенте
Процедура ФактическийРасходПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Копирование Тогда
		Элементы.ФактическийРасход.ТекущиеДанные.УдалитьСтроку = Ложь;
		Элементы.ФактическийРасход.ТекущиеДанные.ИзменитьСтроку = Истина;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		Элементы.ФактическийРасход.ТекущиеДанные.ОбеспечениеНомерСтроки = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходСырьеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;        
	
	ПараметрыОткрытия = Новый Структура;
	
	
	ПараметрыОткрытия.Вставить("ГруппаФинУчета", ПолучитьГруппуФинУчета());
	ПараметрыОткрытия.Вставить("Склад", ПолучитьЦех(ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Элементы.ФактическийРасход.ТекущиеДанные.Этап,"Подразделение")));
	ПараметрыОткрытия.Вставить("ЗакрыватьПослеВыбора", Истина);
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.Номенклатура.Форма.КАНАТ_ФормаВыбораВспомогательногоСырья",
	ПараметрыОткрытия,
	Элемент,,,,,
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры     

