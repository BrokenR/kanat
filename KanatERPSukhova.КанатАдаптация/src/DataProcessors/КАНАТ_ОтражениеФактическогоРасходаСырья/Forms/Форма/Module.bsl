&НаКлиенте
Процедура ДобавитьКЭтапуЗавершение(РезультатЗакрытия,ДополнительныеПараметры)   Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда  
		//Индекс = Элементы.ФактическийРасход.ТекущаяСтрока; 
		НоваяСтрока = ФактическийРасход.Добавить();    
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Элементы.ФактическийРасход.ТекущиеДанные,
		"ДатаПроизводства,	
		| ЕдиницаИзмеренияИзделия,	
		| Изделие,	
		| КодИзделия,	
		| КоличествоИзделия,	
		| КомментарийКЗаказу,	
		| Статус,	
		| ХарактеристикаИзделия,	
		| Этап,
		| СтатьяКалькуляции,
		| ДатаРасхода,
		|Спецификация");
		
		НоваяСтрока.Сырье = РезультатЗакрытия;
		НоваяСтрока.КодСырья = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(РезультатЗакрытия, "Артикул");    
		НоваяСтрока.СтатьяКалькуляции = ПолучитьСтатьюКалькуляции();
		НоваяСтрока.ИзменитьСтроку = Истина; 
		//ЭтаФорма.ТекущийЭлемент = Элементы.ФактическийРасход[Индекс].ФактРасхода;
		
	КонецЕсли;
	
КонецПроцедуры 	

