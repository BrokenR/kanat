	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.ПартияПроизводства.ОсновноеИзделиеНоменклатура,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.ПартияПроизводства.ОсновноеИзделиеНоменклатура.Артикул,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.ПартияПроизводства.ОсновноеИзделиеХарактеристика,
	|	ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.ПартияПроизводства.ОсновноеИзделиеНоменклатура.ЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Этап,
	|	Изделие,
	|	ОбеспечениеНомерСтроки";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);  
	
	Если ЗначениеЗаполнено(Подразделение) тогда
		СхемаЗапроса.ПакетЗапросов[2].Операторы[0].Отбор.Добавить("(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.Подразделение = &Подразделение)");
		Запрос.УстановитьПараметр("Подразделение", Подразделение);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтатусЭтапа) тогда
		СхемаЗапроса.ПакетЗапросов[2].Операторы[0].Отбор.Добавить("(ЭтапПроизводства2_2ОбеспечениеМатериаламиИРаботами.Ссылка.Статус В(&Статусы))");
		Запрос.УстановитьПараметр("Статусы", СтатусЭтапа);
	КонецЕсли;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	
	

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаТЧ = ФактическийРасход.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
	
