		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.СдвигОплетки);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.УдлинениеПодНагрузкой50150);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.УдлинениеПодНагрузкой80);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.МаксимальнаяСилаРывка03);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.МаксимальнаяСилаРывка177);
