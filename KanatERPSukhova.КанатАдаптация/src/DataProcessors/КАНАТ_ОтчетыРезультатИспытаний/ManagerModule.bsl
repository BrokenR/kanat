		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.НадежностьКрепленияКанатаL2);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.РазрывнаяНагрузка);
		
