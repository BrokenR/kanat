		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.РазрывнаяНагрузка);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.УдлинениеПриРазрыве);
		
	ИначеЕсли НазваниеОтчета = "ОтчетПоИспытаниямГотовойПродукцииСДатой" Тогда
		
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.ЛинейнаяПлотность);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.Диаметр);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.ЧислоВитковНа1м);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.РазрывнаяНагрузка);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.УдельнаяРазрывнаяНагрузка);
		
	ИначеЕсли НазваниеОтчета = "ОтчетНитиSisolСДатами" Тогда
		
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.НомЛинПлотностьНити);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.ФактЛинПлотностьНитиСР);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.ФактЛинПлотностьНитиMinMax);
