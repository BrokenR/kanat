		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.УдельнаяРазрывнаяНагрузка);
		
	ИначеЕсли НазваниеОтчета = "ОтчетКанатыДляЛазания" Тогда
		
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.Диаметр);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.ДлинаКаната);
