КонецФункции

Функция ДанныеДляОтчета(Параметры, НазваниеОтчета) Экспорт
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(Параметры, НазваниеОтчета);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КАНАТ_РезультатИспытаний.Продукция.Код КАК ПродукцияКод,
	               |	КАНАТ_РезультатИспытаний.Цех КАК Цех,
	               |	КАНАТ_РезультатИспытаний.Оборудование КАК Оборудование,
	               |	КАНАТ_РезультатИспытаний.Влажность КАК Влажность,
	               |	КАНАТ_РезультатИспытаний.Результат КАК Результат,
	               |	ВложенныйЗапрос.Факт КАК Факт,
	               |	ВложенныйЗапрос.ПараметрОтчетов КАК ПараметрОтчетов,
	               |	КАНАТ_РезультатИспытаний.Ссылка КАК Ссылка,
	               |	ВложенныйЗапрос.ЕдИзм КАК ЕдИзм,
	               |	НАЧАЛОПЕРИОДА(КАНАТ_РезультатИспытаний.Дата, ДЕНЬ) КАК Дата,
	               |	КАНАТ_РезультатИспытаний.Продукция.НаименованиеПолное КАК ПродукцияНаименование
	               |ИЗ
	               |	Документ.КАНАТ_РезультатИспытаний КАК КАНАТ_РезультатИспытаний
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КАНАТ_РезультатИспытанийРезультатИспытаний.Ссылка КАК Ссылка,
	               |			КАНАТ_РезультатИспытанийРезультатИспытаний.Факт КАК Факт,
	               |			КАНАТКач_СоответствиеПоказателейНТДКолонкамОтчетов.ПараметрОтчетов КАК ПараметрОтчетов,
	               |			КАНАТ_РезультатИспытанийРезультатИспытаний.ЕдИзм КАК ЕдИзм
	               |		ИЗ
	               |			Документ.КАНАТ_РезультатИспытаний.РезультатИспытаний КАК КАНАТ_РезультатИспытанийРезультатИспытаний
	               |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КАНАТКач_СоответствиеПоказателейНТДКолонкамОтчетов КАК КАНАТКач_СоответствиеПоказателейНТДКолонкамОтчетов
	               |				ПО КАНАТ_РезультатИспытанийРезультатИспытаний.Показатель = КАНАТКач_СоответствиеПоказателейНТДКолонкамОтчетов.Показатель
	               |		ГДЕ
	               |			КАНАТКач_СоответствиеПоказателейНТДКолонкамОтчетов.ПараметрОтчетов В(&МассивПараметров)
	               |			И КАНАТКач_СоответствиеПоказателейНТДКолонкамОтчетов.ВидДляОтчета В(&ВидДляОтчета)) КАК ВложенныйЗапрос
	               |		ПО КАНАТ_РезультатИспытаний.Ссылка = ВложенныйЗапрос.Ссылка
	               |ГДЕ
	               |	КАНАТ_РезультатИспытаний.Проведен = ИСТИНА";
	
	Если ПараметрыЗапроса.Свойство("Период") Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	И КАНАТ_РезультатИспытаний.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	КонецЕсли; 
	
	Если ПараметрыЗапроса.Свойство("Цех") Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	И КАНАТ_РезультатИспытаний.Цех = &Цех";
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗапроса.ВидДляОтчета) = Тип("Массив") Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	И КАНАТ_РезультатИспытаний.ВидГотовойПродукцииИспытания.ВидДляОтчета В (&ВидДляОтчета)";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата
	               |ИТОГИ
	               |	МАКСИМУМ(ПродукцияКод),
	               |	МАКСИМУМ(ПродукцияНаименование),
	               |	МАКСИМУМ(Цех),
	               |	МАКСИМУМ(Оборудование),
	               |	МАКСИМУМ(Влажность),
	               |	МАКСИМУМ(Результат)
	               |ПО  
	               |	Цех,
				   |	Дата,
	               |	Ссылка";
	
	Запрос.УстановитьПараметр("МассивПараметров", ПараметрыСтолбцов(НазваниеОтчета));
	Если ПараметрыЗапроса.Свойство("Период") Тогда
		Запрос.УстановитьПараметр("ДатаНачала", ПараметрыЗапроса.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ПараметрыЗапроса.Период.ДатаОкончания);
	КонецЕсли;
	Если ПараметрыЗапроса.Свойство("Цех") Тогда
		Запрос.УстановитьПараметр("Цех", ПараметрыЗапроса.Цех);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидДляОтчета", ПараметрыЗапроса.ВидДляОтчета);

	
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);;
	
КонецФункции

