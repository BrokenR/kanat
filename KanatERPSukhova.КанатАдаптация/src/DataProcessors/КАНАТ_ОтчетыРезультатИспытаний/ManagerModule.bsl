		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.УдлинениеПриРазрыве);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.КоэффициентВариацииCt);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.КоэффициентВариацииCd);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.КоэффициентВариацииCp);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.КоэффициентВариацииCk);
		Результат.Добавить(Перечисления.КАНАТКач_ПараметрыОтчетов.ПодъемнаяПотопляющаяСила);
		
	ИначеЕсли НазваниеОтчета = "ОтчетПоИспытаниямГотовойПродукцииЦех" Тогда
		
