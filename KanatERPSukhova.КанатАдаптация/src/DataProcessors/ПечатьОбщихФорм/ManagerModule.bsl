		ОбластьПодвалаНакладной.Параметры.Заполнить(СтруктураПараметров);
	КонецЕсли;
	//--Бит_Зачетнова_19.05.2025_Обращение 1660201581 от 15.05.2025 14:38:44     
	
	//++Бит_Зачетнова_20.05.2025_Обращение 1660201581 от 15.05.2025 14:38:44   
	Если ТипЗнч(ДанныеПечати.Ссылка) = ТИП("ДокументСсылка.РеализацияТоваровУслуг") тогда
