Функция СчетНаОплатуСвязаннаяРеализация(ДокументОснование)    
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетНаОплатуКлиенту.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СчетНаОплатуКлиенту КАК СчетНаОплатуКлиенту
		|ГДЕ
		|	СчетНаОплатуКлиенту.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() <> 0 тогда
		Для каждого СтрокаТЧ из РезультатЗапроса цикл    
			СчетНаОснованииРеализации = СтрокаТч.Ссылка;
		КонецЦикла; 
		Возврат СчетНаОснованииРеализации; 
	Иначе Возврат Неопределено; 
	КонецЕсли;
	
КонецФункции      

