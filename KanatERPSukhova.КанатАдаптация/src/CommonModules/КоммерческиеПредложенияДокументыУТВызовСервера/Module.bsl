		|ГДЕ
		|	СоглашенияСКлиентамиЭтапыГрафикаОплаты.Ссылка = &Соглашение";

		Результат = Запрос.ВыполнитьПакет();

		ВыборкаШапка       = Результат[0].Выбрать();
		ТаблицаЭтапыОплаты = Результат[1].Выгрузить();

	КонецЕсли;

	Если ВыборкаШапка.Следующий() Тогда

