<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЭтапПроизводства</dataPath>
			<field>ЭтапПроизводства</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Этап производства</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Спецификация</dataPath>
			<field>Спецификация</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Изделие</dataPath>
			<field>Изделие</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Изделие</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МатериалКоличествоПлан</dataPath>
			<field>МатериалКоличествоПлан</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Материал количество план</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СписатьНаРасходы</dataPath>
			<field>СписатьНаРасходы</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Подразделение</dataPath>
			<field>Подразделение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Назначение</dataPath>
			<field>Назначение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Распоряжение</dataPath>
			<field>Распоряжение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МатериалКоличествоФакт</dataPath>
			<field>МатериалКоличествоФакт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Материал количество факт</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СпецификацияМатериал</dataPath>
			<field>СпецификацияМатериал</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Спецификация материал</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВыпускающийЭтап</dataPath>
			<field>ВыпускающийЭтап</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатьяРасходов</dataPath>
			<field>СтатьяРасходов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АналитикаРасходов</dataPath>
			<field>АналитикаРасходов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АналитикаАктивовПассивов</dataPath>
			<field>АналитикаАктивовПассивов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Этап</dataPath>
			<field>Этап</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИзделиеКоличествоПоСпецификации</dataPath>
			<field>ИзделиеКоличествоПоСпецификации</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Изделие количество по спецификации</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИзделиеЕдиницаИзмерения</dataPath>
			<field>ИзделиеЕдиницаИзмерения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Изделие единица измерения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СпецификацияМатериалКоличество</dataPath>
			<field>СпецификацияМатериалКоличество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Спецификация материал количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СпецификацияМатериалЕдиницаИзмерения</dataPath>
			<field>СпецификацияМатериалЕдиницаИзмерения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Спецификация материал единица измерения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИзделиеКоличествоПлан</dataPath>
			<field>ИзделиеКоличествоПлан</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Изделие количество план</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИзделиеКоличествоФакт</dataPath>
			<field>ИзделиеКоличествоФакт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Изделие количество факт</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Статус</dataPath>
			<field>Статус</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОбеспечениеПроизводственныхПроцессовОбороты.Регистратор КАК ЭтапПроизводства,
	ОбеспечениеПроизводственныхПроцессовОбороты.Спецификация КАК Спецификация,
	ОбеспечениеПроизводственныхПроцессовОбороты.Регистратор.ПартияПроизводства.ОсновноеИзделиеНоменклатура КАК Изделие,
	ОбеспечениеПроизводственныхПроцессовОбороты.Регистратор.ПартияПроизводства.ОсновноеИзделиеНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_ЭтапыПроизводства
ИЗ
	РегистрНакопления.ОбеспечениеПроизводственныхПроцессов.Обороты(, , Регистратор, ) КАК ОбеспечениеПроизводственныхПроцессовОбороты
ГДЕ
	ОбеспечениеПроизводственныхПроцессовОбороты.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	И ОбеспечениеПроизводственныхПроцессовОбороты.Регистратор.ДатаПроизводства МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ЭтапыПроизводства.ЭтапПроизводства КАК ЭтапПроизводства,
	ВТ_ЭтапыПроизводства.Спецификация КАК Спецификация,
	ВТ_ЭтапыПроизводства.Изделие КАК Изделие,
	РесурсныеСпецификацииВыходныеИзделия.КоличествоУпаковок КАК КоличествоПоСпецификации,
	ВТ_ЭтапыПроизводства.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура КАК СпецификацияМатериал,
	РесурсныеСпецификацииМатериалыИУслуги.КоличествоУпаковок КАК СпецификацияМатериалКоличество,
	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура.ЕдиницаИзмерения КАК СпецификацияМатериалЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_ЭтапыПроизводстваПоСпецификации
ИЗ
	ВТ_ЭтапыПроизводства КАК ВТ_ЭтапыПроизводства
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
		ПО ВТ_ЭтапыПроизводства.Спецификация = РесурсныеСпецификацииВыходныеИзделия.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК РесурсныеСпецификацииМатериалыИУслуги
		ПО ВТ_ЭтапыПроизводства.Спецификация = РесурсныеСпецификацииМатериалыИУслуги.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ЭтапыПроизводства.ЭтапПроизводства КАК ЭтапПроизводства,
	ВТ_ЭтапыПроизводства.Изделие КАК Изделие,
	СУММА(ЭтапПроизводства2_2ВыходныеИзделия.КоличествоУпаковок) КАК Количество,
	ВТ_ЭтапыПроизводства.ЕдиницаИзмерения КАК ЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_ИзделияФакт
ИЗ
	ВТ_ЭтапыПроизводства КАК ВТ_ЭтапыПроизводства
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапПроизводства2_2ВыходныеИзделия
		ПО ВТ_ЭтапыПроизводства.ЭтапПроизводства = ЭтапПроизводства2_2ВыходныеИзделия.Ссылка
			И ВТ_ЭтапыПроизводства.Изделие = ЭтапПроизводства2_2ВыходныеИзделия.Номенклатура
			И (ЭтапПроизводства2_2ВыходныеИзделия.Произведено)

СГРУППИРОВАТЬ ПО
	ВТ_ЭтапыПроизводства.ЭтапПроизводства,
	ВТ_ЭтапыПроизводства.Изделие,
	ВТ_ЭтапыПроизводства.ЕдиницаИзмерения
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ИзделияФакт.ЭтапПроизводства КАК ЭтапПроизводства,
	ВТ_ИзделияФакт.Изделие КАК Изделие,
	ВТ_ИзделияФакт.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ЭтапПроизводства2_2РасходМатериаловИРабот.Номенклатура КАК Материал,
	СУММА(ЭтапПроизводства2_2РасходМатериаловИРабот.КоличествоУпаковок) КАК Количество,
	ЭтапПроизводства2_2РасходМатериаловИРабот.Номенклатура.ЕдиницаИзмерения КАК МатериалЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_МатериалыФакт
ИЗ
	ВТ_ИзделияФакт КАК ВТ_ИзделияФакт
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.РасходМатериаловИРабот КАК ЭтапПроизводства2_2РасходМатериаловИРабот
		ПО ВТ_ИзделияФакт.ЭтапПроизводства = ЭтапПроизводства2_2РасходМатериаловИРабот.Ссылка

СГРУППИРОВАТЬ ПО
	ВТ_ИзделияФакт.ЭтапПроизводства,
	ВТ_ИзделияФакт.Изделие,
	ВТ_ИзделияФакт.ЕдиницаИзмерения,
	ЭтапПроизводства2_2РасходМатериаловИРабот.Номенклатура,
	ЭтапПроизводства2_2РасходМатериаловИРабот.Номенклатура.ЕдиницаИзмерения
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ЭтапыПроизводства.ЭтапПроизводства КАК ЭтапПроизводства,
	ВТ_ЭтапыПроизводства.Изделие КАК Изделие,
	ВТ_ЭтапыПроизводства.ЭтапПроизводства.КоличествоУпаковокПлан КАК Количество,
	ВТ_ЭтапыПроизводства.ЕдиницаИзмерения КАК ЕдиницаИзмерения
ПОМЕСТИТЬ ВТ_ИзделияПлан
ИЗ
	ВТ_ЭтапыПроизводства КАК ВТ_ЭтапыПроизводства
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ЭтапыПроизводства.ЭтапПроизводства КАК ЭтапПроизводства,
	ВТ_ЭтапыПроизводства.Спецификация КАК Спецификация,
	ВТ_ЭтапыПроизводства.Изделие КАК Изделие,
	ЕСТЬNULL(ВТ_ЭтапыПроизводстваПоСпецификации.КоличествоПоСпецификации, 0) КАК ИзделиеКоличествоПоСпецификации,
	ЕСТЬNULL(ВТ_ЭтапыПроизводстваПоСпецификации.ЕдиницаИзмерения, "") КАК ИзделиеЕдиницаИзмерения,
	ЕСТЬNULL(ВТ_ЭтапыПроизводстваПоСпецификации.СпецификацияМатериал, "") КАК СпецификацияМатериал,
	ЕСТЬNULL(ВТ_ЭтапыПроизводстваПоСпецификации.СпецификацияМатериалКоличество, 0) КАК СпецификацияМатериалКоличество,
	ЕСТЬNULL(ВТ_ЭтапыПроизводстваПоСпецификации.СпецификацияМатериалЕдиницаИзмерения, "") КАК СпецификацияМатериалЕдиницаИзмерения,
	ЕСТЬNULL(ВТ_ИзделияПлан.Количество, 0) КАК ИзделиеКоличествоПлан,
	ЕСТЬNULL(ВТ_ЭтапыПроизводстваПоСпецификации.СпецификацияМатериалКоличество, 0) * (ЕСТЬNULL(ВТ_ИзделияПлан.Количество, 0) / ЕСТЬNULL(ВТ_ЭтапыПроизводстваПоСпецификации.КоличествоПоСпецификации, 1)) КАК МатериалКоличествоПлан,
	ЕСТЬNULL(ВТ_ИзделияФакт.Количество, 0) КАК ИзделиеКоличествоФакт,
	ЕСТЬNULL(ВТ_МатериалыФакт.Количество, 0) КАК МатериалКоличествоФакт,
	ВЫРАЗИТЬ(ВТ_ЭтапыПроизводства.ЭтапПроизводства.Статус КАК Перечисление.СтатусыЭтаповПроизводства2_2) КАК Статус
ИЗ
	ВТ_ЭтапыПроизводства КАК ВТ_ЭтапыПроизводства
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЭтапыПроизводстваПоСпецификации КАК ВТ_ЭтапыПроизводстваПоСпецификации
		ПО (ВТ_ЭтапыПроизводства.ЭтапПроизводства = ВТ_ЭтапыПроизводстваПоСпецификации.ЭтапПроизводства)
			И (ВТ_ЭтапыПроизводства.Спецификация = ВТ_ЭтапыПроизводстваПоСпецификации.Спецификация)
			И (ВТ_ЭтапыПроизводства.Изделие = ВТ_ЭтапыПроизводстваПоСпецификации.Изделие)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИзделияПлан КАК ВТ_ИзделияПлан
		ПО (ВТ_ЭтапыПроизводства.ЭтапПроизводства = ВТ_ИзделияПлан.ЭтапПроизводства)
			И (ВТ_ЭтапыПроизводства.Изделие = ВТ_ИзделияПлан.Изделие)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИзделияФакт КАК ВТ_ИзделияФакт
		ПО (ВТ_ЭтапыПроизводства.ЭтапПроизводства = ВТ_ИзделияФакт.ЭтапПроизводства)
			И (ВТ_ЭтапыПроизводства.Изделие = ВТ_ИзделияФакт.Изделие)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МатериалыФакт КАК ВТ_МатериалыФакт
		ПО (ВТ_ЭтапыПроизводстваПоСпецификации.ЭтапПроизводства = ВТ_МатериалыФакт.ЭтапПроизводства
				И ВТ_ЭтапыПроизводстваПоСпецификации.Изделие = ВТ_МатериалыФакт.Изделие
				И ВТ_ЭтапыПроизводстваПоСпецификации.СпецификацияМатериал = ВТ_МатериалыФакт.Материал)

УПОРЯДОЧИТЬ ПО
	ЭтапПроизводства
</query>
	</dataSet>
	<calculatedField>
		<dataPath>ОтклоненияПоМатериалам</dataPath>
		<expression>МатериалКоличествоПлан - МатериалКоличествоФакт</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отклонения по материалам</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>МатериалКоличествоФакт</dataPath>
		<expression>Сумма(МатериалКоличествоФакт)</expression>
	</totalField>
	<totalField>
		<dataPath>ИзделиеКоличествоФакт</dataPath>
		<expression>Сумма(ВычислитьВыражениеСГруппировкойМассив("МАКСИМУМ(ИзделиеКоличествоФакт)", "ЭтапПроизводства, Изделие"))</expression>
	</totalField>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
