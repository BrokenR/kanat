&НаКлиенте
Асинх Процедура ПередЗакрытиемАсинх()

 оповещение = ВопросАсинх("Данные были изменены. Сохранить изменения?", РежимДиалогаВопрос.ДаНетОтмена,60 ,КодВозвратаДиалога.Отмена);
 Результат = Ждать оповещение;
    Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.КАНАТ_ОБъектБылИзменен = ложь;
        Записать();
	    ЭтаФорма.Закрыть();	
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
	Объект.КАНАТ_ОБъектБылИзменен = ложь;	
	ЭтаФорма.Закрыть();	
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена Тогда	
	КонецЕсли;
	
КонецПроцедуры

