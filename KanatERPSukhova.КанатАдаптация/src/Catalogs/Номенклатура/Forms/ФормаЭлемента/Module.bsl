&НаКлиенте
Процедура КонецПроверкиДублейАртикулов(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда//Записать дубль артикула
		Объект.КАНАТ_ТекстДублиАртикулов	= "";
		ЭтотОбъект.Записать();
	Иначе//Записать очистив артикул
		Объект.КАНАТ_ТекстДублиАртикулов	= "";
		Объект.Артикул						= "";
		Объект.КАНАТ_НеГенерироватьАртикул	= Истина;
		ЭтотОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры // <-БИТ> Руденков_Е.И. 26.02.2024

