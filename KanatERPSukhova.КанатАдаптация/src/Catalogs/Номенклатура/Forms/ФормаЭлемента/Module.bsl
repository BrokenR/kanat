
&НаСервере
Процедура КАНАТ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	//++ Гурьев 27.09.23 ЧТЗ_К1_v3.2
	//++ Бит Трейгер П.М, 22.11.2024 Замечание. Вывод соощения при копировании НТД Номенклатуры
	//добавляемыеРеквизиты = Новый Массив;
	//НовыйРеквизит = Новый РеквизитФормы("КАНАТ_ОБъектБылИзменен",Новый ОписаниеТипов("Булево")); 
	//ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);	
	//ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	Объект.КАНАТ_ОБъектБылИзменен = ложь;
	Сообщить("йцу");
	//-- Бит Трейгер П.М, 22.11.2024 Замечание. Вывод соощения при копировании НТД Номенклатуры
	//Группа НТД
	ГруппаНТД = Элементы.Добавить(
		"КАНАТ_ГруппаНТД",
		Тип("ГруппаФормы"),
		Элементы.ГруппаРеквизиты);
	ГруппаНТД.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаНТД.Заголовок = "НТД";
	ГруппаНТД.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	ГруппаНТД.ОтображатьОтступСлева = Истина;
	ГруппаНТД.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	ГруппаНТД.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаНТД.Скрыть();
	
	
	//Вид для контроля качества
	НТДНоменклатуры = Элементы.Добавить("КАНАТКач_ВидДляКонтроляКачества", Тип("ПолеФормы"), Элементы.КАНАТ_ГруппаНТД); 
	НТДНоменклатуры.Заголовок = "Вид для контроля качества"; 
	НТДНоменклатуры.ПутьКДанным = "Объект.КАНАТКач_ВидДляКонтроляКачества";
	НТДНоменклатуры.Вид = ВидПоляФормы.ПолеВвода;

	
	//НТД номенклатуры
	НТДНоменклатуры = Элементы.Добавить("КАНАТ_НТДНоменклатуры", Тип("ПолеФормы"), Элементы.КАНАТ_ГруппаНТД); 
	НТДНоменклатуры.Заголовок = "НТД Номенклатуры"; 
	НТДНоменклатуры.ПутьКДанным = "Объект.КАНАТ_НТДНоменклатуры";
	НТДНоменклатуры.Вид = ВидПоляФормы.ПолеВвода;
	
	//Таблица НТД
	ТаблицаНТД = Элементы.Добавить("КАНАТ_ТаблицаНТД", Тип("ТаблицаФормы"), ГруппаНТД);
	ТаблицаНТД.ПутьКДанным = "Объект.КАНАТ_ПоказателиНТД"; 
	
	НоваяКолонка = Элементы.Добавить("КАНАТ_ТаблицаНТДПоказатель", Тип("ПолеФормы"), ТаблицаНТД);
	НоваяКолонка.Заголовок = "Показатель"; 
	НоваяКолонка.ПутьКДанным = "Объект.КАНАТ_ПоказателиНТД.Показатель";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	
	НоваяКолонка = Элементы.Добавить("КАНАТ_ТаблицаНТДРазмерность", Тип("ПолеФормы"), ТаблицаНТД);
	НоваяКолонка.Заголовок = "Размерность"; 
	НоваяКолонка.ПутьКДанным = "Объект.КАНАТ_ПоказателиНТД.Размерность";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	
	НоваяКолонка = Элементы.Добавить("КАНАТ_ТаблицаНТДЗначение", Тип("ПолеФормы"), ТаблицаНТД);
	НоваяКолонка.Заголовок = "Значение"; 
	НоваяКолонка.ПутьКДанным = "Объект.КАНАТ_ПоказателиНТД.Значение";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	
	НоваяКолонка = Элементы.Добавить("КАНАТ_ТаблицаНТДОтклонение", Тип("ПолеФормы"), ТаблицаНТД);
	НоваяКолонка.Заголовок = "Отклонение"; 
	НоваяКолонка.ПутьКДанным = "Объект.КАНАТ_ПоказателиНТД.Отклонение";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	
	//Кнопка для заполнения показателей НТД из другой номенклатуры
	КомандаСкопироватьНТД = ЭтаФорма.Команды.Добавить("КомандаЗаполнитьПоказателиНТД");
	КомандаСкопироватьНТД.Действие = "КАНАТ_ВыбратьНоменклатуруПоказателиНТД";
	КомандаСкопироватьНТД.Заголовок = "Заполнить";
	КомандаСкопироватьНТД.Подсказка = "Заполнить показатели НТД копированием из другой номенклатуры";
	
	КнопкаСкопироватьНТД = Элементы.Добавить("КнопкаЗаполнитьПоказателиНТД", Тип("КнопкаФормы"), ГруппаНТД);
	КнопкаСкопироватьНТД.ИмяКоманды = "КомандаЗаполнитьПоказателиНТД";
	//-- Гурьев 27.09.23 ЧТЗ_К1_v3.2
	
	//++БИТ_Гурьев_Задача_54_05.02.24
	КомандаЗаписатьИЗакрыть = ЭтаФорма.Команды.Добавить("КАНАТ_ЗаписатьИЗакрыть");
	КомандаЗаписатьИЗакрыть.Действие = "КАНАТ_ЗаписатьИЗакрыть";
	КомандаЗаписатьИЗакрыть.Заголовок = "Записать и закрыть";
	
	КомандаЗаписать = ЭтаФорма.Команды.Добавить("КАНАТ_Записать");
	КомандаЗаписать.Действие = "КАНАТ_Записать";
	КомандаЗаписать.Заголовок = "Записать";
	
	Элементы.ФормаЗаписатьИЗакрыть.ИмяКоманды = "КАНАТ_ЗаписатьИЗакрыть";
	Элементы.ФормаЗаписать.ИмяКоманды         = "КАНАТ_Записать";
	//--БИТ_Гурьев_Задача_54_05.02.24
КонецПроцедуры

