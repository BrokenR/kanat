&НаСервере
Функция КАНАТ_СовпадениеАртикула()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул = &Артикул
		|	И Номенклатура.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Артикул", Объект.Артикул);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой() И ЗначениеЗаполнено(Объект.Артикул);
	
КонецФункции
//--БИТ_Гурьев_Задача_54_05.02.24

//++БИТ_Гурьев_Задача_54_05.02.24
&НаКлиенте
Процедура КАНАТ_ЗаписатьИЗакрыть(Команда)
	Если ЗначениеЗаполнено(Объект.Ссылка) И КАНАТ_СовпадениеАртикула() Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Закрыть", Истина);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("КАНАТ_ЗаписатьПослеОтвета",ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения, 
					   "В системе уже существует такой артикул. Все равно записать?", 
						РежимДиалогаВопрос.ДаНет,
						,
						КодВозвратаДиалога.Да);
	Иначе
		
		ОбщегоНазначенияУТКлиент.ЗаписатьИЗакрыть(ЭтотОбъект);
		
	КонецЕсли;
КонецПроцедуры
