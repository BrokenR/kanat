&НаСервере
Процедура ПолучитьИзХранилища()    
	
	Если ЗначениеЗаполнено(Объект.ссылка) Тогда
		Объектдокумент = Объект.Ссылка.ПолучитьОбъект();
		ЭтотОбъект.КАНАТ_РезультатТабДок  = ОбъектДокумент.КАНАТ_ХранилищеИтоговыйТекст.Получить();
	КонецЕсли; 
	ЭтотОбъект.КАНАТ_РезультатТабДок.Макет = Истина;
	
