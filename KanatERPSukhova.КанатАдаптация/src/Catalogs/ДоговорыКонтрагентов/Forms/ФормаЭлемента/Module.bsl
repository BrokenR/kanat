//БИТ_Байков ++ 17.08.23·#2_4 - конструктор договоров
&наСервере
Процедура  ОбновитьШаблонИзБлоковНаСервере ();
	табличныйДокумент = Новый ТабличныйДокумент;
	НомерПоПорядку = -1;
	Для каждого Блок Из Объект.КАНАТ_БлокиДоговора Цикл
		Если Блок.БлокДоговора = Справочники.КАНАТ_БлокиДоговоров.ПустаяСсылка() Тогда
			Объект.КАНАТ_БлокиДоговора.Удалить(Блок);
			Продолжить;			
		КонецЕсли;
		НомерПоПорядку = НомерПоПорядку+1;
		БлокОбъект = Блок.БлокДоговора.ПолучитьОбъект();
		Если БлокОбъект.ЗаполнениеПодразделениями тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Контрагент,
			|	МАКСИМУМ(ЕСТЬNULL(БанковскиеСчетаКонтрагентов.Ссылка, ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаКонтрагентов.ПустаяСсылка))) КАК БСчет
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
			|		ПО (Контрагенты.Ссылка = БанковскиеСчетаКонтрагентов.Владелец)
			|ГДЕ
			|	Контрагенты.ГоловнойКонтрагент = &ГоловнойКонтрагент  и Контрагенты.Ссылка <> &ГоловнойКонтрагент 
			|
			|СГРУППИРОВАТЬ ПО
			|	Контрагенты.Ссылка"; 
			Запрос.УстановитьПараметр("ГоловнойКонтрагент",Объект.Контрагент);
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ТабДокумент = ЗаполнениеТабДока (БлокОбъект, НомерПоПорядку, ВыборкаДетальныеЗаписи.Контрагент,ВыборкаДетальныеЗаписи.БСчет );	
				ТабличныйДокумент.Вывести(ТабДокумент);
			КонецЦикла;
                          
		Иначе 
			ТабДокумент = ЗаполнениеТабДока (БлокОбъект, НомерПоПорядку, Объект.Контрагент, Объект.БанковскийСчетКонтрагента);	
			ТабличныйДокумент.Вывести(ТабДокумент);
		КонецЕсли;
	КонецЦикла;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ЭтотОбъект.КАНАТ_РезультатТабДок = ТабличныйДокумент;
конецПроцедуры

//БИТ_Байков ++ 17.08.23·#2_4 - конструктор договоров
&наСервере
Функция  ЗаполнениеТабДока (БлокОбъект, НомерПоПорядку, ЗаполняемыйКонтрагент, БакнСчетКонтрагента);
	 ТабДокументПервичный = БлокОбъект.ХранилищеТабДокумента.Получить();  
		ТабДокумент = ТабДокументПервичный.ПолучитьОбласть(1, 1, ТабДокументПервичный.ВысотаТаблицы, ТабДокументПервичный.ШиринаТаблицы);
		СтруктураПолей = Новый Структура;
		ОбъектОбъект = РеквизитФормыВЗначение("Объект");
		СтруктураПолей.Вставить("НомПП",НомерПоПорядку);
		Для каждого МетаРек Из ОбъектОбъект.Метаданные().Реквизиты Цикл
			
			ЗначениеПараметра = ОбъектОбъект[МетаРек.Имя];
			Если ТипЗнч(ЗначениеПараметра)=Тип("Дата") Тогда
				ЗначениеПараметра= Формат(ЗначениеПараметра,	"ДЛФ=DD");
			КонецЕсли;
			СтруктураПолей.Вставить("Договор"+МетаРек.Имя, ЗначениеПараметра);					
		КонецЦикла;  
		
		Для каждого МетаРек Из ЗаполняемыйКонтрагент.Метаданные().Реквизиты Цикл
			ЗначениеПараметра = ЗаполняемыйКонтрагент[МетаРек.Имя];
			Если ТипЗнч(ЗначениеПараметра)=Тип("Дата") Тогда
				ЗначениеПараметра= Формат(ЗначениеПараметра,	"ДЛФ=DD");
			КонецЕсли;
			СтруктураПолей.Вставить("Контрагент"+МетаРек.Имя, ЗначениеПараметра);					
		КонецЦикла;
		ДобавитьДополнительнуюИнформациюВСтруктуруПолей(СтруктураПолей, ЗаполняемыйКонтрагент);
		ДобавитьКонтактнуюИнформациюВСтруктуруПолей(СтруктураПолей, ЗаполняемыйКонтрагент);
		
		Для каждого МетаРек Из ОбъектОбъект.КонтактноеЛицо.Метаданные().Реквизиты Цикл
			ЗначениеПараметра = ОбъектОбъект.КонтактноеЛицо[МетаРек.Имя];
			Если ТипЗнч(ЗначениеПараметра)=Тип("Дата") Тогда
				ЗначениеПараметра= Формат(ЗначениеПараметра,	"ДЛФ=DD");
			КонецЕсли;
			СтруктураПолей.Вставить("ДоговорКонтактноеЛицо"+МетаРек.Имя, ЗначениеПараметра);					
		КонецЦикла;
		ДобавитьИнформациюКЛВСтруктуруПолей(СтруктураПолей);
		
		Для каждого МетаРек Из ОбъектОбъект.КАНАТ_ПоСоглашению.Метаданные().Реквизиты Цикл
			ЗначениеПараметра = ОбъектОбъект.КАНАТ_ПоСоглашению[МетаРек.Имя];
			Если ТипЗнч(ЗначениеПараметра)=Тип("Дата") Тогда
				ЗначениеПараметра= Формат(ЗначениеПараметра,	"ДЛФ=DD");
			КонецЕсли;
			СтруктураПолей.Вставить("Соглашение"+МетаРек.Имя, ЗначениеПараметра);					
		КонецЦикла;
		
		Для каждого МетаРек Из ОбъектОбъект.БанковскийСчет.Метаданные().Реквизиты Цикл
			ЗначениеПараметра = ОбъектОбъект.БанковскийСчет[МетаРек.Имя];
			Если ТипЗнч(ЗначениеПараметра)=Тип("Дата") Тогда
				ЗначениеПараметра= Формат(ЗначениеПараметра,	"ДЛФ=DD");
			КонецЕсли;
			СтруктураПолей.Вставить("БСчет"+МетаРек.Имя, ЗначениеПараметра);					
		КонецЦикла;                    
		
		Для каждого МетаРек Из БакнСчетКонтрагента.Метаданные().Реквизиты Цикл
			ЗначениеПараметра = БакнСчетКонтрагента[МетаРек.Имя];
			Если ТипЗнч(ЗначениеПараметра)=Тип("Дата") Тогда
				ЗначениеПараметра= Формат(ЗначениеПараметра,	"ДЛФ=DD");
			КонецЕсли;
			СтруктураПолей.Вставить("КонтрагентБСчет"+МетаРек.Имя, ЗначениеПараметра);					
		КонецЦикла;
		
		//БИТ_Гурьев__18.12.24++
		Для каждого МетаРек Из ОбъектОбъект.Организация.Метаданные().Реквизиты Цикл
			ЗначениеПараметра = ОбъектОбъект.Организация[МетаРек.Имя];
			Если ТипЗнч(ЗначениеПараметра)=Тип("Дата") Тогда
				ЗначениеПараметра= Формат(ЗначениеПараметра,	"ДЛФ=DD");
			КонецЕсли;
			СтруктураПолей.Вставить("Организация"+МетаРек.Имя, ЗначениеПараметра);					
		КонецЦикла;

		//БИТ_Гурьев__18.12.24--
		
		ТабДокумент.Параметры.Заполнить(СтруктураПолей);
		ТабДокумент.Область(1, 1, ТабДокумент.ВысотаТаблицы, ТабДокумент.ШиринаТаблицы).СоздатьФорматСтрок();
		
		
		Если БлокОбъект.ИспользоватьСвойОбработчик Тогда  
			Попытка
				ПараметрыЗаполнения = ТабДокумент.Параметры;
				Выполнить(БлокОбъект.ОбработчикЗаполнения);	
				
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;            
		
		Возврат ТабДокумент;

КонецФункции


//БИТ_Байков ++ 20.08.23·#2_4 - конструктор договоров
&НаСервере
Процедура ДобавитьИнформациюКЛВСтруктуруПолей(СтруктураПолей) 
	СтруктураПолей.Вставить("ДоговорКонтактноеЛицоРодительный", СклонениеПредставленийОбъектов.ПросклонятьФИО(Строка(Объект.КонтактноеЛицо), 2));
	СтруктураПолей.Вставить("ДоговорКонтактноеЛицоИнициалы", ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Строка(Объект.КонтактноеЛицо)));
	СтруктураПолей.Вставить("ДоговорКонтактноеЛицоДолжностьРодительный", СклонениеПредставленийОбъектов.ПросклонятьПредставление(Строка(Объект.КонтактноеЛицо.ДолжностьПоВизитке), 2));

КонецПроцедуры

//БИТ_Байков ++ 06.05.24·#2_4 - конструктор договоров
&НаСервере
Процедура ДобавитьДополнительнуюИнформациюВСтруктуруПолей(СтруктураПолей, КонтрагентСсылка) 
	НаименованиеПолноеСРасшифровкой = КонтрагентСсылка.НаименованиеПолное; 
	ДлинаСтроки = СтрДлина(НаименованиеПолноеСРасшифровкой);                                   
	Если СтрНачинаетсяС(НаименованиеПолноеСРасшифровкой,"ООО") тогда                           
		НаименованиеПолноеСРасшифровкой = Прав(НаименованиеПолноеСРасшифровкой, ДлинаСтроки-3);
		НаименованиеПолноеСРасшифровкой = "Общество с ограниченной ответственностью" +НаименованиеПолноеСРасшифровкой;
	ИначеЕсли СтрНачинаетсяС(НаименованиеПолноеСРасшифровкой,"ИП") тогда
		НаименованиеПолноеСРасшифровкой = Прав(НаименованиеПолноеСРасшифровкой, ДлинаСтроки-2);
		НаименованиеПолноеСРасшифровкой = "Индивидуальный предприниматель" +НаименованиеПолноеСРасшифровкой;
	ИначеЕсли СтрНачинаетсяС(НаименованиеПолноеСРасшифровкой,"АО") тогда
		НаименованиеПолноеСРасшифровкой = Прав(НаименованиеПолноеСРасшифровкой, ДлинаСтроки-2);                       
		НаименованиеПолноеСРасшифровкой = "Акционерное общество" +НаименованиеПолноеСРасшифровкой;
	КонецЕсли;
	
	
	
	СтруктураПолей.Вставить("НаименованиеПолноеСРасшифровкой", НаименованиеПолноеСРасшифровкой);
	
	//БИТ_Гурьев_мелкие замечания_22.05.24++
	ВариантыСклоненияНаименванияРодПадеж = ПолучитьСклоненияСтроки(НаименованиеПолноеСРасшифровкой,
																					   ,
																					   "ПД=Родительный");
	НаименованиеПолноеСРасшифровкойРодПадеж = ?(ВариантыСклоненияНаименванияРодПадеж.Количество() > 0,
												ВариантыСклоненияНаименванияРодПадеж[0],
												"");
	СтруктураПолей.Вставить("НаименованиеПолноеСРасшифровкойРодительныйПадеж", НаименованиеПолноеСРасшифровкойРодПадеж);
	//БИТ_Гурьев_мелкие замечания_22.05.24--
	
КонецПроцедуры
	

