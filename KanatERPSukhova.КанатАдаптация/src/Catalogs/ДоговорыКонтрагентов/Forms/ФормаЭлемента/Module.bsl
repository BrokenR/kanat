&НаКлиенте
Процедура КАНАТ_ЗаполнитьНомер(Команда)
	
	Если Объект.Контрагент.Пустая() Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Поле контрагент не заполнено.";
		Сообщение.Поле = "Объект.Контрагент";
		Сообщение.Сообщить();
		
	Иначе
		
		КАНАТ_ЗаполнитьНомерСервер();
		КАНАТ_ОбновитьНаименованияИзНомера();
		
	КонецЕсли;
	
КонецПроцедуры
