Процедура БИТ_ДополнитьРеквизитамиЭлементамиКонструктораДоговоров()
	
	//БИТ_Байков ++ 18.08.23·#2_5 (Связь договор соглашение)
	ЭлементСоглашение = Элементы.Добавить("Канат_ПоСоглашению",Тип("ПолеФормы"), Элементы.ГруппаПартнерКонтрагент);
	ЭлементСоглашение.ПутьКДанным = "Объект.КАНАТ_ПоСоглашению";  
	ЭлементСоглашение.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСоглашение.УстановитьДействие("НачалоВыбора","КАНАТ_ПоСоглашениюНачалоВыбора");
	//БИТ_Байков -
	
	
	//БИТ_Байков ++ 18.08.23·#2_4 - конструктор договоров
	//Добавление страницы и групп расположения
	ЭлСтраница = Элементы.Добавить("ЭлСтраница_Шаблон",Тип("ГруппаФормы"),Элементы.ГруппаСтраницы);    
	ЭлСтраница.Вид = ВидГруппыФормы.Страница;
	ЭлСтраница.Заголовок = "Текст договора";     
	
	ЭлГруппаГВ = Элементы.Добавить("ГруппаШаблонГоризонтальнаяВерх",Тип("ГруппаФормы"),ЭлСтраница);
	ЭлГруппаГВ.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЭлГруппаГВ.Отображение = ОтображениеОбычнойГруппы.Нет;
	ЭлГруппаГВ.группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ЭлГруппаГН = Элементы.Добавить("ГруппаШаблонГоризонтальнаяНиз",Тип("ГруппаФормы"),ЭлСтраница);
	ЭлГруппаГН.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЭлГруппаГН.Отображение = ОтображениеОбычнойГруппы.Нет;
	ЭлГруппаГН.группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;  
	
	//Добавление команд
	КомандаОбновить = Команды.Добавить("ОбновитьШаблонИзБлоков"); //Имя команды
	КомандаОбновить.Заголовок = "Заполнить текст из ""Блоков""";
	КомандаОбновить.Действие  = "ОбновитьШаблонИзБлоков"; //Имя связанной процедуры
	КнопкаОбновить = Элементы.Добавить("КнопкаОбновитьШаблонИзБлоков", Тип("КнопкаФормы"), ЭлГруппаГВ);                    
	КнопкаОбновить.ИмяКоманды = "ОбновитьШаблонИзБлоков"; 
	КнопкаОбновить.Вид = ВидКнопкиФормы.ОбычнаяКнопка;  
	
	КомандаСохранить = Команды.Добавить("ПечатьДоговора");
	КомандаСохранить.Заголовок = "Печать договора";
	КомандаСохранить.Действие  = "ПечатьДоговора";     
	КнопкаСохранить = Элементы.Добавить("КнопкаПечатьДоговора", Тип("КнопкаФормы"), ЭлГруппаГВ);                    
	КнопкаСохранить.ИмяКоманды = "ПечатьДоговора"; 
	КнопкаСохранить.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	
	//Добавление ТабЧасти
	ЭлСписокБлоков = Элементы.Добавить("Список_Блоков",Тип("ТаблицаФормы"), ЭлГруппаГН);
	ЭлСписокБлоков.ПутьКДанным = "Объект.КАНАТ_БлокиДоговора";
	ЭлСписокБлоков.Заголовок = "Пункты договора";        
	ЭлКолонкаТЧ = Элементы.Добавить("БлокДоговора",Тип("ПолеФормы"),ЭлСписокБлоков);
	ЭлКолонкаТЧ.Заголовок = "Блок договора";
	ЭлКолонкаТЧ.Вид = ВидПоляФормы.ПолеВвода;
	ЭлКолонкаТЧ.ПутьКДанным = "Объект.КАНАТ_БлокиДоговора.БлокДоговора"; 
	
	
	
	//Добавление Табдока
	ОписаниеТипаТД = Новый ОписаниеТипов("ТабличныйДокумент");
	РеквизитФинальныйТабДок = Новый РеквизитФормы("КАНАТ_РезультатТабДок",ОписаниеТипаТД,,"Текст договора");
	РеквизитФинальныйТабДок.СохраняемыеДанные = Истина;
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(РеквизитФинальныйТабДок);
	ИзменитьРеквизиты(МассивРеквизитов);
	
	ЭлИтоговыйТабДок = Элементы.Добавить("Итоговый_ТабДок", Тип("ПолеФормы"),ЭлГруппаГН);
	ЭлИтоговыйТабДок.ПутьКДанным = "КАНАТ_РезультатТабДок"; 
	ЭлИтоговыйТабДок.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	ЭлИтоговыйТабДок.Редактирование = Истина;
	ЭлИтоговыйТабДок.ОтображатьСетку = Истина;
	ЭлИтоговыйТабДок.ОтображатьЗаголовки = Истина;
	ЭлИтоговыйТабДок.Доступность = Истина;  
	ЭтотОбъект.КАНАТ_РезультатТабДок.Макет = Истина;
	
	
КонецПроцедуры    

&НаКлиенте
Процедура  ПечатьДоговора (Команда);
	//БИТ_Байков ++ 17.08.23·#2_4 - конструктор договоров
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ДОГОВОР");
	СтрокаКоллекцииПФ = КоллекцияПечатныхФорм[0];
	СтрокаКоллекцииПФ.ТабличныйДокумент = ЭтотОбъект.КАНАТ_РезультатТабДок;
	СтрокаКоллекцииПФ.Экземпляров = 1;
	СтрокаКоллекцииПФ.СинонимМакета = Объект.Наименование;
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм,Неопределено,ЭтаФорма);
	
	
конецПроцедуры


