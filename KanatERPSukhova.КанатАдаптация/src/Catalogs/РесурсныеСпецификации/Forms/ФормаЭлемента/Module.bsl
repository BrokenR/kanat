&НаСервере
Процедура КАНАТ_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//БИТ_Гурьев_ЧТЗ_3.2_11.04.24++
	Если Объект.КАНАТ_ТехнологическаяСпецификация Тогда
	
		Если Не ЗначениеЗаполнено(Объект.Родитель) ИЛИ
			(ЗначениеЗаполнено(Объект.Родитель) И Не Объект.Родитель.КАНАТ_ТехнологическаяСпецификация) Тогда
			
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Технологическая спецификация должна находится в технологической группе.";
			Сообщение.ПутьКДанным = "Объект.Родитель";
			Сообщение.Сообщить();
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если Не Объект.КАНАТ_ТехнологическаяСпецификация Тогда
	
		Если ЗначениеЗаполнено(Объект.Родитель) И Объект.Родитель.КАНАТ_ТехнологическаяСпецификация Тогда
			
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В технологической группе могут находиться только технологические спецификации.";
			Сообщение.ПутьКДанным = "Объект.Родитель";
			Сообщение.Сообщить();
			
		КонецЕсли;
	
	КонецЕсли;
	//БИТ_Гурьев_ЧТЗ_3.2_11.04.24--
КонецПроцедуры

&НаСервере
Процедура КАНАТ_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	//БИТ_Гурьев_ЧТЗ_3.2_12.04.24++
	Если Объект.КАНАТ_ТехнологическаяСпецификация Тогда
		ЭтаФорма.Заголовок = СтрШаблон("(технологическая) %1", Этаформа.Заголовок);
	КонецЕсли;
	Если ПараметрыЗаписи.Свойство("НеобходимоПеречитать") И ПараметрыЗаписи.НеобходимоПеречитать Тогда
		ЭтаФорма.Прочитать();
	КонецЕсли;
	//БИТ_Гурьев_ЧТЗ_3.2_12.04.24--
КонецПроцедуры

&НаСервере
Процедура КАНАТ_ПриЗаписиНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//БИТ_Гурьев_ЧТЗ_3.2_12.04.24++
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		И Не Объект.КАНАТ_ТехнологическаяСпецификация
		И ЗначениеЗаполнено(Объект.КАНАТ_Основание) Тогда
		
		ЭтапОбъект = Справочники.ЭтапыПроизводства.СоздатьЭлемент();
		//++Бит Трейгер П.М. 18.11.2024
		ЭтапОбъект.Заполнить(Неопределено);
		//--Бит Трейгер П.М. 18.11.2024
		ЭтапОбъект.Владелец = ТекущийОбъект.Ссылка;
		ЭтапОбъект.Наименование = "Производство";
		ЭтапОбъект.НомерЭтапа = 1;
		
		ЭтапОбъект.Записать();
		
		ПараметрыЗаписи.Вставить("НеобходимоПеречитать", Истина);
	КонецЕсли;
	//БИТ_Гурьев_ЧТЗ_3.2_12.04.24--
КонецПроцедуры

