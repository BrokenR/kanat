	     КонецЕсли
	    //++Бит Трейгер П.М. 14.11.2024 ++ Доработки.Ошибка создания групп. Письмо от 01.11.24
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения)
		И Не ЭтоГруппа
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
