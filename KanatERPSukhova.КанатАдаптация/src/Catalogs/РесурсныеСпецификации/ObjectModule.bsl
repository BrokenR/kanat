		НоваяСтрока = Трудозатраты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТрудозатраты);
		
	КонецЦикла;
	
	КАНАТ_ТехнологическаяСпецификация = Ложь;
	ИсключитьАвтоматическийВыборВДокументах = Ложь;
	ВариантПодбораВДокументы = ?(ИсключитьАвтоматическийВыборВДокументах,
			ПредопределенноеЗначение("Перечисление.ВариантыПодбораСпецификацииВДокументы.Вручную"),
			ПредопределенноеЗначение("Перечисление.ВариантыПодбораСпецификацииВДокументы.Автоматически"));
	Родитель = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	КАНАТ_Основание = ДанныеЗаполнения;
	Ответственный = Пользователи.ТекущийПользователь();
		
	КонецЕсли;
	//БИТ_Гурьев_ЧТЗ_3.2_08.04.24--
КонецПроцедуры

&После("ПередЗаписью")
Процедура КАНАТ_ПередЗаписью(Отказ)
	//БИТ_Гурьев_ЧТЗ_3.2_11.04.24++
	Если КАНАТ_ТехнологическаяСпецификация Тогда
	
		Если Не ЭтоГруппа И (Не ЗначениеЗаполнено(Родитель) 
			ИЛИ (ЗначениеЗаполнено(Родитель) И Не Родитель.КАНАТ_ТехнологическаяСпецификация)) Тогда
			
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Технологическая спецификация должна находится в технологической группе.";
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	
	КонецЕсли;
	
	Если Не КАНАТ_ТехнологическаяСпецификация Тогда
	
		Если ЗначениеЗаполнено(Родитель) И Родитель.КАНАТ_ТехнологическаяСпецификация Тогда
			
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В технологической группе могут находиться только технологические спецификации.";
			Сообщение.Сообщить();
			
		КонецЕсли;
		//++Бит Трейгер П.М. 13.11.2024
		Если ЭтоНовый() Тогда
		Иначе
		//--Бит Трейгер П.М. 13.11.2024
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РесурсныеСпецификации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РесурсныеСпецификации КАК РесурсныеСпецификации
			|ГДЕ
			|	РесурсныеСпецификации.Родитель = &Родитель
			|	И РесурсныеСпецификации.КАНАТ_ТехнологическаяСпецификация = ИСТИНА";

		Запрос.УстановитьПараметр("Родитель", Ссылка);

		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() И ЭтоГруппа И ЗначениеЗаполнено(Родитель) Тогда
			
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Текущая группа содержит технологические группы или спецификации";
			Сообщение.Сообщить();
			
		КонецЕсли;
       КонецЕсли;
	КонецЕсли;
	//БИТ_Гурьев_ЧТЗ_3.2_11.04.24--
КонецПроцедуры


&Перед("ПриЗаписи")
Процедура КАНАТ_ПриЗаписи(Отказ)
	Если КАНАТ_ТехнологическаяСпецификация <> Ссылка.КАНАТ_ТехнологическаяСпецификация
		И Не Пользователи.РолиДоступны("ДобавлениеИзменениеРесурсныхСпецификаций") Тогда
		
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нет прав на изменение признака технологической спецификации.";
		Сообщение.Сообщить();
		
	КонецЕсли;
КонецПроцедуры
