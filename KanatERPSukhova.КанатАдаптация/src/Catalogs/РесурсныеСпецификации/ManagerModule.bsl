		|УПОРЯДОЧИТЬ ПО
		|	ЭтапыПроизводства.НомерЭтапа,
		|	ТехнологическиеОперации.НомерОперации
		|ИТОГИ
		|ПО
		|	ЭтапПроизводстваСсылка,
		|	ТехнологическаяОперацияСсылка";
	
	Запрос.УстановитьПараметр("Владелец", Документ);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаЭтапы = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Этапы = Новый Соответствие;
	
	Пока ВыборкаЭтапы.Следующий() Цикл
		
		Этап = Новый Соответствие;
		Этап.Вставить("Наименование", ВыборкаЭтапы.Наименование);
		Этап.Вставить("Оборудование", ВыборкаЭтапы.КАНАТ_Оборудование);
		Этап.Вставить("ЗаправочныеПараметры", ВыборкаЭтапы.КАНАТ_ЗаправочныеПараметры);
		Этап.Вставить("Описание", ВыборкаЭтапы.Описание);
		
		ВыборкаДетальныеЗаписи = ВыборкаЭтапы.Выбрать();
		
		Показатели = Новый ТаблицаЗначений;
		Показатели.Колонки.Добавить("Показатель", Новый ОписаниеТипов("СправочникСсылка.КАНАТ_ПоказателиОборудования"));
		Показатели.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НоваяСтрока = Показатели.Добавить();
			НоваяСтрока.Показатель = ВыборкаДетальныеЗаписи.Показатель;
			НоваяСтрока.Значение = ВыборкаДетальныеЗаписи.Значение;
			
		КонецЦикла;
		
		Этап.Вставить("Показатели", Показатели);
		
		Этапы.Вставить(ВыборкаЭтапы.Ссылка, Этап);
		
	КонецЦикла;
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,"Наименование, ОсновноеИзделиеНоменклатура, КАНАТ_Примечание, НачалоДействия");
	
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	//ОбластьШапка.Параметры.НаименованиеСпецификации = ДанныеДокумента.Наименование;
	ОбластьШапка.Параметры.НаименованиеСпецификации =  ДанныеДокумента.ОсновноеИзделиеНоменклатура;
	ТабДок.Вывести(ОбластьШапка);
	
	//Заполнение таблички с этапами и операциями
	ВыборкаЭтапы = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТабДокЭтапы = Новый ТабличныйДокумент;
	МассивРучныеОперации = Новый Массив;
	
	Пока ВыборкаЭтапы.Следующий() Цикл
		
		ОбластьЭтап = Макет.ПолучитьОбласть("ОбластьЭтап");
		ОбластьЭтап.Параметры.Этап = ВыборкаЭтапы.ЭтапПроизводстваСсылка;
		
		ВыборкаОперации = ВыборкаЭтапы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		МассивСтрокиОпераций = Новый Массив;
		
		Счетчик = 1;
		
		Пока ВыборкаОперации.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаОперации.ТехнологическаяОперацияСсылка) Тогда
				
				Если ВыборкаОперации.ПометкаУдаления Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ВыборкаОперации.КАНАТ_Оборудование) Тогда
					
					МассивРучныеОперации.Добавить(ВыборкаОперации.ТехнологическаяОперацияНаименование);
					Продолжить;
					
				КонецЕсли;
				
				Если Счетчик = 1 Тогда
					
					ТабДокОперацииСтрока = Новый ТабличныйДокумент;
					
				КонецЕсли;
				
				ТабДокОперация = Новый ТабличныйДокумент;
				
				ОбластьОперацияШапка = Макет.ПолучитьОбласть("ОбластьОперацияШапка");
				ОбластьОперацияШапка.Параметры.Операция = ВыборкаОперации.ТехнологическаяОперацияСсылка;
				//ОбластьОперацияШапка.Параметры.Этап = ВыборкаОперации.ЭтапПроизводстваСсылка;
				
				ТабДокОперация.Вывести(ОбластьОперацияШапка);
				
				ПоказателиТекст = "";
				
				ВыборкаДетальныеЗаписи = ВыборкаОперации.Выбрать();
				
				//Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				//	
				//	ПоказателиТекст = СтрШаблон("%1%2 %3%4",
				//								ПоказателиТекст,
				//								ВыборкаДетальныеЗаписи.Показатель,
				//								ВыборкаДетальныеЗаписи.Значение,
				//								Символы.ПС);
				//	
				//КонецЦикла;
				
				ОперацияТекст = СтрШаблон("%1%2%3%4%5",
										  ВыборкаОперации.Описание,
										  ?(ЗначениеЗаполнено(ВыборкаОперации.Описание), Символы.ПС, ""),
										  ВыборкаОперации.КАНАТ_Оборудование,
										  Символы.ПС,
										  ВыборкаОперации.КАНАТ_ЗаправочныеПараметры);
				
				ОбластьОперация = Макет.ПолучитьОбласть("ОбластьОперация");
				ОбластьОперация.Параметры.ОперацияТекст = ОперацияТекст;
				
				ТабДокОперация.Вывести(ОбластьОперация);
				ТабДокОперацииСтрока.Присоединить(ТабДокОперация);
				
				Счетчик = Счетчик + 1;
				
				Если Счетчик > 4 Тогда
					
					Счетчик = 1;
					МассивСтрокиОпераций.Добавить(ТабДокОперацииСтрока);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТабДокЭтапы.Вывести(ОбластьЭтап);
		
		Если ЗначениеЗаполнено(Этапы[ВыборкаЭтапы.ЭтапПроизводстваСсылка]["Описание"])
			ИЛИ ЗначениеЗаполнено(Этапы[ВыборкаЭтапы.ЭтапПроизводстваСсылка]["Оборудование"])
			ИЛИ ЗначениеЗаполнено(Этапы[ВыборкаЭтапы.ЭтапПроизводстваСсылка]["ЗаправочныеПараметры"]) Тогда
			
			ОбластьЭтапТекст = Макет.ПолучитьОбласть("ОбластьЭтапТекст");
			ОбластьЭтапТекст.Параметры.ЭтапТекст = СтрШаблон("%1%2%3%4%5",
									  Этапы[ВыборкаЭтапы.ЭтапПроизводстваСсылка]["Описание"],
									  ?(ЗначениеЗаполнено(Этапы[ВыборкаЭтапы.ЭтапПроизводстваСсылка]["Описание"]), Символы.ПС, ""),
									  Этапы[ВыборкаЭтапы.ЭтапПроизводстваСсылка]["Оборудование"],
									  Символы.ПС,
									  Этапы[ВыборкаЭтапы.ЭтапПроизводстваСсылка]["ЗаправочныеПараметры"]);
			ТабДокЭтапы.Вывести(ОбластьЭтапТекст);
			
		КонецЕсли;
		
		Для Каждого Строка Из МассивСтрокиОпераций Цикл
			
			ТабДокЭтапы.Вывести(Строка);
			
		КонецЦикла;
		
		Если Счетчик > 1 Тогда
			
			ТабДокЭтапы.Вывести(ТабДокОперацииСтрока);
			
		КонецЕсли;
	КонецЦикла;
	ТабДок.Вывести(ТабДокЭтапы);
	//Номенклатура
	
