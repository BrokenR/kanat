	//ТабДокНоменклатура.Область(3, 1, ТабДокЭтапы.ВысотаТаблицы, 2).Объединить();
	//ОбластьНоменклатура = ТабДокНоменклатура.Область(3, 1, ТабДокЭтапы.ВысотаТаблицы, 2);
	//
	//
	//Если ЗначениеЗаполнено(ДанныеДокумента.ОсновноеИзделиеНоменклатура) Тогда
	//	ОбластьНоменклатура.Текст = СтрШаблон("%1%2%3",
	//										  ДанныеДокумента.ОсновноеИзделиеНоменклатура,
	//										  Символы.ПС,
	//										  ДанныеДокумента.ОсновноеИзделиеНоменклатура.Артикул);
	//КонецЕсли; 
	//
	//ОбластьНоменклатура.Шрифт = Новый Шрифт("Arial", 12, Ложь);
	//ОбластьНоменклатура.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	//ОбластьНоменклатура.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	//ОбластьНоменклатура.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	//ОбластьНоменклатура.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	//ОбластьНоменклатура.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	//
	//ТабДокНоменклатура.Область(1, ТабДокНоменклатура.ШиринаТаблицы, ТабДокНоменклатура.ВысотаТаблицы, ТабДокНоменклатура.ШиринаТаблицы).ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	//ТабДокНоменклатура.Область(ТабДокНоменклатура.ВысотаТаблицы, 1, ТабДокНоменклатура.ВысотаТаблицы, ТабДокНоменклатура.ШиринаТаблицы).ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	//
	//ТабДок.Вывести(ТабДокНоменклатура);
	
	//Ручные операции
	Для Каждого Строка Из МассивРучныеОперации Цикл
		
		ОбластьРучнаяОперация = Макет.ПолучитьОбласть("ОбластьРучнаяОперация");
		ОбластьРучнаяОперация.Параметры.ОперацияТекст = Строка;
		ТабДок.Вывести(ОбластьРучнаяОперация);
		
	КонецЦикла;
	
	//Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	ОбластьПодвал.Параметры.Примечание = ДанныеДокумента.КАНАТ_Примечание;
	ОбластьПодвал.Параметры.Дата = ДанныеДокумента.НачалоДействия;
	ОбластьПодвал.Параметры.Подписант = РегистрыСведений.КАНАТ_ЛицаПодписывающиеЗаПодразделения.ПолучитьСотрудникаПоДолжности(Перечисления.КАНАТ_РолиПодписантов.ВедИнженерТехнолог, ДанныеДокумента.НачалоДействия);
	
	ТабДок.Вывести(ОбластьПодвал);
	
	Возврат ТабДок;
	
КонецФункции

